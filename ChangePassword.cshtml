@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Change Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0" rel="stylesheet" />
    <style>
        :root {
            --green-primary: #1b6d24;
            --green-header-from: #33cc66;
            --green-header-to: #22b357;
            --gray-bg: #eef1eb;
            --text-dark: #14210f;
            --text-muted: #6b7280;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background: #eaedf3;
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-card {
            background: #fff;
            border-radius: 20px;
            width: 100%;
            max-width: 350px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(20, 33, 15, 0.08);
        }

        /* ---------- Header ---------- */
        .auth-header {
            background: linear-gradient(180deg, var(--green-header-from), var(--green-header-to));
            padding: 34px 0 30px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-logo {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.12);
        }

        .auth-logo img {
            width: 52px;
            height: 52px;
            object-fit: contain;
        }

        /* ---------- Body ---------- */
        .auth-body {
            padding: 26px 26px 28px;
        }

        .auth-notice {
            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            color: #7a5b12;
            background: #fdf1c8;
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 18px;
            text-align: center;
            line-height: 1.4;
        }

        /* Fields */
        .field-label {
            display: block;
            font-family: 'Manrope', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 6px;
        }

        .field-wrap {
            position: relative;
            margin-bottom: 16px;
        }

        input[type="text"], input[type="password"] {
            width: 100%;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            color: var(--text-dark);
            background: var(--gray-bg);
            border: 1px solid transparent;
            border-radius: 10px;
            padding: 12px 14px;
        }

        .field-wrap input { padding-right: 40px; }

        input::placeholder { color: #9aa08f; }

        input[type="text"]:focus, input[type="password"]:focus {
            outline: none;
            border-color: var(--green-primary);
            box-shadow: 0 0 0 3px rgba(27,109,36,0.12);
            background: #fff;
        }

        .toggle-eye {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            display: flex;
            color: #8a9086;
        }

        .toggle-eye .material-symbols-outlined { font-size: 20px; }

        button[type="submit"] {
            width: 100%;
            background: var(--green-primary);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 13px;
            font-family: 'Manrope', sans-serif;
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 6px;
            transition: background 0.15s ease;
        }

        button[type="submit"]:hover { background: #164f1c; }

        .msg {
            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            text-align: center;
            margin-top: 12px;
        }

        .field-warning {
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            color: #dc2626;
            text-align: center;
            margin: 0 0 14px;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">
                <img src="~/img/logo.png" alt="CounselCare logo" />
            </div>
        </div>

        <div class="auth-body">
            @if (ViewBag.Forced == true)
            {
                <div class="auth-notice">You must set a new password before continuing.</div>
            }

            @if (ViewBag.ErrorMessage != null)
            {
                <p class="field-warning">@ViewBag.ErrorMessage</p>
            }

            <form method="post">
                @Html.AntiForgeryToken()

                <div class="field-wrap">
                    <input type="password" name="currentPassword" class="pw-field" placeholder="Current Password" />
                </div>

                <label class="field-label">New Password</label>
                <div class="field-wrap">
                    <input type="password" name="newPassword" class="pw-field" placeholder="New Password" />
                    <button type="button" class="toggle-eye pw-toggle" aria-label="Show password">
                        <span class="material-symbols-outlined eye-icon">visibility_off</span>
                    </button>
                </div>

                <label class="field-label">Confirm Password</label>
                <div class="field-wrap">
                    <input type="password" name="confirmPassword" class="pw-field" placeholder="Confirm Password" />
                    <button type="button" class="toggle-eye pw-toggle" aria-label="Show password">
                        <span class="material-symbols-outlined eye-icon">visibility_off</span>
                    </button>
                </div>

                <button type="submit">Change Password</button>
            </form>

            @if (ViewBag.SuccessMessage != null)
            {
                <p class="msg" style="color:#065f46;">@ViewBag.SuccessMessage</p>
            }
        </div>
    </div>

    <script>
        document.querySelectorAll('.pw-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var wrap = btn.closest('.field-wrap');
                var input = wrap.querySelector('.pw-field');
                var icon = btn.querySelector('.eye-icon');
                var isVisible = input.type === 'text';
                input.type = isVisible ? 'password' : 'text';
                icon.textContent = isVisible ? 'visibility_off' : 'visibility';
            });
        });
    </script>
</body>
</html>
