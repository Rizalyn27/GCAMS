@model GCAMS.ViewModels.Reports.ReportsPageViewModel
@{
    ViewData["Title"] = "Reports";
    Layout = "_Layout";

    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var months = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat;
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Reports/Reports.css" asp-append-version="true" />
}

<div class="rpt">
    <div class="head-card">
        <div class="head-top">
            <div>
                <p class="lede">
                    Each report summarises one part of the guidance record and ends in
                    something you can act on.
                    @(Model.IsAdmin
                                        ? "You're seeing school-wide figures across all counselors."
                                        : "You're seeing your own caseload.")
                </p>
            </div>
        </div>

        <form method="get" class="filters" id="filterForm">
            <input type="hidden" name="tab" id="tabField" value="@Model.ActiveTab" />

            <div class="field">
                <label>Academic year</label>
                <select name="AcademicYear">
                    @foreach (var ay in Model.Filter.AcademicYearOptions)
                    {
                        <option value="@ay" selected="@(ay == Model.Filter.AcademicYear)">@ay</option>
                    }
                </select>
            </div>

            <div class="field">
                <label>Month</label>
                <select name="Month">
                    <option value="">All months</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.Filter.Month == m)">@months.GetMonthName(m)</option>
                    }
                </select>
            </div>

            <div class="field">
                <label>Grade level</label>
                <select name="GradeLevel">
                    <option value="">All grades</option>
                    @foreach (var g in Model.Filter.GradeLevelOptions)
                    {
                        <option value="@g" selected="@(g == Model.Filter.GradeLevel)">@g</option>
                    }
                </select>
            </div>

            @if (Model.Filter.CanChooseCounselor)
            {
                <div class="field">
                    <label>Counselor</label>
                    <select name="CounselorId">
                        <option value="">All counselors</option>
                        @foreach (var c in Model.Filter.CounselorOptions)
                        {
                            <option value="@c.Id" selected="@(Model.Filter.CounselorId == c.Id)">@c.Name</option>
                        }
                    </select>
                </div>
            }

            <button type="submit" class="btn-r btn-green">Apply</button>
        </form>

        <!-- ============ TABS ============ -->
        <div class="tabs-bar">
            <button class="tab-btn" data-tab="summary" onclick="switchTab('summary', this)">
                Counseling Summary
            </button>
            <button class="tab-btn" data-tab="followup" onclick="switchTab('followup', this)">
                Follow-up Compliance
                
            </button>
            <button class="tab-btn" data-tab="incidents" onclick="switchTab('incidents', this)">
                Behavioral Incidents
            </button>
            @if (Model.IsAdmin)
            {
                <button class="tab-btn" data-tab="utilisation" onclick="switchTab('utilisation', this)">
                    Appointments
                </button>
                <button class="tab-btn" data-tab="workload" onclick="switchTab('workload', this)">
                    Counselor Workload
                </button>
                
            }
        </div>
    </div>


    <!-- ============ TAB 1: COUNSELING SUMMARY ============ -->
    <div id="tab-summary" class="tab-panel">
        <div class="section-card">
            <div class="section-header">
                @Model.Summary.Title
                <a class="btn-r btn-ghost" style="margin-left:auto; padding:6px 14px; font-size:13px;"
                   asp-action="Export" asp-route-report="summary"
                   asp-route-AcademicYear="@Model.Filter.AcademicYear"
                   asp-route-Month="@Model.Filter.Month"
                   asp-route-GradeLevel="@Model.Filter.GradeLevel"></a>
            </div>
            <div class="section-body">

                <div class="strip">
                    @foreach (var k in Model.Summary.Kpis)
                    {
                        <div class="kpi @(k.IsWarning ? "warn" : "")">
                            <div class="k">@k.Label</div>
                            <div class="v">@k.Value</div>
                            @if (!string.IsNullOrWhiteSpace(k.Note))
                            {
                                <div class="n">@k.Note</div>
                            }
                        </div>
                    }
                </div>

                @if (Model.Summary.Rows.Any())
                {
                    <div class="tablewrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Concern category</th>
                                    <th>Share of load</th>
                                    <th>Sessions</th>
                                    <th>Students</th>
                                    <th>Most affected</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Summary.Rows)
                                {
                                    <tr>
                                        <td class="name">@r.Category</td>
                                        <td>
                                            <div class="barcell">
                                                <div class="bartrack">
                                                    <div class="barfill @(r.IsLead ? "lead" : "")" style="width:@r.SharePercent.ToString(inv)%"></div>
                                                </div>
                                                <span class="num">@r.SharePercent%</span>
                                            </div>
                                        </td>
                                        <td class="num">@r.Sessions</td>
                                        <td class="num">@r.Students</td>
                                        <td>
                                            @r.TopGradeLevel
                                            @if (r.TopGradeCount > 0)
                                            {
                                                <span class="sub">@r.TopGradeCount of @r.Sessions sessions</span>
                                            }
                                        </td>
                                        
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        No sessions with a concern category in this period.<br />
                        Case notes saved before the category field was added won't appear here.
                    </div>
                }

                <div class="foot">
                    <span>@Model.Summary.SourceNote</span>
                    <span>@Model.PeriodLabel &middot; generated @Model.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ TAB 2: FOLLOW-UP COMPLIANCE ============ -->
    <div id="tab-followup" class="tab-panel">
        <div class="section-card">
            <div class="section-header">
                @Model.FollowUp.Title
                <a class="btn-r btn-ghost" style="margin-left:auto; padding:6px 14px; font-size:13px;"
                   asp-action="Export" asp-route-report="followup"
                   asp-route-AcademicYear="@Model.Filter.AcademicYear"
                   asp-route-Month="@Model.Filter.Month"></a>
            </div>
            <div class="section-body">

                <div class="strip">
                    @foreach (var k in Model.FollowUp.Kpis)
                    {
                        <div class="kpi @(k.IsWarning ? "warn" : "")">
                            <div class="k">@k.Label</div>
                            <div class="v">@k.Value</div>
                            @if (!string.IsNullOrWhiteSpace(k.Note))
                            {
                                <div class="n">@k.Note</div>
                            }
                        </div>
                    }
                </div>

                @if (Model.FollowUp.Rows.Any())
                {
                    <div class="tablewrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Due</th>
                                    <th>Overdue</th>
                                    <th>Sessions</th>
                                    @if (Model.IsAdmin)
                                    {
                                        <th>Counselor</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.FollowUp.Rows)
                                {
                                    <tr>
                                        <td class="name">
                                            @r.StudentName
                                            @if (!string.IsNullOrWhiteSpace(r.GradeSection))
                                            {
                                                <span class="sub">@r.GradeSection</span>
                                            }
                                        </td>
                                        <td>@r.DueDate.ToString("MMM d, yyyy")</td>
                                        <td>
                                            <span class="pill @(r.DaysOverdue > 14 ? "p-bad" : "p-warn")">
                                                @r.DaysOverdue day@(r.DaysOverdue == 1 ? "" : "s")
                                            </span>
                                        </td>
                                        <td class="num">@r.SessionCount</td>
                                        @if (Model.IsAdmin)
                                        {
                                            <td>@r.CounselorName</td>
                                        }
                                        
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        No overdue follow-ups. Every follow-up scheduled in this period was
                        completed or called off.
                    </div>
                }

                <div class="foot">
                    <span>@Model.FollowUp.SourceNote</span>
                    <span>@Model.PeriodLabel &middot; generated @Model.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ TAB 3: DRIFTING STUDENTS ============ -->
    <div id="tab-drift" class="tab-panel">
        <div class="section-card">
            <div class="section-header">
                @Model.Drift.Title
                <a class="btn-r btn-ghost" style="margin-left:auto; padding:6px 14px; font-size:13px;"
                   asp-action="Export" asp-route-report="drift"
                   asp-route-GradeLevel="@Model.Filter.GradeLevel"></a>
            </div>
            <div class="section-body">

                <div class="strip">
                    @foreach (var k in Model.Drift.Kpis)
                    {
                        <div class="kpi @(k.IsWarning ? "warn" : "")">
                            <div class="k">@k.Label</div>
                            <div class="v">@k.Value</div>
                            @if (!string.IsNullOrWhiteSpace(k.Note))
                            {
                                <div class="n">@k.Note</div>
                            }
                        </div>
                    }
                </div>

                @if (Model.Drift.Rows.Any())
                {
                    <div class="tablewrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Last session</th>
                                    <th>Gap</th>
                                    <th>Sessions</th>
                                    <th>Last concern</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Drift.Rows)
                                {
                                    <tr>
                                        <td class="name">
                                            @r.StudentName
                                            <span class="sub">@r.GradeSection</span>
                                        </td>
                                        <td>@r.LastSessionDate.ToString("MMM d, yyyy")</td>
                                        <td>
                                            <span class="pill @(r.DaysSince > 60 ? "p-bad" : "p-warn")">@r.DaysSince days</span>
                                        </td>
                                        <td class="num">@r.SessionCount</td>
                                        <td>@r.LastConcern</td>
                                        
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        Nobody is drifting. Every student with counselling history has either
                        been seen recently or has something booked.
                    </div>
                }

                <div class="foot">
                    <span>@Model.Drift.SourceNote</span>
                    <span>generated @Model.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ TAB 4: BEHAVIORAL INCIDENTS ============ -->
    <div id="tab-incidents" class="tab-panel">
        <div class="section-card">
            <div class="section-header">
                @Model.Incidents.Title
                <a class="btn-r btn-ghost" style="margin-left:auto; padding:6px 14px; font-size:13px;"
                   asp-action="Export" asp-route-report="incidents"
                   asp-route-AcademicYear="@Model.Filter.AcademicYear"
                   asp-route-Month="@Model.Filter.Month"></a>
            </div>
            <div class="section-body">

                <div class="strip">
                    @foreach (var k in Model.Incidents.Kpis)
                    {
                        <div class="kpi @(k.IsWarning ? "warn" : "")">
                            <div class="k">@k.Label</div>
                            <div class="v">@k.Value</div>
                            @if (!string.IsNullOrWhiteSpace(k.Note))
                            {
                                <div class="n">@k.Note</div>
                            }
                        </div>
                    }
                </div>

                @if (Model.Incidents.Rows.Any())
                {
                    <div class="tablewrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Student Involved</th>
                                    <th>Location</th>
                                    <th>Records</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Incidents.Rows)
                                {
                                    <tr>
                                        <td class="name">@r.StudentName</td>
                                        <td>@r.Place</td>
                                        <td class="num">@r.Incidents</td>
                                        
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">No anecdotal records logged in this period.</div>
                }

                <div class="foot">
                    <span>@Model.Incidents.SourceNote</span>
                    <span>@Model.PeriodLabel &middot; generated @Model.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsAdmin && Model.Utilisation != null && Model.Workload != null && Model.Audit != null)
    {
        <!-- ============ TAB 5: APPOINTMENT UTILISATION ============ -->
        <div id="tab-utilisation" class="tab-panel">
            <div class="section-card">
                <div class="section-header">
                    @Model.Utilisation.Title
                    <a class="btn-r btn-ghost" style="margin-left:auto; padding:6px 14px; font-size:13px;"
                       asp-action="Export" asp-route-report="utilisation"
                       asp-route-AcademicYear="@Model.Filter.AcademicYear"
                       asp-route-Month="@Model.Filter.Month"></a>
                </div>
                <div class="section-body">

                    <div class="strip">
                        @foreach (var k in Model.Utilisation.Kpis)
                        {
                            <div class="kpi @(k.IsWarning ? "warn" : "")">
                                <div class="k">@k.Label</div>
                                <div class="v">@k.Value</div>
                                @if (!string.IsNullOrWhiteSpace(k.Note))
                                {
                                    <div class="n">@k.Note</div>
                                }
                            </div>
                        }
                    </div>

                    @if (Model.Utilisation.Rows.Any())
                    {
                        <div class="tablewrap">
                            <table>
                                <thead>
                                    <tr><th>Status</th><th>Count</th><th>Notes</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.Utilisation.Rows)
                                    {
                                        <tr>
                                            <td class="name">@r.Status</td>
                                            <td class="num">@r.Count</td>
                                            <td>
                                                @r.Note
                                            </td>
                                            
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">No appointments in this period.</div>
                    }

                    <div class="foot">
                        <span>@Model.Utilisation.SourceNote</span>
                        <span>@Model.PeriodLabel &middot; generated @Model.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ TAB 6: COUNSELOR WORKLOAD ============ -->
        <div id="tab-workload" class="tab-panel">
            <div class="section-card">
                <div class="section-header">
                    @Model.Workload.Title
                    <a class="btn-r btn-ghost" style="margin-left:auto; padding:6px 14px; font-size:13px;"
                       asp-action="Export" asp-route-report="workload"
                       asp-route-AcademicYear="@Model.Filter.AcademicYear"></a>
                </div>
                <div class="section-body">

                    <div class="strip">
                        @foreach (var k in Model.Workload.Kpis)
                        {
                            <div class="kpi @(k.IsWarning ? "warn" : "")">
                                <div class="k">@k.Label</div>
                                <div class="v">@k.Value</div>
                                @if (!string.IsNullOrWhiteSpace(k.Note))
                                {
                                    <div class="n">@k.Note</div>
                                }
                            </div>
                        }
                    </div>

                    @if (Model.Workload.Rows.Any())
                    {
                        <div class="tablewrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Counselor</th>
                                        <th>Share of open cases</th>
                                        <th>Sessions</th>
                                        <th>Open cases</th>
                                        <th>Overdue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.Workload.Rows)
                                    {
                                        <tr>
                                            <td class="name">
                                                @r.CounselorName
                                                @if (!string.IsNullOrWhiteSpace(r.Position))
                                                {
                                                    <span class="sub">@r.Position</span>
                                                }
                                            </td>
                                            <td>
                                                @if (r.CounselorId.HasValue)
                                                {
                                                    <div class="barcell">
                                                        <div class="bartrack">
                                                            <div class="barfill @(r.IsLead ? "lead" : "")" style="width:@r.SharePercent.ToString(inv)%"></div>
                                                        </div>
                                                        <span class="num">@r.SharePercent%</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span>&mdash;</span>
                                                }
                                            </td>
                                            <td class="num">@(r.CounselorId.HasValue? r.Sessions.ToString() : "—")</td>
                                            <td class="num">@r.OpenCases</td>
                                            <td>
                                                @if (!r.CounselorId.HasValue)
                                                {
                                                    <span class="pill p-warn">Needs assigning</span>
                                                }
                                                else if (r.Overdue > 0)
                                                {
                                                    <span class="pill p-bad">@r.Overdue</span>
                                                }
                                                else
                                                {
                                                    <span class="pill p-ok">0</span>
                                                }
                                            </td>
                                            
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">No active counselors on record.</div>
                    }

                    <div class="foot">
                        <span>@Model.Workload.SourceNote</span>
                        <span>@Model.PeriodLabel &middot; generated @Model.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</span>
                    </div>
                </div>
            </div>
        </div>

    }

</div>

<script>
    function switchTab(name, btn) {
        document.querySelectorAll('.rpt .tab-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.rpt .tab-btn').forEach(b => b.classList.remove('active'));

        const panel = document.getElementById('tab-' + name);
        if (panel) panel.classList.add('active');
        if (btn) btn.classList.add('active');

        // Carry the open tab through the next Apply so the filter form
        // doesn't bounce the user back to tab one.
        const field = document.getElementById('tabField');
        if (field) field.value = name;
    }


    // Open whichever tab the server said, defaulting to the first.
    document.addEventListener('DOMContentLoaded', function () {
        const wanted = '@Model.ActiveTab';
        let btn = document.querySelector('.rpt .tab-btn[data-tab="' + wanted + '"]');
        if (!btn) btn = document.querySelector('.rpt .tab-btn');
        if (btn) switchTab(btn.dataset.tab, btn);
    });
</script>
