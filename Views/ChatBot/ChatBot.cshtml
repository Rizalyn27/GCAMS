@{
    ViewData["Title"] = "Ask CareBot";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Chatbot/Chatbot.css" asp-append-version="true" />
}

@section Breadcrumb {
    <a asp-controller="Home" asp-action="Index" class="back-chevron" title="Back to dashboard">
        <span class="material-symbols-outlined">chevron_left</span>
    </a>
    <nav class="breadcrumb-nav">
        <a asp-controller="Home" asp-action="Index">Care Center</a>
        <span class="material-symbols-outlined breadcrumb-sep">chevron_right</span>
        <span class="current">Ask CareBot</span>
    </nav>
}

<div class="carebot">
    <div class="bot-grid">

        <section class="chat-panel">

            <header class="chat-head">
                <div class="bot-avatar">
                    <i class="bi bi-robot"></i>
                </div>
                <div>
                    <div class="bot-name">CareBot</div>
                    <div class="bot-status">
                        <span class="status-dot"></span>
                        Online · answers questions about the Care Center
                    </div>
                </div>
            </header>

            <div class="chat-disclaimer">
                <i class="bi bi-info-circle"></i>
                <span>
                    CareBot is not a counselor. It can explain how things work and help you
                    book, but it can't give advice about what you're going through. For that,
                    talk to a counselor.
                </span>
            </div>

            <div id="ChatArea" class="chat-area" role="log" aria-live="polite" aria-label="Conversation with CareBot">
                <div class="day-divider"><span>Today</span></div>

                <div class="msg msg-bot">
                    <div class="msg-avatar">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div class="msg-bubble">
                        <p>Hi! I'm CareBot, the Care Center's assistant.</p>
                        <p>I can help you with things like:</p>
                        <ul>
                            <li>Booking or changing a counseling session</li>
                            <li>Office hours and where to find the guidance office</li>
                            <li>What happens during a session, and who can see your records</li>
                        </ul>
                        <span class="msg-time">@DateTime.Now.ToString("h:mm tt")</span>
                    </div>
                </div>
            </div>

            <div class="composer">
                <div class="suggestions">
                    <span class="suggest-label">Try asking:</span>
                    <button type="button" class="chip">How do I book a session?</button>
                    <button type="button" class="chip">What are the office hours?</button>
                    <button type="button" class="chip">Who can see my session notes?</button>
                </div>

                <div class="composer-row">
                    <textarea id="UserMessage" rows="1" maxlength="500"
                              placeholder="Ask CareBot a question…"
                              aria-label="Your message"></textarea>
                    <button type="button" id="SendBtn" class="btn-send" aria-label="Send message">
                        <i class="bi bi-send"></i>.
                    </button>
                </div>

                <div class="composer-foot">
                    <span id="charCount">0 / 500</span>
                </div>
            </div>
        </section>

        <aside class="bot-side">

            <section class="card">
                <h2 class="card-title">What CareBot can do</h2>
                <p class="card-sub">
                    It knows the Care Center's rules and schedules nothing about you personally.
                </p>

                <ul class="cap-list">
                    <li class="can"><i class="bi bi-check-lg"></i> Explain how booking works, step by step</li>
                    <li class="can"><i class="bi bi-check-lg"></i> Tell you office hours and room numbers</li>
                    <li class="can"><i class="bi bi-check-lg"></i> Explain who can see your records</li>
                    <li class="can"><i class="bi bi-check-lg"></i> Point you to the right person to talk to</li>
                    <li class="cant"><i class="bi bi-x-lg"></i> It can't give counseling or personal advice</li>
                    <li class="cant"><i class="bi bi-x-lg"></i> It can't see your appointments or your notes</li>
                </ul>
            </section>

            <section class="card">
                <h2 class="card-title">Talk to a person instead</h2>
                <p class="card-sub">CareBot can't replace a counselor. These always can.</p>

                <div class="help-card help-card-urgent">
                    <div class="help-head">
                        <i class="bi bi-heart"></i>
                        I need help today
                    </div>
                    <p class="help-text">
                        Walk in to the Guidance Office during school hours. No appointment needed,
                        and you don't need a reason ready.
                    </p>
                </div>

                <a class="help-card help-link" asp-controller="Appointments" asp-action="Create">
                    <div class="help-head">
                        <i class="bi bi-calendar-plus"></i>
                        Book a session
                    </div>
                    <p class="help-text">Pick a time with a counselor</p>
                </a>

                <a class="help-card help-link" asp-controller="Appointments" asp-action="MyAppointments">
                    <div class="help-head">
                        <i class="bi bi-calendar-check"></i>
                        My sessions
                    </div>
                    <p class="help-text">What you've booked and already attended</p>
                </a>
            </section>

        </aside>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const chatArea   = document.getElementById('ChatArea');
            const userInput  = document.getElementById('UserMessage');
            const sendBtn    = document.getElementById('SendBtn');
            const charCount  = document.getElementById('charCount');

            // Anything the user or the server sends is treated as text, never markup.
            function appendMessage(role, text) {
                const wrap = document.createElement('div');
                wrap.className = 'msg msg-' + role;

                if (role === 'bot') {
                    const avatar = document.createElement('div');
                    avatar.className = 'msg-avatar';
                    avatar.innerHTML = '<i class="bi bi-robot"></i>';
                    wrap.appendChild(avatar);
                }

                const bubble = document.createElement('div');
                bubble.className = 'msg-bubble';

                const body = document.createElement('p');
                body.textContent = text;
                bubble.appendChild(body);

                const time = document.createElement('span');
                time.className = 'msg-time';
                time.textContent = new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
                bubble.appendChild(time);

                wrap.appendChild(bubble);
                chatArea.appendChild(wrap);
                chatArea.scrollTop = chatArea.scrollHeight;
                scrollToEnd();
                return wrap;
            }

            function showTyping() {
                const wrap = document.createElement('div');
                wrap.className = 'msg msg-bot';
                wrap.id = 'typing-indicator';
                wrap.innerHTML = `
                    <div class="msg-avatar"><i class="bi bi-robot"></i></div>
                    <div class="msg-bubble typing"><span></span><span></span><span></span></div>`;
                chatArea.appendChild(wrap);
                scrollToEnd();
            }

            function hideTyping() {
                const indicator = document.getElementById('typing-indicator');
                if (indicator) { indicator.remove(); }
            }

            function scrollToEnd() {
                chatArea.scrollTop = chatArea.scrollHeight;
            }

            function setBusy(isBusy) {
                sendBtn.disabled = isBusy;
                userInput.disabled = isBusy;
                if (!isBusy) { userInput.focus(); }
            }

            async function sendMessage() {
                const message = userInput.value.trim();
                if (message === '') { return; }

                appendMessage('user', message);
                userInput.value = '';
                autoGrow();
                syncCount();
                setBusy(true);
                showTyping();

                try {
                    const res = await fetch('/ChatBot/SendMessage', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Message: message })
                    });

                    if (!res.ok) { throw new Error('Request failed'); }

                    const data = await res.json();
                    hideTyping();
                    appendMessage('bot', data.answer);

                } catch (err) {
                    hideTyping();
                    appendMessage('bot', "Sorry — I couldn't reach the server just now. Please try again in a moment.");
                } finally {
                    setBusy(false);
                }
            }

            // Textarea grows with the message instead of scrolling in a 2-row box
            function autoGrow() {
                userInput.style.height = 'auto';
                userInput.style.height = Math.min(userInput.scrollHeight, 140) + 'px';
            }

            function syncCount() {
                charCount.textContent = `${userInput.value.length} / 500`;
            }

            sendBtn.addEventListener('click', sendMessage);

            userInput.addEventListener('input', () => { autoGrow(); syncCount(); });

            userInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            document.querySelectorAll('.chip').forEach(chip => {
                chip.addEventListener('click', function () {
                    userInput.value = this.textContent.trim();
                    syncCount();
                    sendMessage();
                });
            });

            syncCount();
            userInput.focus();
        });
    </script>
}
