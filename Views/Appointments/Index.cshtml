@model GCAMS.ViewModels.AppointmentCalendarViewModel
@{
    ViewData["Title"] = "Appointments";
    var today = DateTime.Today;
    var prevMonth = new DateTime(Model.Year, Model.Month, 1).AddMonths(-1);
    var nextMonth = new DateTime(Model.Year, Model.Month, 1).AddMonths(1);

    // Status counts — computed from the selected day's appointments.
    // If you want true month-wide counts, expose a Dictionary<string,int> (e.g. Model.StatusCounts)
    // from the controller/ViewModel and swap the lines below for that instead.
    var needsConfirmingCount = Model.SelectedDayAppointments?.Count(a => a.Status == "Pending") ?? 0;
    var confirmedCount = Model.SelectedDayAppointments?.Count(a => a.Status == "Confirmed") ?? 0;
    var completedCount = Model.SelectedDayAppointments?.Count(a => a.Status == "Completed") ?? 0;
    var cancelledCount = Model.SelectedDayAppointments?.Count(a => a.Status == "Cancelled" || a.Status == "Missed") ?? 0;
}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/Appointments/Index.css" asp-append-version="true" />

<div class="appt-page">

    <div class="appt-toolbar">
        <div class="appt-toolbar-left">
            <a class="icon-btn" asp-action="Index" asp-route-year="@prevMonth.Year" asp-route-month="@prevMonth.Month">&larr;</a>
            <a class="icon-btn" asp-action="Index" asp-route-year="@nextMonth.Year" asp-route-month="@nextMonth.Month">&rarr;</a>
            <a class="today-btn" asp-action="Index" asp-route-year="@today.Year" asp-route-month="@today.Month" asp-route-day="@today.Day">Today</a>
        </div>

        <div class="month-title">@Model.MonthName</div>

        <div class="view-toggle">
            <span class="active">Day</span>
        </div>
    </div>

    <div class="appt-actions-row">
        <a asp-action="Create" class="btn-new">+ New appointment</a>

        <div class="filter-chips">
            <span class="filter-chip"><span class="chip-dot dot-pending"></span>Needs confirming @needsConfirmingCount</span>
            <span class="filter-chip"><span class="chip-dot dot-confirmed"></span>Confirmed @confirmedCount</span>
            <span class="filter-chip"><span class="chip-dot dot-completed"></span>Completed @completedCount</span>
            <span class="filter-chip"><span class="chip-dot dot-cancelled"></span>Cancelled @cancelledCount</span>
        </div>
    </div>

    <div class="appt-body">

        <div class="cal-panel">
            <div class="cal-grid">
                @foreach (var wd in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                {
                    <div class="cal-weekday">@wd</div>
                }

                @foreach (var d in Model.Days)
                {
                    var isSelected = Model.SelectedDate.HasValue && Model.SelectedDate.Value == d.Date;
                    <a class="cal-day @(d.IsCurrentMonth ? "" : "other-month") @(isSelected ? "selected" : "")"
                       asp-action="Index"
                       asp-route-year="@d.Date.Year"
                       asp-route-month="@d.Date.Month"
                       asp-route-day="@d.Date.Day">
                        <div class="cal-day-top">
                            <span class="cal-day-num @(d.IsToday ? "today" : "")">@d.Date.Day</span>
                        </div>

                        @if (d.Count > 0)
                        {
                            <span class="cal-appt-pill">@d.Count appt@(d.Count == 1 ? "" : "s")</span>
                        }
                        else
                        {
                            <span class="cal-day-closed">Closed</span>
                        }
                    </a>
                }
            </div>
        </div>

        <div class="day-side-panel">
            @if (Model.SelectedDate.HasValue)
            {
                <div class="day-panel-title">@Model.SelectedDate.Value.ToString("dddd, d MMMM")</div>
                <div class="day-panel-subtitle">@Model.SelectedDayAppointments.Count() appointment@(Model.SelectedDayAppointments.Count() == 1 ? "" : "s")</div>

                @if (!Model.SelectedDayAppointments.Any())
                {
                    <div class="empty-state">No appointments on this day.</div>
                }
                else
                {
                    foreach (var item in Model.SelectedDayAppointments.OrderBy(a => a.AppointmentDate))
                    {
                        <div class="timeline-item">
                            <div class="timeline-time-col">
                                <div class="timeline-time">@item.AppointmentDate.ToString("h:mm tt")</div>
                                <div class="timeline-duration">30 min</div>
                            </div>
                            <div class="timeline-rail">
                                <div class="timeline-dot"></div>
                            </div>
                            <div class="timeline-card">
                                <div class="timeline-name">@item.FullName</div>
                                <div class="timeline-meta">@item.AppointmentType<br />@item.Email</div>
                                <div class="timeline-card-actions">
                                    <span class="status-badge @item.Status">@item.Status</span>

                                    <select class="status-select status-dropdown" data-id="@item.AppointmentID" data-current="@item.Status">
                                        @foreach (var status in new[] { "Pending", "Confirmed", "Completed", "Missed", "Cancelled" })
                                        {
                                            <option value="@status" selected="@(item.Status == status ? "selected" : null)">@status</option>
                                        }
                                    </select>

                                    <a asp-action="Details" asp-route-appointmentid="@item.AppointmentID" class="row-link">View</a>
                                    @if (item.Status == "Pending")
                                    {
                                        <a asp-action="Edit" asp-route-appointmentid="@item.AppointmentID" class="row-link">Edit</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <div class="day-panel-title">Select a date</div>
                <div class="empty-state">Pick a day on the calendar to see its appointments.</div>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.status-dropdown').forEach(function (dropdown) {
            dropdown.addEventListener('change', async function () {
                const appointmentId  = this.dataset.id;
                const newStatus      = this.value;
                const previousStatus = this.dataset.current;
                try {
                    const response = await fetch('/Appointments/UpdateStatus', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ appointmentId, newStatus })
                    });
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert('Failed to update status. Please try again.');
                        this.value = previousStatus;
                    }
                } catch (err) {
                    console.error('Status update failed:', err);
                    alert('Could not reach the server. Please try again.');
                    this.value = previousStatus;
                }
            });
        });
    </script>
}
