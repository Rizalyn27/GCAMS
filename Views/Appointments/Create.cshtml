@model GCAMS.Models.Appointment.Appointments

@{
    ViewData["Title"] = "Book a session";
    var isStudentBooking = ViewBag.IsStudentBooking == true;
    var cancelAction = User.IsInRole("Student") ? "MyAppointments" : "Index";
}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700;0,1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/Appointments/Create.css" asp-append-version="true" />


@section Breadcrumb {
    <a asp-action="@cancelAction" class="back-chevron" title="Back">
        <span class="material-symbols-outlined"></span>
    </a>
    <nav class="breadcrumb-nav">
        <a asp-action="@cancelAction">Appointments</a>
        <span class="material-symbols-outlined breadcrumb-sep"></span>
        <span class="current">Book a session</span>
    </nav>
}

<div class="booking">

    <header class="booking-head">
        <h1>Book a session</h1>
        <p class="booking-lead">
            Choose a time, tell your counselor what you want to talk about, and send your
            request. It only takes about a minute, and you can change it later.
        </p>
    </header>

    <!-- Progress indicator — reflects what's been filled in on this page -->
    <ol class="stepper" id="stepper">
        <li class="step is-current" data-step="time"><span class="step-dot">1</span> Pick a time</li>
        <li class="step" data-step="about"><span class="step-dot">2</span> Say what it's about</li>
        <li class="step" data-step="send"><span class="step-dot">3</span> Send the request</li>
    </ol>

    <form asp-action="Create" id="appointmentForm" class="booking-grid">

        <div class="booking-main">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <input type="hidden" asp-for="StudentsID" id="studentsIdHidden" />
            <input type="hidden" asp-for="Status" value="Pending" />

            @if (!isStudentBooking)
            {
                <section class="card">
                    <h2 class="card-title">
                        <span class="material-symbols-outlined">search</span>
                        Student lookup
                    </h2>
                    <p class="card-sub">Enter the school-issued ID to fill in the details automatically.</p>

                    <label for="stuIdLookup" class="field-label">Student ID</label>
                    <div class="lookup-group">
                        <input type="text" id="stuIdLookup" class="form-control"
                               placeholder="e.g. 2024-0001" autocomplete="off" />
                        <button type="button" class="btn-lookup" id="btnLookup">Search</button>
                    </div>
                    <small id="lookupStatus" class="lookup-status"></small>
                </section>
            }

            <section class="card">
                <h2 class="card-title">
                    <span class="material-symbols-outlined"></span>
                    @(isStudentBooking ? "Booking as" : "Client")
                </h2>

                @if (isStudentBooking)
                {
                    <div class="identity">
                        <div class="identity-avatar">
                            @(string.IsNullOrWhiteSpace(Model?.FullName) ? "?" : Model.FullName.Trim().Substring(0, 1).ToUpper())
                        </div>
                        <div class="identity-body">
                            <div class="identity-name">@Model?.FullName</div>
                            <div class="identity-meta">
                                @if (!string.IsNullOrEmpty(ViewBag.GradeLevel as string))
                                {
                                    <text>@ViewBag.GradeLevel</text>
                                }
                                @if (!string.IsNullOrEmpty(ViewBag.Section as string))
                                {
                                    <text> · @ViewBag.Section</text>
                                }
                                @if (!string.IsNullOrEmpty(Model?.Email))
                                {
                                    <text> · @Model.Email</text>
                                }
                            </div>
                        </div>
                    </div>

                    <input type="hidden" asp-for="FullName" id="fieldFullName" />
                    <input type="hidden" asp-for="Email" id="fieldEmail" />
                    <input type="hidden" id="fieldGradeLevel" value="@(ViewBag.GradeLevel ?? "")" />
                    <input type="hidden" id="fieldSection" value="@(ViewBag.Section ?? "")" />
                }
                else
                {
                    <div class="form-grid">
                        <div class="full-width">
                            <label asp-for="FullName" class="field-label"></label>
                            <input asp-for="FullName" id="fieldFullName" class="form-control" />
                            <span asp-validation-for="FullName" class="field-error"></span>
                        </div>
                        <div>
                            <label class="field-label">Grade level</label>
                            <input type="text" id="fieldGradeLevel" class="form-control" readonly tabindex="-1"
                                   value="@(ViewBag.GradeLevel ?? "")" />
                        </div>
                        <div>
                            <label class="field-label">Section</label>
                            <input type="text" id="fieldSection" class="form-control" readonly tabindex="-1"
                                   value="@(ViewBag.Section ?? "")" />
                        </div>
                        <div class="full-width">
                            <label asp-for="Email" class="field-label"></label>
                            <input asp-for="Email" id="fieldEmail" class="form-control" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>
                    </div>
                }
            </section>

            <!-- ============ WHEN ============ -->
            <section class="card" id="when-card">
                <div class="card-head">
                    <h2 class="card-title">
                        <span class="material-symbols-outlined"></span>
                        When works for you?
                        <span class="pill-needed">Needed</span>
                    </h2>
                </div>
                <p class="card-sub">
                    Sessions run 8–11 AM and 1–4 PM on school days. Weekends are closed.
                </p>

                <div class="day-strip" id="dayStrip"></div>

                <div class="slot-group" id="slotMorning">
                    <div class="slot-heading">
                        <span class="material-symbols-outlined"></span> Morning
                    </div>
                    <div class="slot-row" data-slots="morning"></div>
                </div>

                <div class="slot-group" id="slotAfternoon">
                    <div class="slot-heading">
                        <span class="material-symbols-outlined"></span> Afternoon
                    </div>
                    <div class="slot-row" data-slots="afternoon"></div>
                </div>

                <div class="exact-time">
                    <label asp-for="AppointmentDate" class="field-label">Selected date and time</label>
                    <input asp-for="AppointmentDate" asp-format="{0:yyyy-MM-ddTHH:00}"
                           id="fieldAppointmentDate"
                           class="form-control" type="datetime-local"
                           step="3600"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:00")" />
                    <span asp-validation-for="AppointmentDate" class="field-error"></span>
                    <small class="field-hint">
                        Picking above fills this in. You can also type a time directly.
                    </small>
                </div>
            </section>

            <section class="card" id="about-card">
                <div class="card-head">
                    <h2 class="card-title">
                        <span class="material-symbols-outlined"></span>
                        What would you like to talk about?
                        <span class="pill-needed">Needed</span>
                    </h2>
                </div>
                <p class="card-sub">
                    Choose the option that best matches what you'd like help with.
                    You can talk about anything during your session.
                </p>

                <div class="type-group">
                    <div class="type-group-title">
                        <span class="material-symbols-outlined"></span> School and future
                    </div>
                    <div class="type-grid">
                        <label class="type-card">
                            <input type="radio" asp-for="AppointmentType" id="type-academic" value="Academic Concern" />
                            <span class="type-icon material-symbols-outlined"></span>
                            <span class="type-body">
                                <span class="type-name">Academic Concern</span>
                                <span class="type-desc">Grades, homework, or a subject you're struggling with</span>
                            </span>
                            <span class="type-check"></span>
                        </label>

                        <label class="type-card">
                            <input type="radio" asp-for="AppointmentType" id="type-behavioral" value="Behavioral Concern" />
                            <span class="type-icon material-symbols-outlined"></span>
                            <span class="type-body">
                                <span class="type-name">Behavioral Concern</span>
                                <span class="type-desc">Something about your behavior at school you'd like to talk about</span>
                            </span>
                            <span class="type-check"></span>
                        </label>

                        <label class="type-card">
                            <input type="radio" asp-for="AppointmentType" id="type-career" value="Career Guidance" />
                            <span class="type-icon material-symbols-outlined"></span>
                            <span class="type-body">
                                <span class="type-name">Career Guidance</span>
                                <span class="type-desc">Questions about your future, career, or college plans</span>
                            </span>
                            <span class="type-check"></span>
                        </label>
                    </div>
                </div>

                <div class="type-group">
                    <div class="type-group-title">
                        <span class="material-symbols-outlined"></span> Personal and relationships
                    </div>
                    <div class="type-grid">
                        <label class="type-card">
                            <input type="radio" asp-for="AppointmentType" id="type-personal" value="Personal/Emotional Concern" />
                            <span class="type-icon material-symbols-outlined"></span>
                            <span class="type-body">
                                <span class="type-name">Personal/Emotional Concern</span>
                                <span class="type-desc">Stress, worries, feelings, or something bothering you</span>
                            </span>
                            <span class="type-check"></span>
                        </label>

                        <label class="type-card">
                            <input type="radio" asp-for="AppointmentType" id="type-peer" value="Peer Relationship" />
                            <span class="type-icon material-symbols-outlined"></span>
                            <span class="type-body">
                                <span class="type-name">Peer Relationship</span>
                                <span class="type-desc">Problems with friends, classmates, or feeling left out</span>
                            </span>
                            <span class="type-check"></span>
                        </label>

                        <label class="type-card">
                            <input type="radio" asp-for="AppointmentType" id="type-family" value="Family-Related Concern" />
                            <span class="type-icon material-symbols-outlined"></span>
                            <span class="type-body">
                                <span class="type-name">Family-Related Concern</span>
                                <span class="type-desc">Something happening at home or with your family</span>
                            </span>
                            <span class="type-check"></span>
                        </label>

                        <label class="type-card">
                            <input type="radio" asp-for="AppointmentType" id="type-health" value="Health/Physical Concern" />
                            <span class="type-icon material-symbols-outlined"></span>
                            <span class="type-body">
                                <span class="type-name">Health/Physical Concern</span>
                                <span class="type-desc">Sleep, eating, energy, or a health concern affecting school</span>
                            </span>
                            <span class="type-check"></span>
                        </label>
                    </div>
                </div>

                <div class="type-group">
                    <div class="type-group-title">
                        <span class="material-symbols-outlined"></span> Safety and other
                    </div>
                    <div class="type-grid">
                        <label class="type-card">
                            <input type="radio" asp-for="AppointmentType" id="type-bullying" value="Bullying Report" />
                            <span class="type-icon material-symbols-outlined"></span>
                            <span class="type-body">
                                <span class="type-name">Bullying Report</span>
                                <span class="type-desc">Something hurtful happening to you or someone you know</span>
                            </span>
                            <span class="type-check"></span>
                        </label>

                        <label class="type-card type-card-urgent">
                            <input type="radio" asp-for="AppointmentType" id="type-crisis" value="Crisis/Urgent Concern" />
                            <span class="type-icon material-symbols-outlined"></span>
                            <span class="type-body">
                                <span class="type-name">Crisis/Urgent Concern</span>
                                <span class="type-desc">You need help with something urgent or serious</span>
                            </span>
                            <span class="type-check"></span>
                        </label>

                        <label class="type-card">
                            <input type="radio" asp-for="AppointmentType" id="type-followup" value="Follow-up Session" />
                            <span class="type-icon material-symbols-outlined"></span>
                            <span class="type-body">
                                <span class="type-name">Follow-up Session</span>
                                <span class="type-desc">Continue a conversation from a previous counseling session</span>
                            </span>
                            <span class="type-check"></span>
                        </label>

                        <label class="type-card">
                            <input type="radio" asp-for="AppointmentType" id="type-other" value="Other" />
                            <span class="type-icon material-symbols-outlined"></span>
                            <span class="type-body">
                                <span class="type-name">Other</span>
                                <span class="type-desc">Not sure which option fits? That's okay — choose this one</span>
                            </span>
                            <span class="type-check"></span>
                        </label>
                    </div>
                </div>

                <span asp-validation-for="AppointmentType" class="field-error"></span>

                <div class="urgent-note" id="urgentNote" hidden>
                    <span class="material-symbols-outlined">emergency</span>
                    <div>
                        If you need help today, don't wait for this request to be confirmed —
                        walk in to the Guidance Office during school hours and tell any staff
                        member you need to speak with a counselor.
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-head">
                    <h2 class="card-title">
                        <span class="material-symbols-outlined"></span>
                        Anything you want your counselor to know first?
                        <span class="pill-optional">Optional</span>
                    </h2>
                </div>
                <p class="card-sub">You can leave this blank and just talk in person.</p>

                <textarea asp-for="Notes" id="fieldNotes" class="form-control" rows="4" maxlength="320"
                          placeholder="For example: I've been having a hard time keeping up in math since the new grading period started."></textarea>
                <div class="notes-foot">
                    <span asp-validation-for="Notes" class="field-error"></span>
                    <span class="char-count" id="charCount">0 / 320</span>
                </div>

                <div class="privacy-strip">
                    <span class="material-symbols-outlined"></span>
                    Only your counselor reads this. It isn't shown to your teachers,
                    your classmates, or your parents.
                </div>
            </section>
        </div>

        <!-- ============ SUMMARY ============ -->
        <aside class="booking-side">
            <div class="card summary-card">
                <h2 class="card-title">Your request</h2>
                <p class="card-sub">Check this before you send it</p>

                <div class="summary-row">
                    <span class="material-symbols-outlined"></span>
                    <div>
                        <div class="summary-label">Day and time</div>
                        <div class="summary-value is-empty" id="summaryWhen">Not chosen yet</div>
                    </div>
                </div>

                <div class="summary-row">
                    <span class="material-symbols-outlined"></span>
                    <div>
                        <div class="summary-label">About</div>
                        <div class="summary-value is-empty" id="summaryAbout">Not chosen yet</div>
                    </div>
                </div>

                <div class="summary-row">
                    <span class="material-symbols-outlined"></span>
                    <div>
                        <div class="summary-label">Where</div>
                        <div class="summary-value">Guidance Office</div>
                    </div>
                </div>

                <div class="summary-warn" id="summaryWarn">
                    <span class="material-symbols-outlined"></span>
                    <span id="summaryWarnText">Still needed: a day and time, and what it's about.</span>
                </div>

                <button type="submit" class="btn-send" id="btnSend">
                    <span class="material-symbols-outlined"></span> Send the request
                </button>
                <a asp-action="@cancelAction" class="btn-cancel">Cancel and go back</a>

                <p class="summary-fine">
                    Sending a request doesn't confirm it yet. A counselor usually replies
                    within one school day, and you'll see the answer in My Appointments.
                </p>
            </div>
        </aside>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // ── Shared references ───────────────────────────────────────────────
        const hiddenStudentsID = document.getElementById('studentsIdHidden');
        const fieldFullName    = document.getElementById('fieldFullName');
        const fieldEmail       = document.getElementById('fieldEmail');
        const fieldGradeLevel  = document.getElementById('fieldGradeLevel');
        const fieldSection     = document.getElementById('fieldSection');
        const dateInput        = document.getElementById('fieldAppointmentDate');

        const ALLOWED_HOURS = [8, 9, 10, 11, 13, 14, 15, 16];

        // ── Student lookup (staff bookings only) ────────────────────────────
        const stuIdInput = document.getElementById('stuIdLookup');
        const btnLookup  = document.getElementById('btnLookup');
        const statusEl   = document.getElementById('lookupStatus');

        if (stuIdInput) {

            function setStatus(message, tone) {
                statusEl.textContent = message;
                statusEl.className = 'lookup-status tone-' + tone;
            }

            function clearStudentFields() {
                hiddenStudentsID.value = '';
                fieldFullName.value    = '';
                fieldEmail.value       = '';
                fieldGradeLevel.value  = '';
                fieldSection.value     = '';
                [fieldFullName, fieldEmail].forEach(f => f.removeAttribute('readonly'));
            }

            async function lookupStudent() {
                const stuId = stuIdInput.value.trim();

                if (!stuId) {
                    setStatus('Please enter a Student ID first.', 'muted');
                    return;
                }

                setStatus('Searching…', 'muted');

                try {
                    const response = await fetch(
                        `/Appointments/GetStudentByStuID?stuId=${encodeURIComponent(stuId)}`
                    );

                    if (response.ok) {
                        const student = await response.json();

                        hiddenStudentsID.value = student.studentsID;
                        fieldFullName.value    = student.fullName;
                        fieldEmail.value       = student.email;
                        fieldGradeLevel.value  = student.gradeLevel;
                        fieldSection.value     = student.section;

                        [fieldFullName, fieldEmail].forEach(f => f.setAttribute('readonly', true));
                        setStatus('Student found: ' + student.fullName, 'ok');

                    } else if (response.status === 404) {
                        clearStudentFields();
                        setStatus('ID not found — fill in the details manually.', 'warn');
                    } else {
                        setStatus('An error occurred. Please try again.', 'bad');
                    }
                } catch (err) {
                    console.error('Student lookup failed:', err);
                    setStatus('Could not reach the server. Check your connection.', 'bad');
                }
            }

            btnLookup.addEventListener('click', lookupStudent);

            stuIdInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    lookupStudent();
                }
            });

            stuIdInput.addEventListener('input', function () {
                if (this.value.trim() === '') {
                    clearStudentFields();
                    setStatus('', 'muted');
                }
            });
        }

        // ── Day and time picker — writes into AppointmentDate ───────────────
        const dayStrip = document.getElementById('dayStrip');
        const now = new Date();
        let selectedDay = null;   // 'YYYY-MM-DD'
        let selectedHour = null;  // 8..16

        function pad(n) { return String(n).padStart(2, '0'); }
        function isoDay(d) { return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; }

        // Seed from an existing value (validation redisplay keeps the choice visible)
        if (dateInput.value) {
            selectedDay = dateInput.value.split('T')[0];
            selectedHour = parseInt(dateInput.value.split('T')[1], 10);
        }

        function buildDayStrip() {
            dayStrip.innerHTML = '';

            for (let i = 0; i < 14; i++) {
                const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + i);
                const key = isoDay(d);
                const weekend = d.getDay() === 0 || d.getDay() === 6;

                const cell = document.createElement('button');
                cell.type = 'button';
                cell.className = 'day-cell' + (weekend ? ' is-closed' : '') + (key === selectedDay ? ' is-selected' : '');
                cell.disabled = weekend;
                cell.dataset.day = key;
                cell.innerHTML = `
                    <span class="day-name">${d.toLocaleDateString(undefined, { weekday: 'short' }).toUpperCase()}</span>
                    <span class="day-number">${d.getDate()}</span>
                    <span class="day-month">${d.toLocaleDateString(undefined, { month: 'short' })}</span>
                    <span class="day-state">${weekend ? 'Closed' : (i === 0 ? 'Today' : 'Open')}</span>`;

                cell.addEventListener('click', function () {
                    selectedDay = this.dataset.day;
                    selectedHour = null;
                    buildDayStrip();
                    buildSlots();
                    syncDateField();
                });

                dayStrip.appendChild(cell);
            }
        }

        function buildSlots() {
            document.querySelectorAll('[data-slots]').forEach(row => {
                const isMorning = row.dataset.slots === 'morning';
                const hours = ALLOWED_HOURS.filter(h => isMorning ? h < 12 : h >= 12);
                row.innerHTML = '';

                hours.forEach(h => {
                    const slot = document.createElement('button');
                    slot.type = 'button';

                    // A time earlier today can't be booked.
                    const isToday = selectedDay === isoDay(now);
                    const past = isToday && h <= now.getHours();

                    slot.className = 'slot' + (h === selectedHour ? ' is-selected' : '') + (past ? ' is-past' : '');
                    slot.disabled = !selectedDay || past;
                    slot.dataset.hour = h;

                    const label = new Date(2000, 0, 1, h).toLocaleTimeString(undefined,
                        { hour: 'numeric', minute: '2-digit' });
                    slot.innerHTML = `<span class="slot-time">${label}</span>
                                      <span class="slot-note">${past ? 'Passed' : '1 hour'}</span>`;

                    slot.addEventListener('click', function () {
                        selectedHour = parseInt(this.dataset.hour, 10);
                        buildSlots();
                        syncDateField();
                    });

                    row.appendChild(slot);
                });
            });
        }

        function syncDateField() {
            if (selectedDay && selectedHour !== null) {
                dateInput.value = `${selectedDay}T${pad(selectedHour)}:00`;
                dateInput.setCustomValidity('');
            }
            updateSummary();
        }

        // ── Working-hours guard (runs for students too, not just staff) ─────
        function isWithinWorkingHours(value) {
            if (!value) return true;
            const hour = parseInt(value.split('T')[1].split(':')[0], 10);
            return ALLOWED_HOURS.includes(hour);
        }

        dateInput.addEventListener('change', function () {
            if (!isWithinWorkingHours(this.value)) {
                this.setCustomValidity('Appointments must be booked between 8–11 AM or 1–4 PM.');
                this.reportValidity();
            } else {
                this.setCustomValidity('');
                if (this.value) {
                    selectedDay = this.value.split('T')[0];
                    selectedHour = parseInt(this.value.split('T')[1], 10);
                    buildDayStrip();
                    buildSlots();
                }
            }
            updateSummary();
        });

        // ── Summary, stepper, urgent note, character count ──────────────────
        const summaryWhen  = document.getElementById('summaryWhen');
        const summaryAbout = document.getElementById('summaryAbout');
        const summaryWarn  = document.getElementById('summaryWarn');
        const summaryWarnText = document.getElementById('summaryWarnText');
        const urgentNote   = document.getElementById('urgentNote');
        const notes        = document.getElementById('fieldNotes');
        const charCount    = document.getElementById('charCount');

        function selectedType() {
            const picked = document.querySelector('input[name="AppointmentType"]:checked');
            return picked ? picked.value : null;
        }

        function updateSummary() {
            const hasWhen = !!dateInput.value;
            const type = selectedType();

            if (hasWhen) {
                const d = new Date(dateInput.value);
                summaryWhen.textContent = d.toLocaleDateString(undefined,
                    { weekday: 'long', day: 'numeric', month: 'long' }) + ' · ' +
                    d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
                summaryWhen.classList.remove('is-empty');
            } else {
                summaryWhen.textContent = 'Not chosen yet';
                summaryWhen.classList.add('is-empty');
            }

            summaryAbout.textContent = type || 'Not chosen yet';
            summaryAbout.classList.toggle('is-empty', !type);

            urgentNote.hidden = type !== 'Crisis/Urgent Concern';

            const missing = [];
            if (!hasWhen) { missing.push('a day and time'); }
            if (!type) { missing.push("what it's about"); }

            if (missing.length) {
                summaryWarn.hidden = false;
                summaryWarnText.textContent = 'Still needed: ' + missing.join(', ') + '.';
            } else {
                summaryWarn.hidden = true;
            }

            // Stepper state
            const steps = document.querySelectorAll('#stepper .step');
            steps.forEach(s => s.classList.remove('is-current', 'is-done'));
            if (hasWhen) { steps[0].classList.add('is-done'); }
            if (type) { steps[1].classList.add('is-done'); }

            const current = !hasWhen ? 0 : !type ? 1 : 2;
            steps[current].classList.add('is-current');
        }

        document.querySelectorAll('input[name="AppointmentType"]').forEach(r => {
            r.addEventListener('change', updateSummary);
        });

        if (notes) {
            const syncCount = () => { charCount.textContent = `${notes.value.length} / 320`; };
            notes.addEventListener('input', syncCount);
            syncCount();
        }

        buildDayStrip();
        buildSlots();
        updateSummary();
    </script>
}
