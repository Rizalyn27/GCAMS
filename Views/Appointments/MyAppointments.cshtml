@model List<GCAMS.Models.Appointment.Appointments>
@{
    ViewData["Title"] = "My Appointments";
}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700;0,1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/Appointments/MyAppointments.css" asp-append-version="true" />

<div class="container-lg py-4" style="max-width: 720px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
        <h2 style="margin:0;">My Appointments</h2>
        <a asp-controller="Appointments" asp-action="Create" asp-route-force="true" class="btn-book">
            Book Appointment
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <p>You don't have any appointments yet.</p>
            <a asp-controller="Appointments" asp-action="Create" class="btn-book">Book your first appointment</a>
        </div>
    }
    else
    {
        foreach (var appt in Model)
        {
            var statusClass = "status-" + appt.Status.ToLower();
            <div class="appt-card">
                <div class="appt-info">
                    <div class="appt-date">@appt.AppointmentDate.ToString("MMM d, yyyy - h:mm tt")</div>
                    <div class="appt-type">@appt.AppointmentType</div>
                </div>
                <div style="display:flex; align-items:center; gap:12px;">
                    <span class="status-badge @statusClass">@appt.Status</span>
                    <a asp-controller="Appointments" asp-action="Details" asp-route-appointmentid="@appt.AppointmentID">
                        View
                    </a>
                    @if (appt.Status == "Pending")
                    {
                        <a asp-controller="Appointments" asp-action="Edit" asp-route-appointmentid="@appt.AppointmentID">
                            Edit
                        </a>
                    }
                    <a asp-controller="Appointments" asp-action="Delete" asp-route-appointmentid="@appt.AppointmentID"
                       style="color:#991b1b;">
                        Cancel
                    </a>
                </div>
            </div>
        }
    }
</div>