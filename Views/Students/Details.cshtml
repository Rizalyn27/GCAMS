                        @(string.IsNullOrEmpty(Model.Emergency.EmergencyContactOccupation) ? "Not specified" : Model.Emergency.EmergencyContactOccupation)
                    </div>
                </div>
                <div class="full-width">
                    <div class="field-label">Address</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Emergency.EmergencyContactAddress) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Emergency.EmergencyContactAddress) ? "Not specified" : Model.Emergency.EmergencyContactAddress)
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- TAB: CASE NOTES -->
    <div id="tab-casenotes" class="tab-panel">

        <div class="section-card">
            <div class="section-header">
                <span class="material-symbols-outlined"></span>
                Case Notes
                <a asp-controller="CaseNotes" asp-action="Create" asp-route-fullName="@Model.Student.StuName" asp-route-studentId="@Model.Student.StudentsID"
                   class="action-btn btn-primary-green" style="margin-left:auto; padding:6px 14px; font-size:13px;">
                    <span class="material-symbols-outlined" style="font-size:16px;"></span>Add New Case Note
                </a>
            </div>
            <div class="section-body cols-1">
                @if (Model.CaseNotes == null || !Model.CaseNotes.Any())
                {
                    <div class="empty-state">
                        <span class="material-symbols-outlined"></span>
                        No case notes have been recorded yet.
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="cn-table">
                            <thead>
                                <tr>
                                    <th>Session Date</th>
                                    <th>Specific Goal</th>
                                    <th>Intervention</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var note in Model.CaseNotes.OrderByDescending(n => n.SessionDate))
                                {
                                    <tr>
                                        <td><span class="cn-date">@note.SessionDate.ToString("MMM dd, yyyy - h:mm tt")</span></td>
                                        <td><span class="cn-text" title="@note.SpecificGoal">@note.SpecificGoal</span></td>
                                        <td><span class="cn-text" title="@note.Interventions">@note.Interventions</span></td>
                                        <td>
                                            <div class="cn-actions">
                                                <a asp-controller="CaseNotes" asp-action="Details" asp-route-id="@note.CasenoteId" asp-route-studentId="@Model.Student.StudentsID"
                                                   class="cn-action-icon" title="View Details">
                                                    <span class="material-symbols-outlined" style="font-size:18px;">👁</span>
                                                </a>
                                                <a asp-controller="CaseNotes" asp-action="Edit" asp-route-id="@note.CasenoteId" asp-route-studentId="@Model.Student.StudentsID"
                                                   class="cn-action-icon" title="Edit">
                                                    <span class="material-symbols-outlined" style="font-size:18px;">✏️</span>
                                                </a>

                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- TAB: ANECDOTAL RECORDS -->
    <div id="tab-health" class="tab-panel">

        <div class="section-card">
            <div class="section-header">
                <span class="material-symbols-outlined"></span>
                Case Notes
                <a asp-controller="AnecRecs" asp-action="Create" asp-route-fullName="@Model.Student.StuName" asp-route-studentId="@Model.Student.StudentsID"
                   class="action-btn btn-primary-green" style="margin-left:auto; padding:6px 14px; font-size:13px;">
                    <span class="material-symbols-outlined" style="font-size:16px;"></span>Add New Anecdotal Record
                </a>
            </div>
            <div class="section-body cols-1">
                @if (Model.AnecRecs == null || !Model.AnecRecs.Any())
                {
                    <div class="empty-state">
                        <span class="material-symbols-outlined"></span>
                        No Anecdotal Records have been recorded yet.
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="cn-table">
                            <thead>
                                <tr>
                                    <th>Observer/Evaluator</th>
                                    <th>Date of Observation</th>
                                    <th>Time of Observation</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var note in Model.AnecRecs.OrderByDescending(n => n.AnecRecNo))
                                {
                                    <tr>
                                        <td><span class="cn-text" title="@note.ObservedBy">@note.ObservedBy</span></td>
                                        <td><span class="cn-date">@note.DateOfObserv.ToString("MMM dd, yyyy")</span></td>
                                        <td><span class="cn-date">@note.DateOfObserv.ToString("h:mm tt")</span></td>
                                        <td>
                                            <div class="cn-actions">
                                                <a asp-controller="AnecRecs" asp-action="Details" asp-route-id="@note.AnecRecsId" asp-route-studentId="@Model.Student.StudentsID"
                                                   class="cn-action-icon" title="View Details">
                                                    <span class="material-symbols-outlined" style="font-size:18px;">👁</span>
                                                </a>
                                                <a asp-controller="AnecRecs" asp-action="Edit" asp-route-id="@note.AnecRecsId" asp-route-studentId="@Model.Student.StudentsID"
                                                   class="cn-action-icon" title="Edit">
                                                    <span class="material-symbols-outlined" style="font-size:18px;">✏️</span>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>


    </div>

</div>

<script>
    function switchTab(name, btn) {
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('tab-' + name).classList.add('active');
        btn.classList.add('active');
    }

        function openDeleteModal(btn) {
        document.getElementById('deleteNoteId').value = btn.dataset.id;

        document.getElementById('dn-date').textContent = btn.dataset.date || '—';
        document.getElementById('dn-sessionno').textContent = btn.dataset.sessionno || '—';
        document.getElementById('dn-goal').textContent = btn.dataset.goal || '—';
        document.getElementById('dn-topics').textContent = btn.dataset.topics || '—';
        document.getElementById('dn-interventions').textContent = btn.dataset.interventions || '—';
        document.getElementById('dn-observations').textContent = btn.dataset.observations || '—';
        document.getElementById('dn-progress').textContent = btn.dataset.progress || '—';
        document.getElementById('dn-behavior').textContent = btn.dataset.behavior || '—';
        document.getElementById('dn-homework').textContent = btn.dataset.homework || '—';
        document.getElementById('dn-strengths').textContent = btn.dataset.strengths || '—';

        document.getElementById('deleteNoteModal').classList.add('open');
    }

    function closeDeleteModal() {
        document.getElementById('deleteNoteModal').classList.remove('open');
    }

    // Close on backdrop click
    document.getElementById('deleteNoteModal').addEventListener('click', function (e) {
        if (e.target === this) closeDeleteModal();
    });

    // Close on Escape
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDeleteModal();
    });
</script>
