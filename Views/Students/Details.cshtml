                    </div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <span class="material-symbols-outlined"></span>
                Emergency Contact
            </div>
            <div class="section-body cols-3">
                <div>
                    <div class="field-label">Contact Person</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Emergency.EmergencyContactPerson) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Emergency.EmergencyContactPerson) ? "Not specified" : Model.Emergency.EmergencyContactPerson)
                    </div>
                </div>
                <div>
                    <div class="field-label">Age</div>
                    <div class="field-value @(Model.Emergency.EmergencyContactAge == null ? "empty" : "")">
                        @(Model.Emergency.EmergencyContactAge.HasValue? Model.Emergency.EmergencyContactAge.ToString() : "Not specified")
                    </div>
