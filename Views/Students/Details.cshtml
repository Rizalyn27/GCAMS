    </div>

    <!-- TAB: FAMILY -->
    <div id="tab-family" class="tab-panel">

        <div class="section-card">
            <div class="section-header">
                <span class="material-symbols-outlined"></span>
                Father's Information
            </div>
            <div class="section-body cols-3">
                <div>
                    <div class="field-label">Father's Name</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Family.FatherName) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Family.FatherName) ? "Not specified" : Model.Family.FatherName)
                    </div>
                </div>
                <div>
                    <div class="field-label">Age</div>
                    <div class="field-value @(Model.Family.FatherAge == null ? "empty" : "")">
                        @(Model.Family.FatherAge.HasValue? Model.Family.FatherAge.ToString() : "Not specified")
                    </div>
                </div>
                <div>
                    <div class="field-label">Contact Numbers</div>
                    @if (!Model.FatherContacts.Any())
                    {
                        <div class="field-value empty">Not specified</div>
                    }
                    else
