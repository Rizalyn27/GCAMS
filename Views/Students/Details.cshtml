<script>
    function switchTab(name, btn) {
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('tab-' + name).classList.add('active');
        btn.classList.add('active');
    }

        function openDeleteModal(btn) {
        document.getElementById('deleteNoteId').value = btn.dataset.id;

        document.getElementById('dn-date').textContent = btn.dataset.date || '—';
        document.getElementById('dn-sessionno').textContent = btn.dataset.sessionno || '—';
        document.getElementById('dn-goal').textContent = btn.dataset.goal || '—';
        document.getElementById('dn-topics').textContent = btn.dataset.topics || '—';
        document.getElementById('dn-interventions').textContent = btn.dataset.interventions || '—';
        document.getElementById('dn-observations').textContent = btn.dataset.observations || '—';
        document.getElementById('dn-progress').textContent = btn.dataset.progress || '—';
        document.getElementById('dn-behavior').textContent = btn.dataset.behavior || '—';
        document.getElementById('dn-homework').textContent = btn.dataset.homework || '—';
        document.getElementById('dn-strengths').textContent = btn.dataset.strengths || '—';

        document.getElementById('deleteNoteModal').classList.add('open');
    }

    function closeDeleteModal() {
        document.getElementById('deleteNoteModal').classList.remove('open');
    }

    // Close on backdrop click
    document.getElementById('deleteNoteModal').addEventListener('click', function (e) {
        if (e.target === this) closeDeleteModal();
    });

    // Close on Escape
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDeleteModal();
    });
</script>
