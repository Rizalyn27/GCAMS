        <div class="section-card">
            <div class="section-header">
                <span class="material-symbols-outlined"></span>
                Personal Information
            </div>
            <div class="section-body cols-3">
                <div>
                    <div class="field-label">Full Name</div>
                    <div class="field-value">@Model.Student.StuName</div>
                </div>
                <div>
                    <div class="field-label">Student ID</div>
                    <div class="field-value" style="font-family:monospace;">@Model.Student.StuID</div>
                </div>
                <div>
                    <div class="field-label">Gender</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Student.Gender) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Student.Gender) ? "Not specified" : Model.Student.Gender)
                    </div>
                </div>
                <div>
                    <div class="field-label">Date of Birth</div>
                    <div class="field-value @(Model.Student.Birthday == null ? "empty" : "")">
                        @(Model.Student.Birthday.HasValue? Model.Student.Birthday.Value.ToString("MMMM dd, yyyy") : "Not specified")
                    </div>
                </div>
                <div>
                    <div class="field-label">Age</div>
                    <div class="field-value">@Model.Student.Age years old</div>
                </div>
                <div>
                    <div class="field-label">Birth Order</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Student.BirthOrder) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Student.BirthOrder) ? "Not specified" : Model.Student.BirthOrder)
                    </div>
                </div>
                <div>
                    <div class="field-label">Nationality</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Student.Nationality) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Student.Nationality) ? "Not specified" : Model.Student.Nationality)
                    </div>
                </div>
                <div>
                    <div class="field-label">Religion</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Student.Religion) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Student.Religion) ? "Not specified" : Model.Student.Religion)
                    </div>
                </div>
                <div>
                    <div class="field-label">Living Arrangement</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Student.StayingWith) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Student.StayingWith) ? "Not specified" : Model.Student.StayingWith)
                    </div>
                </div>
                <div class="full-width">
                    <div class="field-label">Residential Address</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Student.Address) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Student.Address) ? "Not specified" : Model.Student.Address)
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <span class="material-symbols-outlined"></span>
                Contact Information
            </div>
            <div class="section-body">
                <div>
                    <div class="field-label">Contact Numbers</div>
                    @if (!Model.StudentContacts.Any())
                    {
                        <div class="field-value empty">Not specified</div>
                    }
                    else
                    {
                        @foreach (var c in Model.StudentContacts)
                        {
                            <div class="field-value" style="font-family:monospace;">
                                @c.Number @(!string.IsNullOrEmpty(c.Label) ? $"({c.Label})" : "")
                            </div>
                        }
                    }
                </div>
                <div>
                    <div class="field-label">Email Address</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Student.Email) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Student.Email) ? "Not specified" : Model.Student.Email)
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <span class="material-symbols-outlined"></span>
                Educational Background
            </div>
            <div class="section-body cols-3">
                <div>
                    <div class="field-label">School</div>
                    <div class="field-value">@Model.Student.School</div>
                </div>
                <div>
                    <div class="field-label">Grade Level</div>
                    <div class="field-value">@Model.Student.GradeLevel</div>
                </div>
                <div>
                    <div class="field-label">Section</div>
                    <div class="field-value">@Model.Student.Section</div>
                </div>
                <div>
                    <div class="field-label">Academic Year</div>
                    <div class="field-value">@Model.Student.AcademicYear</div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <span class="material-symbols-outlined"></span>
                Elementary
            </div>
            <div class="section-body cols-3">
                <div class="full-width">
                    <div class="field-label">School Name</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Education.ElementarySchool) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Education.ElementarySchool) ? "Not specified" : Model.Education.ElementarySchool)
                    </div>
                </div>
                <div>
                    <div class="field-label">Year Graduated</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Education.ElementaryYear) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Education.ElementaryYear) ? "Not specified" : Model.Education.ElementaryYear)
                    </div>
                </div>
                <div class="full-width">
                    <div class="field-label">Honors / Awards</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Education.ElementaryHonors) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Education.ElementaryHonors) ? "None" : Model.Education.ElementaryHonors)
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <span class="material-symbols-outlined"></span>
                Secondary / Junior High
            </div>
            <div class="section-body cols-3">
                <div class="full-width">
                    <div class="field-label">School Name</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Education.SecondarySchool) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Education.SecondarySchool) ? "Not specified" : Model.Education.SecondarySchool)
                    </div>
                </div>
                <div>
                    <div class="field-label">Year Graduated</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Education.SecondaryYear) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Education.SecondaryYear) ? "Not specified" : Model.Education.SecondaryYear)
                    </div>
                </div>
                <div class="full-width">
                    <div class="field-label">Honors / Awards</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Education.SecondaryHonors) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Education.SecondaryHonors) ? "None" : Model.Education.SecondaryHonors)
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <span class="material-symbols-outlined"></span>
                Physical Health
            </div>
            <div class="section-body cols-3">
                <div>
                    <div class="field-label">Height</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Health.Height) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Health.Height) ? "Not specified" : Model.Health.Height)
                    </div>
                </div>
                <div>
                    <div class="field-label">Weight</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Health.Weight) ? "empty" : "")">
