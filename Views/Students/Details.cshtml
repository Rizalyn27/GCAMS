@model GCAMS.ViewModels.StudentFormViewModel

@{
    Layout = "_Layout";
}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/Students/Details.css" asp-append-version="true" />

<!-- Top Navbar: back chevron + breadcrumb (left) / notifications + profile (right) -->
<div class="top-navbar">
    <div class="top-navbar-left">
        <a asp-action="Index" class="back-chevron" title="Back to Students">
            <span class="material-symbols-outlined">chevron_left</span>
        </a>
        <nav class="breadcrumb-nav">
            <a asp-action="Index">Students</a>
            <span class="material-symbols-outlined breadcrumb-sep">chevron_right</span>
            <span class="current">Student Profile</span>
        </nav>
    </div>

    <div class="top-navbar-right">
        <button type="button" class="notif-btn" title="Notifications">
            <span class="material-symbols-outlined">notifications</span>
            <span class="notif-dot"></span>
        </button>

        <div class="navbar-divider"></div>

        <!-- TODO: replace with actual logged-in counselor session data -->
        <div class="profile-chip">
            <div class="navbar-avatar">IF</div>
            <div class="profile-info">
                <div class="profile-name">Ms. Imee Flores</div>
                <div class="profile-role">Head Counselor</div>
            </div>
        </div>
    </div>
</div>

<div class="profile-page" style="max-width: 1100px; margin: 0 auto; padding: 24px 16px;">

    <!-- Profile Header Card -->
    <div class="profile-header-card">
        <div class="profile-top-row" style="display:flex; justify-content:space-between; align-items:flex-start; gap:20px; flex-wrap:wrap;">

            <div style="display:flex; align-items:center; gap:20px;">
                <div class="avatar-circle">
                    @(string.IsNullOrEmpty(Model.Student.StuName) ? "?" : Model.Student.StuName.Substring(0, 1).ToUpper())
                </div>
                <div>
                    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:6px;">
                        <h2 style="font-family:'Manrope',sans-serif; font-size:24px; font-weight:700; color:#002c06; margin:0;">
                            @Model.Student.StuName
                        </h2>
                        <span class="status-badge @(Model.Student.IsActive ? "status-active" : "status-inactive")">
                            <span class="material-symbols-outlined" style="font-size:13px; font-variation-settings:'FILL' 1;">
                                @(Model.Student.IsActive ? "" : "cancel")
                            </span>
                            @(Model.Student.IsActive ? "Active" : "Inactive")
                        </span>
                        @if (!string.IsNullOrEmpty(Model.Student.GradeLevel))
                        {
                            <span class="info-pill">@Model.Student.GradeLevel</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Student.Section))
                        {
                            <span class="info-pill">Section @Model.Student.Section</span>
                        }
                    </div>
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                        <span class="info-pill id-pill">
                            <span class="material-symbols-outlined" style="font-size:13px;"></span>
                            @Model.Student.StuID
                        </span>
                        @if (!string.IsNullOrEmpty(Model.Student.School))
                        {
                            <span style="color:#c0c9bb;">•</span>
                            <span style="font-size:13px; color:#717a6d;">@Model.Student.School</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Student.Gender))
                        {
                            <span style="color:#c0c9bb;">•</span>
                            <span style="font-size:13px; color:#717a6d;">@Model.Student.Gender</span>
                        }
                    </div>
                </div>
            </div>

            <div class="action-buttons" style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                <a asp-action="Edit" asp-route-id="@Model.Student.StudentsID" class="action-btn btn-outline">
                    <span class="material-symbols-outlined" style="font-size:18px;"></span>
                    Edit Record
                </a>
                @if (Model.Student.IsActive)
                {
                    <form asp-action="SoftDelete" asp-route-id="@Model.Student.StudentsID" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="action-btn btn-danger" style="width:100%;">Archive</button>
                    </form>
                }
                else
                {
                    <form asp-action="Restore" asp-route-id="@Model.Student.StudentsID" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="action-btn btn-primary-green" style="width:100%;">Restore</button>
                    </form>
                }
            </div>
        </div>

        <!-- Tabs -->
        <div class="tabs-bar">
            <button class="tab-btn active" onclick="switchTab('personal', this)">
                <span class="material-symbols-outlined" style="font-size:15px; vertical-align:middle; margin-right:4px;"></span>
                Personal Details
            </button>
            <button class="tab-btn" onclick="switchTab('family', this)">
                <span class="material-symbols-outlined" style="font-size:15px; vertical-align:middle; margin-right:4px;"></span>
                Family Background
            </button>
            <button class="tab-btn" onclick="switchTab('casenotes', this)">
                <span class="material-symbols-outlined" style="font-size:15px; vertical-align:middle; margin-right:4px;"></span>
                Case Notes
            </button>
            <button class="tab-btn" onclick="switchTab('health', this)">
                <span class="material-symbols-outlined" style="font-size:15px; vertical-align:middle; margin-right:4px;"></span>
                Anecdotal Records
            </button>
        </div>
    </div>

    <!-- TAB: PERSONAL -->
