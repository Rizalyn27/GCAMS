                    <div class="field-value @(string.IsNullOrEmpty(Model.Health.AdditionalNotes) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Health.AdditionalNotes) ? "None" : Model.Health.AdditionalNotes)
