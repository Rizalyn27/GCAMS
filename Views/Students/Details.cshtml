                        @foreach (var c in Model.FatherContacts)
                        {
                            <div class="field-value" style="font-family:monospace;">
                                @c.Number @(!string.IsNullOrEmpty(c.Label) ? $"({c.Label})" : "")
                            </div>
                        }
                    }
                </div>
                <div>
                    <div class="field-label">Occupation</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Family.FatherOccupation) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Family.FatherOccupation) ? "Not specified" : Model.Family.FatherOccupation)
                    </div>
                </div>
                <div>
                    <div class="field-label">Educational Attainment</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Family.FatherEducationalAttainment) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Family.FatherEducationalAttainment) ? "Not specified" : Model.Family.FatherEducationalAttainment)
                    </div>
