                    <div class="field-value @(string.IsNullOrEmpty(Model.Health.BloodType) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Health.BloodType) ? "Not specified" : Model.Health.BloodType)
                    </div>
                </div>
                <div class="full-width">
                    <div class="field-label">History of Medical Conditions or Physical Disabilities</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Health.Ailments) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Health.Ailments) ? "None reported" : Model.Health.Ailments)
                    </div>
                </div>
                <div class="full-width">
                    <div class="field-label">Current Medications</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Health.Medication) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Health.Medication) ? "None reported" : Model.Health.Medication)
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <span class="material-symbols-outlined" style="color:#93000a;"></span>
                Mental Health &amp; Sensitive Information
                <span style="margin-left:auto; font-size:11px; font-weight:700; background:#ffdad6; color:#93000a; padding:2px 8px; border-radius:4px;">Confidential</span>
            </div>
            <div class="section-body cols-1">
                <div>
                    <div class="field-label">History of Suicidal Thoughts or Attempts</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Health.SuicideRiskHistory) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Health.SuicideRiskHistory) ? "None reported" : Model.Health.SuicideRiskHistory)
                    </div>
                </div>
                <div>
                    <div class="field-label">History of Abuse or Maltreatment</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Health.AbuseHistory) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Health.AbuseHistory) ? "None reported" : Model.Health.AbuseHistory)
                    </div>
                </div>
                <div>
                    <div class="field-label">History of Illegal Drug Use</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Health.DrugHistory) ? "empty" : "")">
                        @(string.IsNullOrEmpty(Model.Health.DrugHistory) ? "None reported" : Model.Health.DrugHistory)
                    </div>
                </div>
                <div>
                    <div class="field-label">Family History of Mental or Developmental Conditions</div>
                    <div class="field-value @(string.IsNullOrEmpty(Model.Health.FamilyMentalHealthHistory) ? "empty" : "")">
