@model IEnumerable<GCAMS.Models.Students.Students>

@{
    ViewData["Title"] = "Students";
    ViewData["PageSubtitle"] = $"{Model.Count()} registered students";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Students/Index.css" asp-append-version="true" />
}

@section Breadcrumb {
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a asp-action="Index">Students</a>
        <span class="crumb-sep">/</span>
        <span class="current">Student Management</span>
    </nav>
}

<div class="student-page">

    <!-- Header actions -->
    <div class="page-header">
        <div class="header-actions">
            <button type="button" class="btn-import" data-bs-toggle="modal" data-bs-target="#importModal">
                <span class="material-symbols-outlined">upload_file</span>
                Import Excel
            </button>
            <a asp-action="Create" class="btn-add">
                <span class="material-symbols-outlined">person_add</span>
                Add New Student
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            <span class="material-symbols-outlined">check_circle</span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-danger">
            <span class="material-symbols-outlined">error</span>
            @TempData["Error"]
        </div>
    }

    <!-- Filter Bar -->
    <div class="filter-bar">
        <div class="search-box">
            <span class="material-symbols-outlined">search</span>
            <input type="text" id="studentSearch" placeholder="Search students by name or ID" />
        </div>

        <select id="gradeFilter" class="filter-select" aria-label="Filter by grade level">
            <option value="">All Grades</option>
            @foreach (var gradeLevel in Model.Select(s => s.GradeLevel).Distinct().OrderBy(s => s))
            {
                <option value="@gradeLevel?.ToLower()">@gradeLevel</option>
            }
        </select>

        <select id="sectionFilter" class="filter-select" aria-label="Filter by section">
            <option value="">All Sections</option>
            @foreach (var sec in Model.Select(s => s.Section).Distinct().OrderBy(s => s))
            {
                <option value="@sec?.ToLower()">@sec</option>
            }
        </select>

        <select id="statusFilter" class="filter-select filter-extra" aria-label="Filter by status">
            <option value="">All Status</option>
            <option value="true">Active</option>
            <option value="false">Inactive</option>
        </select>

        <button type="button" class="filter-toggle" id="filterToggle" aria-expanded="false" aria-label="More filters">
            <span class="material-symbols-outlined">tune</span>
        </button>
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-scroll">
            <table class="student-table" id="studentTable">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Grade</th>
                        <th>Section</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-active="@item.IsActive.ToString().ToLower()">
                            <td data-label="Student ID"><span class="student-id">@item.StuID</span></td>
                            <td data-label="Full Name"><span class="student-name">@item.StuName</span></td>
                            <td data-label="Email"><span class="student-email">@item.Email</span></td>
                            <td data-label="Grade"><span class="grade-pill">@item.GradeLevel</span></td>
                            <td data-label="Section">@item.Section</td>
                            <td data-label="Actions">
                                <div class="action-icons">
                                    <a asp-action="Details" asp-route-id="@item.StudentsID" class="action-icon" title="View Details">
                                        <span class="material-symbols-outlined">visibility</span>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.StudentsID" class="action-icon" title="Edit">
                                        <span class="material-symbols-outlined">edit</span>
                                    </a>
                                    @if (item.IsActive)
                                    {
                                        <form asp-action="SoftDelete" asp-route-id="@item.StudentsID" method="post" class="archive-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-icon danger" title="Archive Student">
                                                <span class="material-symbols-outlined">archive</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Restore" asp-route-id="@item.StudentsID" method="post" class="archive-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-icon restore" title="Restore Student">
                                                <span class="material-symbols-outlined">restore</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Table Footer -->
        <div class="table-footer">
            <span class="showing-text" id="showingText"></span>
            <div class="pagination" id="pagination"></div>
        </div>
    </div>

</div>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importModalLabel">Import Students from Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Import" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Excel File (.xlsx)</label>
                        <input type="file" name="file" accept=".xlsx" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <input type="submit" value="Upload & Import" class="btn btn-success" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const pageSize = 10;
            let currentPage = 1;
            let visibleRows = [];

            const rows = Array.from(document.querySelectorAll('#studentTable tbody tr'));

            function applyFilters() {
                const query = document.getElementById('studentSearch').value.toLowerCase().trim();
                const grade = document.getElementById('gradeFilter').value.toLowerCase();
                const selectedSection = document.getElementById('sectionFilter').value.toLowerCase();
                const status = document.getElementById('statusFilter').value;

                visibleRows = rows.filter(function (row) {
                    const stuId = row.cells[0]?.textContent.trim().toLowerCase() || '';
                    const name = row.cells[1]?.textContent.trim().toLowerCase() || '';
                    const rowGrade = row.cells[3]?.textContent.trim().toLowerCase() || '';
                    const rowSec = row.cells[4]?.textContent.trim().toLowerCase() || '';
                    const rowActive = (row.getAttribute('data-active') || '').trim();

                    return (!query || name.includes(query) || stuId.includes(query))
                        && (!grade || rowGrade === grade)
                        && (!selectedSection || rowSec === selectedSection)
                        && (!status || rowActive === status);
                });

                currentPage = 1;
                renderPage();
            }

            function renderPage() {
                const start = (currentPage - 1) * pageSize;
                const end = start + pageSize;

                rows.forEach(r => r.style.display = 'none');
                visibleRows.slice(start, end).forEach(r => r.style.display = '');

                const total = visibleRows.length;
                const showing = Math.min(end, total);
                document.getElementById('showingText').textContent =
                    total === 0 ? 'No students found' :
                        `Showing ${start + 1} - ${showing} of ${total} student${total !== 1 ? 's' : ''}`;

                renderPagination(total);
            }

            function renderPagination(total) {
                const totalPages = Math.ceil(total / pageSize);
                const pg = document.getElementById('pagination');
                pg.innerHTML = '';

                function btn(label, page, isActive, isDisabled, isArrow) {
                    const b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'page-btn' + (isActive ? ' active' : '') + (isArrow ? ' arrow' : '');
                    b.innerHTML = label;
                    b.disabled = isDisabled;
                    if (!isDisabled && !isActive) {
                        b.onclick = () => { currentPage = page; renderPage(); };
                    }
                    return b;
                }

                const prevIcon = '<span class="material-symbols-outlined">chevron_left</span>';
                const nextIcon = '<span class="material-symbols-outlined">chevron_right</span>';

                pg.appendChild(btn(prevIcon, currentPage - 1, false, currentPage === 1, true));

                const pages = [];
                if (totalPages <= 7) {
                    for (let i = 1; i <= totalPages; i++) pages.push(i);
                } else {
                    pages.push(1);
                    if (currentPage > 3) pages.push('...');
                    for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) pages.push(i);
                    if (currentPage < totalPages - 2) pages.push('...');
                    pages.push(totalPages);
                }

                pages.forEach(p => {
                    if (p === '...') {
                        const s = document.createElement('span');
                        s.className = 'page-gap';
                        s.textContent = '...';
                        pg.appendChild(s);
                    } else {
                        pg.appendChild(btn(p, p, p === currentPage, false, false));
                    }
                });

                pg.appendChild(btn(nextIcon, currentPage + 1, false, currentPage === totalPages || totalPages === 0, true));
            }

            // Status sits behind the filter button, like the design
            const filterBar = document.querySelector('.filter-bar');
            const filterToggle = document.getElementById('filterToggle');
            const statusSelect = document.getElementById('statusFilter');

            filterToggle.addEventListener('click', function () {
                const open = filterBar.classList.toggle('show-extra');
                this.setAttribute('aria-expanded', open ? 'true' : 'false');
                if (open) { statusSelect.focus(); }
            });

            function paintFilterState() {
                filterToggle.classList.toggle('has-filter', statusSelect.value !== '');
            }

            document.getElementById('studentSearch').addEventListener('input', applyFilters);
            document.getElementById('gradeFilter').addEventListener('change', applyFilters);
            document.getElementById('sectionFilter').addEventListener('change', applyFilters);
            document.getElementById('statusFilter').addEventListener('change', function () {
                paintFilterState();
                applyFilters();
            });

            paintFilterState();
            applyFilters();
        })();
    </script>
}
