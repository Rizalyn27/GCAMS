@model IEnumerable<GCAMS.Models.Students.Students>

@{
    ViewData["Title"] = "";
    var pagedList = Model.ToList();
    int pageSize = 10;
    int totalStudents = pagedList.Count;
}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/SIndex.css" />

<div class="student-page" style="max-width: 1100px; margin: 0 auto; padding: 24px 16px;">

    <!-- Header -->
    <div class="page-header">
        <button type="button" class="btn-import" data-bs-toggle="modal" data-bs-target="#importModal">
            <span class="material-symbols-outlined" style="font-size:18px;">upload_file</span>
            Import Excel
        </button>
        <a asp-action="Create" class="btn-add">
            <span class="material-symbols-outlined" style="font-size:18px;">person_add</span>
            Add New Student
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            <span class="material-symbols-outlined" style="font-size:16px; vertical-align:middle; margin-right:6px;">check_circle</span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-danger">
            <span class="material-symbols-outlined" style="font-size:16px; vertical-align:middle; margin-right:6px;">error</span>
            @TempData["Error"]
        </div>
    }

    <!-- Filter Bar -->
    <div class="filter-bar">
        <div class="search-box">
            <span class="material-symbols-outlined">search</span>
            <input type="text" id="studentSearch" placeholder="Search students by name or ID" />
        </div>

        <!--Grade Level Filter-->
        <select id="gradeFilter" class="filter-select">
            <option value="">All Grades</option>

            @foreach (var gradeLevel in Model.Select(s => s.GradeLevel).Distinct().OrderBy(s => s))
            {
                <option value="@gradeLevel?.ToLower()">@gradeLevel</option>
            }
        </select>

        <!--Section Filter-->
        <select id="sectionFilter" class="filter-select">
            <option value="">All Sections</option>
            @foreach (var sec in Model.Select(s => s.Section).Distinct().OrderBy(s => s))
            {
                <option value="@sec?.ToLower()">@sec</option>
            }
        </select>

        <!--Status Filter-->
        <select id="statusFilter" class="filter-select">
            <option value="">All Status</option>
            <option value="true">Active</option>
            <option value="false">Inactive</option>
        </select>

    </div>

    <!-- Table -->
    <table class="student-table" id="studentTable">
        <thead>
            <tr>
                <th>Student ID</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Grade</th>
                <th>Section</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-active="@item.IsActive.ToString().ToLower()">
                    <td><span class="student-id">@item.StuID</span></td>
                    <td><span class="student-name">@item.StuName</span></td>
                    <td><span class="student-email">@item.Email</span></td>
                    <td><span class="grade-pill">@item.GradeLevel</span></td>
                    <td>@item.Section</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Details" asp-route-id="@item.StudentsID" class="action-icon" title="View Details">
                                <span class="material-symbols-outlined">visibility</span>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.StudentsID" class="action-icon" title="Edit">
                                <span class="material-symbols-outlined">edit</span>
                            </a>
                            @if (item.IsActive)
                            {
                                <form asp-action="SoftDelete" asp-route-id="@item.StudentsID" method="post" class="archive-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="action-icon danger" title="Archive Student">
                                        <span class="material-symbols-outlined" style="font-size:18px;">archive</span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Restore" asp-route-id="@item.StudentsID" method="post" class="archive-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="action-icon" title="Restore Student" style="color:#1b6d24;">
                                        <span class="material-symbols-outlined" style="font-size:18px;">restore</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Table Footer -->
    <div class="table-footer">
        <span class="showing-text" id="showingText"></span>
        <div class="pagination" id="pagination"></div>
    </div>

</div>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importModalLabel">Import Students from Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Import" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Excel File (.xlsx)</label>
                        <input type="file" name="file" accept=".xlsx" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <input type="submit" value="Upload & Import" class="btn btn-success" />
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const pageSize = 10;
    let currentPage = 1;
    let visibleRows = [];
        function applyFilters() {
        const query           = document.getElementById('studentSearch').value.toLowerCase().trim();
        const grade           = document.getElementById('gradeFilter').value.toLowerCase();
        const selectedSection = document.getElementById('sectionFilter').value.toLowerCase();
        const status          = document.getElementById('statusFilter').value;

        visibleRows = [];

        document.querySelectorAll('#studentTable tbody tr').forEach(function (row) {
            const stuId     = row.cells[0]?.textContent.trim().toLowerCase() || '';
            const name      = row.cells[1]?.textContent.trim().toLowerCase() || '';
            const rowGrade  = row.cells[3]?.textContent.trim().toLowerCase() || '';
            const rowSec    = row.cells[4]?.textContent.trim().toLowerCase() || '';
            const rowActive = (row.getAttribute('data-active') || '').trim();

            const matchesSearch  = !query           || name.includes(query) || stuId.includes(query);
            const matchesGrade   = !grade           || rowGrade === grade;
            const matchesSection = !selectedSection || rowSec === selectedSection;
            const matchesStatus  = !status          || rowActive === status;

            if (matchesSearch && matchesGrade && matchesSection && matchesStatus) {
                visibleRows.push(row);
            }
            row.style.display = 'none';
        });

        currentPage = 1;
        renderPage();
    }

    function renderPage() {
        const start = (currentPage - 1) * pageSize;
        const end   = start + pageSize;

        document.querySelectorAll('#studentTable tbody tr').forEach(r => r.style.display = 'none');
        visibleRows.slice(start, end).forEach(r => r.style.display = '');

        const total = visibleRows.length;
        const showing = Math.min(end, total);
        document.getElementById('showingText').textContent =
            total === 0 ? 'No students found' :
            `Showing ${start + 1} - ${showing} of ${total} student${total !== 1 ? 's' : ''}`;

        renderPagination(total);
    }

    function renderPagination(total) {
        const totalPages = Math.ceil(total / pageSize);
        const pg = document.getElementById('pagination');
        pg.innerHTML = '';

        function btn(label, page, isActive, isDisabled, isArrow) {
            const b = document.createElement('button');
            b.className = 'page-btn' + (isActive ? ' active' : '') + (isArrow ? ' arrow' : '');
            b.innerHTML = label;
            b.disabled = isDisabled;
            if (!isDisabled && !isActive) {
                b.onclick = () => { currentPage = page; renderPage(); };
            }
            return b;
        }

        pg.appendChild(btn('<span class="material-symbols-outlined" style="font-size:16px;"><</span>', currentPage - 1, false, currentPage === 1, true));

        const pages = [];
        if (totalPages <= 7) {
            for (let i = 1; i <= totalPages; i++) pages.push(i);
        } else {
            pages.push(1);
            if (currentPage > 3) pages.push('...');
            for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) pages.push(i);
            if (currentPage < totalPages - 2) pages.push('...');
            pages.push(totalPages);
        }

        pages.forEach(p => {
            if (p === '...') {
                const s = document.createElement('span');
                s.textContent = '...';
                s.style.cssText = 'padding:0 4px; color:#717a6d; font-size:13px;';
                pg.appendChild(s);
            } else {
                pg.appendChild(btn(p, p, p === currentPage, false, false));
            }
        });

        pg.appendChild(btn('<span class="material-symbols-outlined" style="font-size:16px;">></span>', currentPage + 1, false, currentPage === totalPages || totalPages === 0, true));
    }

    document.getElementById('studentSearch').addEventListener('input', applyFilters);
    document.getElementById('gradeFilter').addEventListener('change', applyFilters);
    document.getElementById('sectionFilter').addEventListener('change', applyFilters);
    document.getElementById('statusFilter').addEventListener('change', applyFilters);

    applyFilters();
</script>
