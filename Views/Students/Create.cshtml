@model GCAMS.ViewModels.StudentFormViewModel

@{
    ViewData["Title"] = "Add New Student";

    // Date-picker bounds. A student must be between 10 and 25 years old, so the
    // browser greys out everything outside that window -- no more 2016 birthdays.
    var minBirthday = DateTime.Today.AddYears(-GCAMS.Models.Students.StudentRules.MaxAge).ToString("yyyy-MM-dd");
    var maxBirthday = DateTime.Today.AddYears(-GCAMS.Models.Students.StudentRules.MinAge).ToString("yyyy-MM-dd");

    var gradeLevels = new[] { "Grade 7", "Grade 8", "Grade 9", "Grade 10", "Grade 11", "Grade 12" };
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/Students/Create.css" asp-append-version="true" />
}

@section Breadcrumb {
    <a asp-action="Index" class="back-chevron" title="Back"><i class="bi bi-arrow-left"></i></a>
    <nav class="breadcrumb-nav">
        <a asp-action="Index">Students</a>
        <i class="bi bi-chevron-right sep"></i>
        <a asp-action="Index">Student Management</a>
        <i class="bi bi-chevron-right sep"></i>
        <span class="current">Add New Student</span>
    </nav>
}

<div class="wizard">

    <!-- ============ LEFT RAIL ============ -->
    <aside class="wiz-rail">
        <ol class="wiz-steps" id="wizSteps">
            <li class="wiz-step is-current" data-goto="0">
                <span class="wiz-dot">1</span><span class="wiz-name">Personal Information</span>
            </li>
            <li class="wiz-step" data-goto="1">
                <span class="wiz-dot">2</span><span class="wiz-name">Family Background</span>
            </li>
            <li class="wiz-step" data-goto="2">
                <span class="wiz-dot">3</span><span class="wiz-name">Educational History</span>
            </li>
            <li class="wiz-step" data-goto="3">
                <span class="wiz-dot">4</span><span class="wiz-name">Health &amp; Wellness</span>
            </li>
            <li class="wiz-step" data-goto="4">
                <span class="wiz-dot">5</span><span class="wiz-name">Emergency Contact</span>
            </li>
            <li class="wiz-step" data-goto="5">
                <span class="wiz-dot">6</span><span class="wiz-name">Review &amp; Submit</span>
            </li>
        </ol>

        <div class="wiz-progress">
            <div class="wiz-progress-head">
                <span>Completion</span><strong id="pctLabel">0%</strong>
            </div>
            <div class="wiz-bar"><div class="wiz-bar-fill" id="pctBar"></div></div>
        </div>
    </aside>

    <!-- ============ FORM ============ -->
    <div class="wiz-body">
        <form asp-action="Create" method="post" id="studentForm">

            <div asp-validation-summary="All" class="wiz-errors"></div>

            <!-- ---------- STEP 1 ---------- -->
            <section class="wiz-panel is-active" data-panel="0">
                <h2 class="panel-title">Student Information</h2>
                <p class="panel-sub">These details identify the student across every record in the Care Center.</p>

                <div class="field-grid">
                    <div class="field">
                        <label class="field-label">Full Name <span class="req">*</span></label>
                        <input asp-for="Student.StuName" class="form-control" />
                        <span asp-validation-for="Student.StuName" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label class="field-label">Student ID <span class="req">*</span></label>
                        <input asp-for="Student.StuID" class="form-control" />
                        <span asp-validation-for="Student.StuID" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label class="field-label">Gender</label>
                        <select asp-for="Student.Gender" class="form-select">
                            <option value="">Select</option>
                            <option>Male</option>
                            <option>Female</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="field-label">Birth Date</label>
                        <input asp-for="Student.Birthday" type="date" id="birthdayInput" class="form-control"
                               min="@minBirthday" max="@maxBirthday" />
                        <span asp-validation-for="Student.Birthday" class="field-error"></span>
                    </div>

                    <div class="field" data-skip-review="false">
                        <label class="field-label">Age</label>
                        <input type="text" id="ageDisplay" class="form-control" readonly
                               placeholder="Auto-computed" title="Calculated from the date of birth" />
                        <small class="field-hint">Computed from date of birth.</small>
                    </div>
                    <div class="field">
                        <label class="field-label">Birth Order <span class="opt">(optional)</span></label>
                        <input asp-for="Student.BirthOrder" placeholder="e.g. 1st of 3" class="form-control" />
                    </div>

                    <div class="field" id="student-contacts-section">
                        <label class="field-label">Contact Number</label>
                        <div class="repeater" id="student-contacts">
                            @for (int i = 0; i < Model.StudentContacts.Count; i++)
                            {
                                <div class="contact-row">
                                    <input name="StudentContacts[@i].Number" value="@Model.StudentContacts[i].Number"
                                           class="form-control" placeholder="09XX XXX XXXX" />
                                    <button type="button" class="btn-remove remove-contact" aria-label="Remove">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            }
                        </div>
                        <button type="button" class="link-add"
                                onclick="addPlainContact('student-contacts', 'StudentContacts')">
                            + Add another number
                        </button>
                    </div>
                    <div class="field">
                        <label class="field-label">Living Arrangement</label>
                        <select asp-for="Student.StayingWith" class="form-select">
                            <option value="">Select</option>
                            <option value="Parents">With Parents</option>
                            <option value="Relatives">Relatives</option>
                            <option value="Own Family">Own Family</option>
                            <option value="Alone">Alone</option>
                        </select>
                    </div>

                    <div class="field">
                        <label class="field-label">Email Address <span class="opt">(optional)</span></label>
                        <input asp-for="Student.Email" class="form-control" />
                        <span asp-validation-for="Student.Email" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label class="field-label">Grade Level <span class="req">*</span></label>
                        <select asp-for="Student.GradeLevel" id="gradeLevelSelect" class="form-select">
                            <option value="">Select</option>
                            @foreach (var g in gradeLevels)
                            {
                                <option value="@g">@g</option>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Student.GradeLevel) && !gradeLevels.Contains(Model.Student.GradeLevel))
                            {
                                <option value="@Model.Student.GradeLevel">@Model.Student.GradeLevel</option>
                            }
                        </select>
                        <span asp-validation-for="Student.GradeLevel" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label class="field-label">Religion <span class="opt">(optional)</span></label>
                        <input asp-for="Student.Religion" class="form-control" />
                    </div>
                    <div class="field">
                        <label class="field-label">School</label>
                        <input asp-for="Student.School" class="form-control" />
                    </div>

                    <div class="field">
                        <label class="field-label">Section <span class="req">*</span></label>
                        <input asp-for="Student.Section" class="form-control" />
                        <span asp-validation-for="Student.Section" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label class="field-label">Academic Year</label>
                        <select asp-for="Student.AcademicYear" class="form-select">
                            <option value="">Select</option>
                            @{
                                var currentYear = DateTime.Now.Year;
                                var yearRange = $"{currentYear}-{currentYear + 1}";
                            }
                            <option value="S.Y. @yearRange">S.Y. @yearRange</option>
                            <option value="First Quarter S.Y. @yearRange">First Quarter S.Y. @yearRange</option>
                            <option value="Second Quarter S.Y. @yearRange">Second Quarter S.Y. @yearRange</option>
                            <option value="Third Quarter S.Y. @yearRange">Third Quarter S.Y. @yearRange</option>
                            <option value="Fourth Quarter S.Y. @yearRange">Fourth Quarter S.Y. @yearRange</option>
                        </select>
                    </div>

                    <div class="field full-width">
                        <label class="field-label">Home Address <span class="req">*</span></label>
                        <input asp-for="Student.Address" class="form-control" />
                        <span asp-validation-for="Student.Address" class="field-error"></span>
                    </div>

                    <div class="field full-width">
                        <label class="field-label">Nationality <span class="opt">(optional)</span></label>
                        <input asp-for="Student.Nationality" class="form-control" />
                    </div>
                </div>
            </section>

            <!-- ---------- STEP 2 ---------- -->
            <section class="wiz-panel" data-panel="1">
                <h2 class="panel-title">Family Information</h2>
                <p class="panel-sub">Household context helps counselors understand the student's home environment.</p>

                <div class="field-grid">
                    <div class="field">
                        <label class="field-label">Father's Full Name</label>
                        <input asp-for="Family.FatherName" class="form-control" />
                    </div>
                    <div class="field">
                        <label class="field-label">Father's Age</label>
                        <input asp-for="Family.FatherAge" class="form-control" />
                    </div>

                    <div class="field full-width">
                        <label class="field-label">Father's Occupation</label>
                        <input asp-for="Family.FatherOccupation" class="form-control" />
                    </div>
                    <div class="field full-width">
                        <label class="field-label">Father's Educational Attainment</label>
                        <input asp-for="Family.FatherEducationalAttainment" class="form-control" />
                    </div>
                    <div class="field full-width">
                        <label class="field-label">Father's Contact Number</label>
                        <div class="repeater" id="father-contacts">
                            @for (int i = 0; i < Model.FatherContacts.Count; i++)
                            {
                                <div class="contact-row">
                                    <input name="FatherContacts[@i].Number" value="@Model.FatherContacts[i].Number"
                                           class="form-control" placeholder="09XX XXX XXXX" />
                                    <button type="button" class="btn-remove remove-contact" aria-label="Remove">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            }
                        </div>
                        <button type="button" class="link-add"
                                onclick="addPlainContact('father-contacts', 'FatherContacts')">
                            + Add another number
                        </button>
                    </div>

                    <div class="field">
                        <label class="field-label">Mother's Full Name</label>
                        <input asp-for="Family.MotherName" class="form-control" />
                    </div>
                    <div class="field">
                        <label class="field-label">Mother's Age</label>
                        <input asp-for="Family.MotherAge" class="form-control" />
                    </div>

                    <div class="field full-width">
                        <label class="field-label">Mother's Occupation</label>
                        <input asp-for="Family.MotherOccupation" class="form-control" />
                    </div>
                    <div class="field full-width">
                        <label class="field-label">Mother's Educational Attainment</label>
                        <input asp-for="Family.MotherEducationalAttainment" class="form-control" />
                    </div>
                    <div class="field full-width">
                        <label class="field-label">Mother's Contact Number</label>
                        <div class="repeater" id="mother-contacts">
                            @for (int i = 0; i < Model.MotherContacts.Count; i++)
                            {
                                <div class="contact-row">
                                    <input name="MotherContacts[@i].Number" value="@Model.MotherContacts[i].Number"
                                           class="form-control" placeholder="09XX XXX XXXX" />
                                    <button type="button" class="btn-remove remove-contact" aria-label="Remove">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            }
                        </div>
                        <button type="button" class="link-add"
                                onclick="addPlainContact('mother-contacts', 'MotherContacts')">
                            + Add another number
                        </button>
                    </div>

                    <div class="field">
                        <label class="field-label">Parents' Marital Status</label>
                        <select asp-for="Family.ParentsRelationshipStatus" class="form-select">
                            <option value="">Select</option>
                            <option>Married and Living Together</option>
                            <option>Married but Separated</option>
                            <option>Both with other partners</option>
                            <option>Not Married</option>
                            <option>Father/Mother with another partner</option>
                            <option>Both without parents</option>
                            <option>Deceased</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="field-label">Monthly Household Income</label>
                        <select asp-for="Family.MonthlyFamilyIncome" class="form-select">
                            <option value="">Select</option>
                            <option>Below 10,000</option>
                            <option>10,000 - 20,000</option>
                            <option>20,001 - 30,000</option>
                            <option>Above 30,000</option>
                        </select>
                    </div>
                </div>
            </section>

            <!-- ---------- STEP 3 ---------- -->
            <section class="wiz-panel" data-panel="2">
                <h2 class="panel-title">Education History</h2>
                <p class="panel-sub">Record every school previously attended, most recent first.</p>

                <table class="edu-table">
                    <thead>
                        <tr>
                            <th>Previous School Name</th>
                            <th>Level / Year</th>
                            <th>Honors / Awards <span class="opt">(optional)</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Junior High students have not finished a secondary school yet, so this row
                           is hidden for Grades 7-10 and shown only for Senior High (Grades 11-12). *@
                        <tr id="secondaryEduRow">
                            <td><input asp-for="Education.SecondarySchool" placeholder="Junior High school" /></td>
                            <td><input asp-for="Education.SecondaryYear" placeholder="Year graduated" /></td>
                            <td><input asp-for="Education.SecondaryHonors" placeholder="Honors, if any" /></td>
                        </tr>
                        <tr>
                            <td><input asp-for="Education.ElementarySchool" placeholder="Elementary school" /></td>
                            <td><input asp-for="Education.ElementaryYear" placeholder="Year graduated" /></td>
                            <td><input asp-for="Education.ElementaryHonors" placeholder="Honors, if any" /></td>
                        </tr>
                    </tbody>
                </table>
                <small class="field-hint" id="secondaryEduNote" style="display:none;">
                    Junior High School details appear once a Senior High grade level is selected.
                </small>
            </section>

            <!-- ---------- STEP 4 ---------- -->
            <section class="wiz-panel" data-panel="3">
                <h2 class="panel-title">Health &amp; Wellness</h2>
                <p class="panel-sub">Confidential clinical intake. Visible only to authorized counselors.</p>

                <div class="health-note">
                    This section contains sensitive health information. Handle with care, limit access
                    on a need-to-know basis, and store in accordance with your data privacy policy.
                </div>

                <div class="field-grid">
                    <div class="field-grid-3 full-width">
                        <div class="field">
                            <label class="field-label">Blood Type</label>
                            <select asp-for="Health.BloodType" class="form-select">
                                <option value="">Unknown</option>
                                <option>A+</option>
                                <option>A-</option>
                                <option>B+</option>
                                <option>B-</option>
                                <option>AB+</option>
                                <option>AB-</option>
                                <option>O+</option>
                                <option>O-</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="field-label">Height (cm)</label>
                            <input asp-for="Health.Height" class="form-control" placeholder="--" />
                        </div>
                        <div class="field">
                            <label class="field-label">Weight (kg)</label>
                            <input asp-for="Health.Weight" class="form-control" placeholder="--" />
                        </div>
                    </div>

                    <div class="field full-width">
                        <label class="field-label">Current Medications / Chronic Ailments</label>
                        <textarea asp-for="Health.Medication" class="form-control" rows="2"
                                  placeholder="List any medications or medical conditions..."></textarea>
                    </div>
                    <div class="field full-width">
                        <label class="field-label">Family Medical History</label>
                        <textarea asp-for="Health.Ailments" class="form-control" rows="2"
                                  placeholder="Specify condition(s), if any"></textarea>
                    </div>

                    <div class="field full-width">
                        <label asp-for="Health.SuicideRiskHistory" class="field-label field-label-alert"></label>
                        <textarea asp-for="Health.SuicideRiskHistory" class="form-control" rows="2"
                                  placeholder="Details if applicable..."></textarea>
                        <small class="field-hint field-hint-alert">
                            If the student discloses current risk, escalate directly to a counselor before saving this form.
                        </small>
                        <span asp-validation-for="Health.SuicideRiskHistory" class="field-error"></span>
                    </div>
                    <div class="field full-width">
                        <label asp-for="Health.AbuseHistory" class="field-label field-label-alert"></label>
                        <textarea asp-for="Health.AbuseHistory" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Health.AbuseHistory" class="field-error"></span>
                    </div>
                    <div class="field full-width">
                        <label asp-for="Health.DrugHistory" class="field-label"></label>
                        <textarea asp-for="Health.DrugHistory" class="form-control" rows="2"
                                  placeholder="If yes, indicate type and approximate time period"></textarea>
                        <span asp-validation-for="Health.DrugHistory" class="field-error"></span>
                    </div>
                    <div class="field full-width">
                        <label asp-for="Health.FamilyMentalHealthHistory" class="field-label"></label>
                        <textarea asp-for="Health.FamilyMentalHealthHistory" class="form-control" rows="2"
                                  placeholder="Specify condition and relationship to the family member"></textarea>
                        <span asp-validation-for="Health.FamilyMentalHealthHistory" class="field-error"></span>
                    </div>
                    <div class="field full-width">
                        <label asp-for="Health.PsychiatricConsultation" class="field-label"></label>
                        <textarea asp-for="Health.PsychiatricConsultation" class="form-control" rows="2"
                                  placeholder="State reason and approximate date of consultation(s)"></textarea>
                        <span asp-validation-for="Health.PsychiatricConsultation" class="field-error"></span>
                    </div>
                    <div class="field full-width">
                        <label asp-for="Health.AdditionalNotes" class="field-label"></label>
                        <textarea asp-for="Health.AdditionalNotes" class="form-control" rows="2"
                                  placeholder="Enter any additional notes or comments"></textarea>
                        <span asp-validation-for="Health.AdditionalNotes" class="field-error"></span>
                    </div>
                </div>
            </section>

            <!-- ---------- STEP 5 ---------- -->
            <section class="wiz-panel" data-panel="4">
                <h2 class="panel-title">Emergency Contact</h2>
                <p class="panel-sub">Who should the Care Center reach first in an emergency?</p>

                <div class="field-grid">
                    <div class="field">
                        <label class="field-label">Emergency Contact Name <span class="req">*</span></label>
                        <input asp-for="Emergency.EmergencyContactPerson" class="form-control" />
                    </div>
                    <div class="field">
                        <label class="field-label">Occupation</label>
                        <input asp-for="Emergency.EmergencyContactOccupation" class="form-control" />
                    </div>

                    <div class="field">
                        <label class="field-label">Age</label>
                        <input asp-for="Emergency.EmergencyContactAge" class="form-control" />
                    </div>
                    <div class="field">
                        <label class="field-label">Contact Number <span class="req">*</span></label>
                        <div class="repeater" id="emergency-contacts">
                            @for (int i = 0; i < Model.EmergencyContacts.Count; i++)
                            {
                                <div class="contact-row">
                                    <input name="EmergencyContacts[@i].Number" value="@Model.EmergencyContacts[i].Number"
                                           class="form-control" placeholder="09XX XXX XXXX" />
                                    <button type="button" class="btn-remove remove-contact" aria-label="Remove">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            }
                        </div>
                        <button type="button" class="link-add"
                                onclick="addPlainContact('emergency-contacts', 'EmergencyContacts')">
                            + Add another number
                        </button>
                    </div>

                    <div class="field full-width">
                        <label class="field-label">Address</label>
                        <textarea asp-for="Emergency.EmergencyContactAddress" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </section>

            <!-- ---------- STEP 6 ---------- -->
            <section class="wiz-panel" data-panel="5">
                <h2 class="panel-title">Review &amp; Submit</h2>
                <p class="panel-sub">Check every section before submitting. Click <em>Edit</em> to jump back and make changes.</p>

                <div id="reviewOut"></div>

                <label class="confirm-row">
                    <input type="checkbox" id="confirmBox" />
                    <span>I confirm the information above is accurate to the best of my knowledge.</span>
                </label>
            </section>

            <!-- ---------- FOOTER ---------- -->
            <div class="wiz-foot">
                <span class="wiz-count" id="stepCount">Step 1 of 6</span>
                <div class="wiz-actions">
                    <button type="button" class="btn-shell" id="btnBack" hidden>Back</button>
                    <a asp-action="Index" class="btn-shell" id="btnCancel" hidden>Cancel</a>
                    <button type="button" class="btn-brand" id="btnNext">Next</button>
                    <input type="submit" value="Save Changes" class="btn-brand" id="btnSave" hidden disabled />
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        // ── Step machine ────────────────────────────────────────────────────────
        const panels   = Array.from(document.querySelectorAll('.wiz-panel'));
        const railItems= Array.from(document.querySelectorAll('.wiz-step'));
        const btnBack  = document.getElementById('btnBack');
        const btnNext  = document.getElementById('btnNext');
        const btnSave  = document.getElementById('btnSave');
        const btnCancel= document.getElementById('btnCancel');
        const stepCount= document.getElementById('stepCount');
        const confirmBox = document.getElementById('confirmBox');
        const LAST = panels.length - 1;

        let current = 0;
        const visited = new Set([0]);

        function showStep(i) {
            current = Math.max(0, Math.min(LAST, i));
            visited.add(current);

            panels.forEach((p, n) => p.classList.toggle('is-active', n === current));

            railItems.forEach((li, n) => {
                li.classList.toggle('is-current', n === current);
                li.classList.toggle('is-done', n < current || (visited.has(n) && n !== current));
            });

            stepCount.textContent = `Step ${current + 1} of ${panels.length}`;
            btnBack.hidden   = current === 0;
            btnNext.hidden   = current === LAST;
            btnSave.hidden   = current !== LAST;
            btnCancel.hidden = current !== LAST;

            if (current === LAST) { buildReview(); }

            document.querySelector('.wiz-body').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        btnNext.addEventListener('click', () => showStep(current + 1));
        btnBack.addEventListener('click', () => showStep(current - 1));
        railItems.forEach(li => li.addEventListener('click', () => showStep(+li.dataset.goto)));

        // Save stays locked until the box is ticked
        confirmBox.addEventListener('change', function () { btnSave.disabled = !this.checked; });

        // ── Review builder — reads whatever is currently in the fields ──────────
        const SECTION_TITLES = ['Student Information', 'Family Information',
                                'Education History', 'Health & Wellness', 'Emergency Contact'];

        function readValue(field) {
            const rep = field.querySelector('.repeater');
            if (rep) {
                const nums = Array.from(rep.querySelectorAll('input'))
                                  .map(i => i.value.trim()).filter(Boolean);
                return nums.join(', ');
            }
            const el = field.querySelector('input, select, textarea');
            if (!el) return '';
            if (el.tagName === 'SELECT') {
                return el.selectedIndex > -1 ? (el.options[el.selectedIndex].value ? el.options[el.selectedIndex].text : '') : '';
            }
            return el.value.trim();
        }

        function buildReview() {
            const out = document.getElementById('reviewOut');
            out.innerHTML = '';

            panels.slice(0, LAST).forEach((panel, idx) => {
                const rows = [];

                // regular labelled fields
                panel.querySelectorAll('.field').forEach(field => {
                    const labelEl = field.querySelector('.field-label');
                    if (!labelEl) return;
                    const label = labelEl.textContent.replace(/\*|\(optional\)/g, '').trim();
                    rows.push([label, readValue(field)]);
                });

                // the education table has no .field wrappers
                panel.querySelectorAll('.edu-table tbody tr').forEach(tr => {
                    if (tr.offsetParent === null && tr.style.display === 'none') return;
                    const inputs = tr.querySelectorAll('input');
                    const kind = tr.id === 'secondaryEduRow' ? 'Secondary' : 'Elementary';
                    rows.push([kind + ' school', inputs[0].value.trim()]);
                    rows.push([kind + ' level / year', inputs[1].value.trim()]);
                    rows.push([kind + ' honors / awards', inputs[2].value.trim()]);
                });

                if (!rows.length) return;

                const block = document.createElement('div');
                block.className = 'review-block';
                block.innerHTML = `
                    <div class="review-head">
                        <span>${SECTION_TITLES[idx]}</span>
                        <button type="button" class="review-edit" data-goto="${idx}">Edit</button>
                    </div>
                    <div class="review-grid">
                        ${rows.map(([k, v]) => `
                            <div class="review-cell">
                                <div class="review-key">${k}</div>
                                <div class="review-val ${v ? '' : 'is-empty'}">${v ? escapeHtml(v) : 'Not provided'}</div>
                            </div>`).join('')}
                    </div>`;
                out.appendChild(block);
            });

            out.querySelectorAll('.review-edit').forEach(b =>
                b.addEventListener('click', () => showStep(+b.dataset.goto)));
        }

        function escapeHtml(s) {
            return String(s).replace(/[&<>"']/g, c =>
                ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
        }

        // ── Completion meter ───────────────────────────────────────────────────
        function updateProgress() {
            const all = Array.from(document.querySelectorAll('#studentForm input, #studentForm select, #studentForm textarea'))
                .filter(el => el.type !== 'submit' && el.type !== 'checkbox' && el.type !== 'hidden' && el.id !== 'ageDisplay');
            const filled = all.filter(el => el.value && el.value.trim() !== '').length;
            const pct = all.length ? Math.round(100 * filled / all.length) : 0;

            document.getElementById('pctLabel').textContent = pct + '%';
            document.getElementById('pctBar').style.width = pct + '%';
        }

        document.getElementById('studentForm').addEventListener('input', updateProgress);
        document.getElementById('studentForm').addEventListener('change', updateProgress);

        // ── Repeating contact numbers ──────────────────────────────────────────
        function addPlainContact(containerId, prefix) {
            const container = document.getElementById(containerId);
            const index = container.querySelectorAll('.contact-row').length;
            const row = document.createElement('div');
            row.className = 'contact-row';
            row.innerHTML = `
                <input name="${prefix}[${index}].Number" class="form-control" placeholder="09XX XXX XXXX" />
                <button type="button" class="btn-remove remove-contact" aria-label="Remove"><i class="bi bi-x-lg"></i></button>`;
            container.appendChild(row);
        }

        // Names must stay contiguous or the model binder stops at the first gap.
        function reindex(container, prefix) {
            container.querySelectorAll('.contact-row input').forEach((input, i) => {
                input.name = `${prefix}[${i}].Number`;
            });
        }

        document.addEventListener('click', e => {
            const btn = e.target.closest('.remove-contact');
            if (!btn) return;
            const row = btn.closest('.contact-row');
            const box = row.parentElement;
            const prefix = box.id.split('-')[0];
            const map = { student: 'StudentContacts', father: 'FatherContacts',
                          mother: 'MotherContacts', emergency: 'EmergencyContacts' };
            row.remove();
            reindex(box, map[prefix]);
            updateProgress();
        });

        // ── Age is derived, never typed ────────────────────────────────────────
        (function () {
            const birthday = document.getElementById('birthdayInput');
            const ageBox = document.getElementById('ageDisplay');
            if (!birthday || !ageBox) return;

            function computeAge() {
                if (!birthday.value) { ageBox.value = ''; return; }
                const dob = new Date(birthday.value + 'T00:00:00');
                if (isNaN(dob)) { ageBox.value = ''; return; }

                const today = new Date();
                let age = today.getFullYear() - dob.getFullYear();
                const m = today.getMonth() - dob.getMonth();
                if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) age--;

                ageBox.value = age >= 0 ? age + ' years old' : '';
            }

            birthday.addEventListener('change', computeAge);
            birthday.addEventListener('input', computeAge);
            computeAge();
        })();

        // ── Junior High has no previous secondary school to record ─────────────
        (function () {
            const grade = document.getElementById('gradeLevelSelect');
            const row = document.getElementById('secondaryEduRow');
            const note = document.getElementById('secondaryEduNote');
            if (!grade || !row) return;

            function toggleSecondary() {
                const isSeniorHigh = /11|12/.test(grade.value || '');
                row.style.display = isSeniorHigh ? '' : 'none';
                if (note) note.style.display = isSeniorHigh ? 'none' : '';
                if (!isSeniorHigh) { row.querySelectorAll('input').forEach(i => i.value = ''); }
            }

            grade.addEventListener('change', toggleSecondary);
            toggleSecondary();
        })();

        // If the server sent back errors, open the step that holds the first one.
        (function () {
            const firstError = document.querySelector('.field-error:not(:empty)');
            if (firstError) {
                const panel = firstError.closest('.wiz-panel');
                if (panel) { showStep(+panel.dataset.panel); return; }
            }
            showStep(0);
        })();

        updateProgress();
    </script>
}