@model GCAMS.ViewModels.StudentFormViewModel
@{
    ViewData["Title"] = "Edit Student";
    var lastUpdated = ViewData["LastUpdated"] as DateTime?;
}

<link rel="stylesheet" href="~/css/Students/Edit.css" asp-append-version="true" />

@section Breadcrumb {
    <div class="breadcrumb-nav">
        <a asp-controller="Students" asp-action="Index">Students</a>
        <span class="sep">/</span>
        <a asp-controller="Students" asp-action="Index">Student Management</a>
        <span class="sep">/</span>
        <span class="current">Edit Record</span>
    </div>
}

<div class="edit-page">

    <!-- Page header -->
    <div class="edit-page-head">
        <h1 class="edit-title">Edit Student</h1>
        @if (lastUpdated.HasValue)
        {
            <div class="edit-updated">
                <i class="bi bi-clock-history"></i>
                Last updated <strong>@lastUpdated.Value.ToString("MMM dd, yyyy, h:mm tt")</strong>
            </div>
        }
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3 d-none" id="serverErrors"></div>

    <form asp-action="Edit" method="post" id="studentForm" novalidate>
        <input type="hidden" asp-for="Student.StudentsID" />
        <input type="hidden" asp-for="Family.FamilyBackgroundID" />
        <input type="hidden" asp-for="Emergency.EmergencyContactID" />
        <input type="hidden" asp-for="Education.EducationalBackgroundID" />
        <input type="hidden" asp-for="Health.HealthInformationID" />

        <div class="wizard-grid">

            <!-- ============ LEFT: STEP NAV ============ -->
            <aside class="wizard-aside">
                <nav class="step-card" aria-label="Form sections">
                    <button type="button" class="step-item is-active" data-goto="1">
                        <span class="step-num">1</span><span class="step-text">Personal Information</span>
                    </button>
                    <button type="button" class="step-item" data-goto="2">
                        <span class="step-num">2</span><span class="step-text">Family Background</span>
                    </button>
                    <button type="button" class="step-item" data-goto="3">
                        <span class="step-num">3</span><span class="step-text">Educational History</span>
                    </button>
                    <button type="button" class="step-item" data-goto="4">
                        <span class="step-num">4</span><span class="step-text">Health &amp; Wellness</span>
                    </button>
                    <button type="button" class="step-item" data-goto="5">
                        <span class="step-num">5</span><span class="step-text">Emergency Contact</span>
                    </button>
                    <button type="button" class="step-item" data-goto="6">
                        <span class="step-num">6</span><span class="step-text">Review &amp; Submit</span>
                    </button>
                </nav>

                <div class="completion-card">
                    <div class="completion-head">
                        <span>Completion</span>
                        <strong id="completionValue">0%</strong>
                    </div>
                    <div class="completion-track">
                        <div class="completion-bar" id="completionBar" style="width:0%"></div>
                    </div>
                </div>
            </aside>

            <!-- ============ RIGHT: STEP PANELS ============ -->
            <div class="wizard-body">

                <!-- STEP 1 — Personal Information -->
                <section class="form-step is-active" data-step="1">
                    <header class="step-head">
                        <h2><i class="bi bi-person-vcard"></i> Student Information</h2>
                        <p>These details identify the student across every record in the Care Center.</p>
                    </header>

                    <div class="form-grid">
                        <div class="field" data-label="Full Name">
                            <label class="field-label" asp-for="Student.StuName">Full Name <span class="req">*</span></label>
                            <input asp-for="Student.StuName" class="form-control" />
                            <span asp-validation-for="Student.StuName" class="field-error"></span>
                        </div>

                        <div class="field" data-label="Student ID">
                            <label class="field-label" asp-for="Student.StuID">Student ID <span class="req">*</span></label>
                            <input asp-for="Student.StuID" class="form-control" />
                            <span class="field-hint">Student IDs are permanent and can't be changed after enrollment.</span>
                            <span asp-validation-for="Student.StuID" class="field-error"></span>
                        </div>

                        <div class="field" data-label="Gender">
                            <label class="field-label" asp-for="Student.Gender">Gender</label>
                            <select asp-for="Student.Gender" class="form-select">
                                <option value="">Select</option>
                                <option>Male</option>
                                <option>Female</option>
                            </select>
                            <span asp-validation-for="Student.Gender" class="field-error"></span>
                        </div>

                        <div class="field" data-label="Birth Date">
                            <label class="field-label" asp-for="Student.Birthday">Birth Date</label>
                            <input asp-for="Student.Birthday" type="date" class="form-control" />
                            <span asp-validation-for="Student.Birthday" class="field-error"></span>
                        </div>

                        <div class="field" data-label="Age">
                            <label class="field-label" asp-for="Student.Age">Age</label>
                            <input asp-for="Student.Age" class="form-control" />
                            <span asp-validation-for="Student.Age" class="field-error"></span>
                        </div>

                        <div class="field" data-label="Birth Order">
                            <label class="field-label" asp-for="Student.BirthOrder">Birth Order <span class="opt">(optional)</span></label>
                            <input asp-for="Student.BirthOrder" class="form-control" placeholder="e.g. 2nd of 4" />
                        </div>

                        <div class="field full-width" data-contact-group="Contact Number">
                            <label class="field-label">Contact Number</label>
                            <div id="student-contacts" class="contact-list">
                                @for (int i = 0; i < Model.StudentContacts.Count; i++)
                                {
                                    <div class="contact-row">
                                        <input name="StudentContacts[@i].Number" value="@Model.StudentContacts[i].Number"
                                               class="form-control contact-number" placeholder="+63 917 123 4567" />
                                        <select name="StudentContacts[@i].Label" class="form-select contact-label">
                                            <option value="">Select type</option>
                                            <option value="Office Telephone" selected="@(Model.StudentContacts[i].Label == "Office Telephone")">Office Telephone</option>
                                            <option value="Office Mobile Phone" selected="@(Model.StudentContacts[i].Label == "Office Mobile Phone")">Office Mobile Phone</option>
                                            <option value="Home Telephone" selected="@(Model.StudentContacts[i].Label == "Home Telephone")">Home Telephone</option>
                                            <option value="Home Mobile Phone" selected="@(Model.StudentContacts[i].Label == "Home Mobile Phone")">Home Mobile Phone</option>
                                            <option value="Personal Mobile Phone" selected="@(Model.StudentContacts[i].Label == "Personal Mobile Phone")">Personal Mobile Phone</option>
                                        </select>
                                        <button type="button" class="btn-remove remove-contact" title="Remove number">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                            <button type="button" class="btn-add-line" data-add-contact="student-contacts" data-prefix="StudentContacts">
                                <i class="bi bi-plus-lg"></i> Add another number
                            </button>
                        </div>

                        <div class="field" data-label="Email Address">
                            <label class="field-label" asp-for="Student.Email">Email Address <span class="opt">(optional)</span></label>
                            <input asp-for="Student.Email" class="form-control" />
                            <span asp-validation-for="Student.Email" class="field-error"></span>
                        </div>

                        <div class="field" data-label="Living Arrangement">
                            <label class="field-label" asp-for="Student.StayingWith">Living Arrangement</label>
                            <select asp-for="Student.StayingWith" class="form-select">
                                <option value="">Select</option>
                                <option value="Parents">With Parents</option>
                                <option value="Relatives">Relatives</option>
                                <option value="Own Family">Own Family</option>
                                <option value="Alone">Alone</option>
                            </select>
                        </div>

                        <div class="field" data-label="Religion">
                            <label class="field-label" asp-for="Student.Religion">Religion <span class="opt">(optional)</span></label>
                            <input asp-for="Student.Religion" class="form-control" />
                        </div>

                        <div class="field" data-label="Grade Level">
                            <label class="field-label" asp-for="Student.GradeLevel">Grade Level <span class="req">*</span></label>
                            <input asp-for="Student.GradeLevel" class="form-control" placeholder="e.g. Grade 11" />
                            <span asp-validation-for="Student.GradeLevel" class="field-error"></span>
                        </div>

                        <div class="field" data-label="Section">
                            <label class="field-label" asp-for="Student.Section">Section <span class="req">*</span></label>
                            <input asp-for="Student.Section" class="form-control" placeholder="e.g. Rizal" />
                            <span asp-validation-for="Student.Section" class="field-error"></span>
                        </div>

                        <div class="field" data-label="School">
                            <label class="field-label" asp-for="Student.School">School</label>
                            <input asp-for="Student.School" class="form-control" />
                        </div>

                        <div class="field" data-label="Academic Year">
                            <label class="field-label" asp-for="Student.AcademicYear">Academic Year</label>
                            <select asp-for="Student.AcademicYear" class="form-select">
                                <option value="">Select</option>
                                @{
                                    var currentYear = DateTime.Now.Year;
                                    var yearRange = $"{currentYear}-{currentYear + 1}";
                                }
                                <option value="@yearRange">@yearRange</option>
                                <option value="First Semester A.Y. @yearRange">First Semester A.Y. @yearRange</option>
                                <option value="Second Semester A.Y. @yearRange">Second Semester A.Y. @yearRange</option>
                            </select>
                        </div>

                        <div class="field full-width" data-label="Home Address">
                            <label class="field-label" asp-for="Student.Address">Home Address <span class="req">*</span></label>
                            <textarea asp-for="Student.Address" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Student.Address" class="field-error"></span>
                        </div>

                        <div class="field" data-label="Nationality">
                            <label class="field-label" asp-for="Student.Nationality">Nationality <span class="opt">(optional)</span></label>
                            <input asp-for="Student.Nationality" class="form-control" placeholder="e.g. Filipino" />
                        </div>
                    </div>

                    <footer class="step-foot">
                        <span class="step-count">Step 1 of 6</span>
                        <div class="step-actions">
                            <button type="button" class="btn-back" data-prev disabled><i class="bi bi-arrow-left"></i> Back</button>
                            <button type="button" class="btn-next" data-next>Next <i class="bi bi-arrow-right"></i></button>
                        </div>
                    </footer>
                </section>

                <!-- STEP 2 — Family Background -->
                <section class="form-step" data-step="2">
                    <header class="step-head">
                        <h2><i class="bi bi-people"></i> Family Information</h2>
                        <p>Household context helps counselors understand the student's home environment.</p>
                    </header>

                    <div class="form-grid">
                        <div class="field" data-label="Father's Full Name">
                            <label class="field-label" asp-for="Family.FatherName">Father's Full Name <span class="opt">(optional)</span></label>
                            <input asp-for="Family.FatherName" class="form-control" />
                        </div>
                        <div class="field" data-label="Father's Age">
                            <label class="field-label" asp-for="Family.FatherAge">Father's Age</label>
                            <input asp-for="Family.FatherAge" class="form-control" />
                        </div>
                        <div class="field full-width" data-label="Father's Occupation">
                            <label class="field-label" asp-for="Family.FatherOccupation">Father's Occupation</label>
                            <input asp-for="Family.FatherOccupation" class="form-control" />
                        </div>
                        <div class="field full-width" data-label="Father's Educational Attainment">
                            <label class="field-label" asp-for="Family.FatherEducationalAttainment">Father's Educational Attainment</label>
                            <input asp-for="Family.FatherEducationalAttainment" class="form-control" />
                        </div>

                        <div class="field full-width" data-contact-group="Father's Contact Number">
                            <label class="field-label">Father's Contact Number</label>
                            <div id="father-contacts" class="contact-list">
                                @for (int i = 0; i < Model.FatherContacts.Count; i++)
                                {
                                    <div class="contact-row">
                                        <input name="FatherContacts[@i].Number" value="@Model.FatherContacts[i].Number"
                                               class="form-control contact-number" placeholder="Number" />
                                        <select name="FatherContacts[@i].Label" class="form-select contact-label">
                                            <option value="">Select type</option>
                                            <option value="Office Telephone" selected="@(Model.FatherContacts[i].Label == "Office Telephone")">Office Telephone</option>
                                            <option value="Office Mobile Phone" selected="@(Model.FatherContacts[i].Label == "Office Mobile Phone")">Office Mobile Phone</option>
                                            <option value="Home Telephone" selected="@(Model.FatherContacts[i].Label == "Home Telephone")">Home Telephone</option>
                                            <option value="Home Mobile Phone" selected="@(Model.FatherContacts[i].Label == "Home Mobile Phone")">Home Mobile Phone</option>
                                            <option value="Personal Mobile Phone" selected="@(Model.FatherContacts[i].Label == "Personal Mobile Phone")">Personal Mobile Phone</option>
                                        </select>
                                        <button type="button" class="btn-remove remove-contact" title="Remove number"><i class="bi bi-trash3"></i></button>
                                    </div>
                                }
                            </div>
                            <button type="button" class="btn-add-line" data-add-contact="father-contacts" data-prefix="FatherContacts">
                                <i class="bi bi-plus-lg"></i> Add another number
                            </button>
                        </div>

                        <div class="field" data-label="Mother's Full Name">
                            <label class="field-label" asp-for="Family.MotherName">Mother's Full Name <span class="opt">(optional)</span></label>
                            <input asp-for="Family.MotherName" class="form-control" />
                        </div>
                        <div class="field" data-label="Mother's Age">
                            <label class="field-label" asp-for="Family.MotherAge">Mother's Age</label>
                            <input asp-for="Family.MotherAge" class="form-control" />
                        </div>
                        <div class="field full-width" data-label="Mother's Occupation">
                            <label class="field-label" asp-for="Family.MotherOccupation">Mother's Occupation</label>
                            <input asp-for="Family.MotherOccupation" class="form-control" />
                        </div>
                        <div class="field full-width" data-label="Mother's Educational Attainment">
                            <label class="field-label" asp-for="Family.MotherEducationalAttainment">Mother's Educational Attainment</label>
                            <input asp-for="Family.MotherEducationalAttainment" class="form-control" />
                        </div>

                        <div class="field full-width" data-contact-group="Mother's Contact Number">
                            <label class="field-label">Mother's Contact Number</label>
                            <div id="mother-contacts" class="contact-list">
                                @for (int i = 0; i < Model.MotherContacts.Count; i++)
                                {
                                    <div class="contact-row">
                                        <input name="MotherContacts[@i].Number" value="@Model.MotherContacts[i].Number"
                                               class="form-control contact-number" placeholder="Number" />
                                        <select name="MotherContacts[@i].Label" class="form-select contact-label">
                                            <option value="">Select type</option>
                                            <option value="Office Telephone" selected="@(Model.MotherContacts[i].Label == "Office Telephone")">Office Telephone</option>
                                            <option value="Office Mobile Phone" selected="@(Model.MotherContacts[i].Label == "Office Mobile Phone")">Office Mobile Phone</option>
                                            <option value="Home Telephone" selected="@(Model.MotherContacts[i].Label == "Home Telephone")">Home Telephone</option>
                                            <option value="Home Mobile Phone" selected="@(Model.MotherContacts[i].Label == "Home Mobile Phone")">Home Mobile Phone</option>
                                            <option value="Personal Mobile Phone" selected="@(Model.MotherContacts[i].Label == "Personal Mobile Phone")">Personal Mobile Phone</option>
                                        </select>
                                        <button type="button" class="btn-remove remove-contact" title="Remove number"><i class="bi bi-trash3"></i></button>
                                    </div>
                                }
                            </div>
                            <button type="button" class="btn-add-line" data-add-contact="mother-contacts" data-prefix="MotherContacts">
                                <i class="bi bi-plus-lg"></i> Add another number
                            </button>
                        </div>

                        <div class="field" data-label="Parents' Marital Status">
                            <label class="field-label" asp-for="Family.ParentsRelationshipStatus">Parents' Marital Status</label>
                            <select asp-for="Family.ParentsRelationshipStatus" class="form-select">
                                <option value="">Select</option>
                                <option>Married and Living Together</option>
                                <option>Married but Separated</option>
                                <option>Both with other partners</option>
                                <option>Not Married</option>
                                <option>Father/Mother with another partner</option>
                                <option>Both without parents</option>
                                <option>Deceased</option>
                            </select>
                        </div>

                        <div class="field" data-label="Monthly Household Income">
                            <label class="field-label" asp-for="Family.MonthlyFamilyIncome">Monthly Household Income</label>
                            <select asp-for="Family.MonthlyFamilyIncome" class="form-select">
                                <option value="">Select</option>
                                <option>Below 10,000</option>
                                <option>10,000 - 20,000</option>
                                <option>20,001 - 30,000</option>
                                <option>Above 30,000</option>
                            </select>
                        </div>
                    </div>

                    <footer class="step-foot">
                        <span class="step-count">Step 2 of 6</span>
                        <div class="step-actions">
                            <button type="button" class="btn-back" data-prev><i class="bi bi-arrow-left"></i> Back</button>
                            <button type="button" class="btn-next" data-next>Next <i class="bi bi-arrow-right"></i></button>
                        </div>
                    </footer>
                </section>

                <!-- STEP 3 — Educational History -->
                <section class="form-step" data-step="3">
                    <header class="step-head">
                        <h2><i class="bi bi-mortarboard"></i> Education History</h2>
                        <p>Record every school previously attended, most recent first.</p>
                    </header>

                    <div class="edu-table-wrap">
                        <table class="edu-table">
                            <thead>
                                <tr>
                                    <th>Previous School Name</th>
                                    <th>Level / Year</th>
                                    <th>Honors / Awards <span class="opt">(optional)</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td data-label="Secondary School"><input asp-for="Education.SecondarySchool" class="form-control" placeholder="Secondary school" /></td>
                                    <td data-label="Secondary Level / Year"><input asp-for="Education.SecondaryYear" class="form-control" placeholder="Year graduated" /></td>
                                    <td data-label="Secondary Honors / Awards"><input asp-for="Education.SecondaryHonors" class="form-control" placeholder="Honors, if any" /></td>
                                </tr>
                                <tr>
                                    <td data-label="Elementary School"><input asp-for="Education.ElementarySchool" class="form-control" placeholder="Elementary school" /></td>
                                    <td data-label="Elementary Level / Year"><input asp-for="Education.ElementaryYear" class="form-control" placeholder="Year graduated" /></td>
                                    <td data-label="Elementary Honors / Awards"><input asp-for="Education.ElementaryHonors" class="form-control" placeholder="Honors, if any" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <footer class="step-foot">
                        <span class="step-count">Step 3 of 6</span>
                        <div class="step-actions">
                            <button type="button" class="btn-back" data-prev><i class="bi bi-arrow-left"></i> Back</button>
                            <button type="button" class="btn-next" data-next>Next <i class="bi bi-arrow-right"></i></button>
                        </div>
                    </footer>
                </section>

                <!-- STEP 4 — Health & Wellness -->
                <section class="form-step" data-step="4">
                    <header class="step-head">
                        <h2><i class="bi bi-heart-pulse"></i> Health &amp; Wellness</h2>
                        <p>Confidential clinical intake. Visible only to authorized counselors.</p>
                    </header>

                    <div class="sensitive-note" role="note">
                        <i class="bi bi-shield-exclamation"></i>
                        <span>This section contains sensitive health information. Handle with care, limit access on a need-to-know basis, and store in accordance with your data privacy policy.</span>
                    </div>

                    <div class="form-grid grid-3">
                        <div class="field" data-label="Blood Type">
                            <label class="field-label" asp-for="Health.BloodType">Blood Type</label>
                            <select asp-for="Health.BloodType" class="form-select">
                                <option value="">Unknown</option>
                                <option>A+</option>
                                <option>A-</option>
                                <option>B+</option>
                                <option>B-</option>
                                <option>AB+</option>
                                <option>AB-</option>
                                <option>O+</option>
                                <option>O-</option>
                            </select>
                        </div>
                        <div class="field" data-label="Height (cm)">
                            <label class="field-label" asp-for="Health.Height">Height (cm)</label>
                            <input asp-for="Health.Height" class="form-control" placeholder="--" />
                        </div>
                        <div class="field" data-label="Weight (kg)">
                            <label class="field-label" asp-for="Health.Weight">Weight (kg)</label>
                            <input asp-for="Health.Weight" class="form-control" placeholder="--" />
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="field full-width" data-label="Current Medications / Chronic Ailments">
                            <label class="field-label" asp-for="Health.Medication">Current Medications / Chronic Ailments</label>
                            <textarea asp-for="Health.Medication" class="form-control" rows="3"
                                      placeholder="List any medications or medical conditions..."></textarea>
                        </div>

                        <div class="field full-width" data-label="Family Medical History">
                            <label class="field-label" asp-for="Health.Ailments">Family Medical History</label>
                            <textarea asp-for="Health.Ailments" class="form-control" rows="3"
                                      placeholder="Specify condition(s), if any"></textarea>
                        </div>

                        <div class="field full-width" data-label="History of Suicidal Thoughts or Attempts">
                            <label class="field-label is-sensitive" asp-for="Health.SuicideRiskHistory">History of Suicidal Thoughts or Attempts</label>
                            <textarea asp-for="Health.SuicideRiskHistory" class="form-control" rows="3"
                                      placeholder="Details if applicable..."></textarea>
                            <span class="field-hint is-sensitive">If the student discloses current risk, escalate directly to a counselor before saving this form.</span>
                            <span asp-validation-for="Health.SuicideRiskHistory" class="field-error"></span>
                        </div>

                        <div class="field full-width" data-label="History of Abuse or Maltreatment">
                            <label class="field-label is-sensitive" asp-for="Health.AbuseHistory">History of Abuse or Maltreatment</label>
                            <textarea asp-for="Health.AbuseHistory" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Health.AbuseHistory" class="field-error"></span>
                        </div>

                        <div class="field full-width" data-label="History of Illegal Drug Use">
                            <label class="field-label is-sensitive" asp-for="Health.DrugHistory">History of Illegal Drug Use</label>
                            <textarea asp-for="Health.DrugHistory" class="form-control" rows="3"
                                      placeholder="If yes, indicate type and approximate time period"></textarea>
                            <span asp-validation-for="Health.DrugHistory" class="field-error"></span>
                        </div>

                        <div class="field full-width" data-label="Family History of Mental or Developmental Conditions">
                            <label class="field-label" asp-for="Health.FamilyMentalHealthHistory">Family History of Mental or Developmental Conditions</label>
                            <textarea asp-for="Health.FamilyMentalHealthHistory" class="form-control" rows="3"
                                      placeholder="Specify condition and relationship to the family member"></textarea>
                        </div>

                        <div class="field full-width" data-label="Previous Psychiatric or Psychological Consultation">
                            <label class="field-label" asp-for="Health.PsychiatricConsultation">Previous Psychiatric or Psychological Consultation</label>
                            <textarea asp-for="Health.PsychiatricConsultation" class="form-control" rows="3"
                                      placeholder="State reason and approximate date of consultation(s)"></textarea>
                        </div>

                        <div class="field full-width" data-label="Additional Relevant Information / Remarks">
                            <label class="field-label" asp-for="Health.AdditionalNotes">Additional Relevant Information / Remarks</label>
                            <textarea asp-for="Health.AdditionalNotes" class="form-control" rows="3"
                                      placeholder="Enter any additional notes or comments"></textarea>
                        </div>
                    </div>

                    <footer class="step-foot">
                        <span class="step-count">Step 4 of 6</span>
                        <div class="step-actions">
                            <button type="button" class="btn-back" data-prev><i class="bi bi-arrow-left"></i> Back</button>
                            <button type="button" class="btn-next" data-next>Next <i class="bi bi-arrow-right"></i></button>
                        </div>
                    </footer>
                </section>

                <!-- STEP 5 — Emergency Contact -->
                <section class="form-step" data-step="5">
                    <header class="step-head">
                        <h2><i class="bi bi-telephone"></i> Emergency Contact</h2>
                        <p>Who should the Care Center reach first in an emergency?</p>
                    </header>

                    <div class="form-grid">
                        <div class="field" data-label="Emergency Contact Name">
                            <label class="field-label" asp-for="Emergency.EmergencyContactPerson">Emergency Contact Name <span class="req">*</span></label>
                            <input asp-for="Emergency.EmergencyContactPerson" class="form-control" />
                            <span asp-validation-for="Emergency.EmergencyContactPerson" class="field-error"></span>
                        </div>

                        <div class="field" data-label="Occupation">
                            <label class="field-label" asp-for="Emergency.EmergencyContactOccupation">Occupation</label>
                            <input asp-for="Emergency.EmergencyContactOccupation" class="form-control" />
                        </div>

                        <div class="field" data-label="Age">
                            <label class="field-label" asp-for="Emergency.EmergencyContactAge">Age</label>
                            <input asp-for="Emergency.EmergencyContactAge" class="form-control" />
                        </div>

                        <div class="field full-width" data-contact-group="Contact Number">
                            <label class="field-label">Contact Number <span class="req">*</span></label>
                            <div id="emergency-contacts" class="contact-list">
                                @for (int i = 0; i < Model.EmergencyContacts.Count; i++)
                                {
                                    <div class="contact-row">
                                        <input name="EmergencyContacts[@i].Number" value="@Model.EmergencyContacts[i].Number"
                                               class="form-control contact-number" placeholder="Number" />
                                        <select name="EmergencyContacts[@i].Label" class="form-select contact-label">
                                            <option value="">Select type</option>
                                            <option value="Office Telephone" selected="@(Model.EmergencyContacts[i].Label == "Office Telephone")">Office Telephone</option>
                                            <option value="Office Mobile Phone" selected="@(Model.EmergencyContacts[i].Label == "Office Mobile Phone")">Office Mobile Phone</option>
                                            <option value="Home Telephone" selected="@(Model.EmergencyContacts[i].Label == "Home Telephone")">Home Telephone</option>
                                            <option value="Home Mobile Phone" selected="@(Model.EmergencyContacts[i].Label == "Home Mobile Phone")">Home Mobile Phone</option>
                                            <option value="Personal Mobile Phone" selected="@(Model.EmergencyContacts[i].Label == "Personal Mobile Phone")">Personal Mobile Phone</option>
                                        </select>
                                        <button type="button" class="btn-remove remove-contact" title="Remove number"><i class="bi bi-trash3"></i></button>
                                    </div>
                                }
                            </div>
                            <button type="button" class="btn-add-line" data-add-contact="emergency-contacts" data-prefix="EmergencyContacts">
                                <i class="bi bi-plus-lg"></i> Add another number
                            </button>
                        </div>

                        <div class="field full-width" data-label="Address">
                            <label class="field-label" asp-for="Emergency.EmergencyContactAddress">Address</label>
                            <textarea asp-for="Emergency.EmergencyContactAddress" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <footer class="step-foot">
                        <span class="step-count">Step 5 of 6</span>
                        <div class="step-actions">
                            <button type="button" class="btn-back" data-prev><i class="bi bi-arrow-left"></i> Back</button>
                            <button type="button" class="btn-next" data-next>Next <i class="bi bi-arrow-right"></i></button>
                        </div>
                    </footer>
                </section>

                <!-- STEP 6 — Review & Submit -->
                <section class="form-step" data-step="6">
                    <header class="step-head">
                        <h2><i class="bi bi-clipboard-check"></i> Review &amp; Submit</h2>
                        <p>Check every section before submitting. Click <em>Edit</em> to jump back and make changes.</p>
                    </header>

                    <div id="reviewPanel" class="review-panel"><!-- built by JS --></div>

                    <div class="confirm-row">
                        <input class="form-check-input" type="checkbox" id="confirmAccurate" />
                        <label class="form-check-label" for="confirmAccurate">
                            I confirm the information above is accurate to the best of my knowledge.
                        </label>
                    </div>
                    <div class="field-error" id="confirmError"></div>

                    <footer class="step-foot">
                        <span class="step-count">Step 6 of 6</span>
                        <div class="step-actions">
                            <button type="button" class="btn-back" data-prev><i class="bi bi-arrow-left"></i> Back</button>
                            <a asp-action="Index" class="btn-cancel">Cancel</a>
                            <button type="submit" class="btn-save" id="saveBtn">
                                <i class="bi bi-check2"></i> Save Changes
                            </button>
                        </div>
                    </footer>
                </section>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            "use strict";

            var form = document.getElementById("studentForm");
            if (!form) return;

            var steps = Array.prototype.slice.call(form.querySelectorAll(".form-step"));
            var navItems = Array.prototype.slice.call(form.querySelectorAll(".step-item"));
            var TOTAL = steps.length;
            var current = 1;

            /* ---------- step navigation ---------- */
            function showStep(n) {
                if (n < 1) n = 1;
                if (n > TOTAL) n = TOTAL;
                current = n;

                steps.forEach(function (s) {
                    s.classList.toggle("is-active", Number(s.dataset.step) === n);
                });

                navItems.forEach(function (b) {
                    var i = Number(b.dataset.goto);
                    b.classList.toggle("is-active", i === n);
                    b.classList.toggle("is-done", i < n);
                });

                if (n === TOTAL) buildReview();

                var page = document.querySelector(".edit-page");
                if (page) page.scrollIntoView({ behavior: "smooth", block: "start" });
            }

            form.addEventListener("click", function (e) {
                if (e.target.closest("[data-next]")) { showStep(current + 1); }
                else if (e.target.closest("[data-prev]")) { showStep(current - 1); }
                else {
                    var jump = e.target.closest(".step-item");
                    if (jump) showStep(Number(jump.dataset.goto));
                }
            });

            /* ---------- completion meter ---------- */
            var bar = document.getElementById("completionBar");
            var valueEl = document.getElementById("completionValue");

            function trackedFields() {
                return Array.prototype.slice.call(
                    form.querySelectorAll("input:not([type=hidden]):not([type=checkbox]), select, textarea")
                );
            }

            function updateCompletion() {
                var all = trackedFields();
                if (!all.length) return;
                var filled = all.filter(function (el) { return String(el.value || "").trim() !== ""; }).length;
                var pct = Math.round((filled / all.length) * 100);
                if (bar) bar.style.width = pct + "%";
                if (valueEl) valueEl.textContent = pct + "%";
            }

            form.addEventListener("input", updateCompletion);
            form.addEventListener("change", updateCompletion);

            /* ---------- contact rows ---------- */
            var CONTACT_TYPES = [
                "Office Telephone", "Office Mobile Phone", "Home Telephone",
                "Home Mobile Phone", "Personal Mobile Phone"
            ];

            form.addEventListener("click", function (e) {
                var addBtn = e.target.closest("[data-add-contact]");
                if (addBtn) {
                    var container = document.getElementById(addBtn.dataset.addContact);
                    var prefix = addBtn.dataset.prefix;
                    if (!container) return;
                    var index = container.querySelectorAll(".contact-row").length;

                    var opts = '<option value="">Select type</option>' +
                        CONTACT_TYPES.map(function (t) { return '<option value="' + t + '">' + t + '</option>'; }).join("");

                    var row = document.createElement("div");
                    row.className = "contact-row";
                    row.innerHTML =
                        '<input name="' + prefix + '[' + index + '].Number" class="form-control contact-number" placeholder="Number" />' +
                        '<select name="' + prefix + '[' + index + '].Label" class="form-select contact-label">' + opts + '</select>' +
                        '<button type="button" class="btn-remove remove-contact" title="Remove number"><i class="bi bi-trash3"></i></button>';
                    container.appendChild(row);
                    updateCompletion();
                    return;
                }

                var rm = e.target.closest(".remove-contact");
                if (rm) {
                    var list = rm.closest(".contact-list");
                    var row2 = rm.closest(".contact-row");
                    if (row2) row2.remove();
                    if (list) reindexContacts(list);
                    updateCompletion();
                }
            });

            // Model binding needs contiguous indexes (0,1,2...) after a removal.
            function reindexContacts(list) {
                Array.prototype.slice.call(list.querySelectorAll(".contact-row")).forEach(function (row, i) {
                    row.querySelectorAll("[name]").forEach(function (el) {
                        el.name = el.name.replace(/\[\d+\]/, "[" + i + "]");
                    });
                });
            }

            /* ---------- review builder ---------- */
            function readValue(el) {
                if (!el) return "";
                if (el.tagName === "SELECT") {
                    var o = el.options[el.selectedIndex];
                    return o && o.value ? o.text.trim() : "";
                }
                return String(el.value || "").trim();
            }

            function buildReview() {
                var panel = document.getElementById("reviewPanel");
                if (!panel) return;
                panel.innerHTML = "";

                steps.forEach(function (step) {
                    var n = Number(step.dataset.step);
                    if (n === TOTAL) return;

                    var titleEl = step.querySelector(".step-head h2");
                    var block = document.createElement("div");
                    block.className = "review-block";

                    var head = document.createElement("div");
                    head.className = "review-head";
                    head.innerHTML = '<span>' + (titleEl ? titleEl.textContent.trim() : "Section " + n) + '</span>';

                    var edit = document.createElement("button");
                    edit.type = "button";
                    edit.className = "review-edit";
                    edit.textContent = "Edit";
                    edit.addEventListener("click", function () { showStep(n); });
                    head.appendChild(edit);
                    block.appendChild(head);

                    var body = document.createElement("div");
                    body.className = "review-body";

                    step.querySelectorAll("[data-label], [data-contact-group]").forEach(function (holder) {
                        var label, value;

                        if (holder.hasAttribute("data-contact-group")) {
                            label = holder.getAttribute("data-contact-group");
                            var parts = [];
                            holder.querySelectorAll(".contact-row").forEach(function (r) {
                                var num = readValue(r.querySelector(".contact-number"));
                                var typ = readValue(r.querySelector(".contact-label"));
                                if (num) parts.push(typ ? num + " (" + typ + ")" : num);
                            });
                            value = parts.join(", ");
                        } else {
                            label = holder.getAttribute("data-label");
                            value = readValue(holder.querySelector("input, select, textarea"));
                        }

                        var item = document.createElement("div");
                        item.className = "review-item";
                        item.innerHTML =
                            '<div class="review-label"></div>' +
                            (value ? '<div class="review-value"></div>' : '<div class="review-value is-empty">Not provided</div>');
                        item.querySelector(".review-label").textContent = label;
                        if (value) item.querySelector(".review-value").textContent = value;
                        body.appendChild(item);
                    });

                    block.appendChild(body);
                    panel.appendChild(block);
                });
            }

            /* ---------- submit guard ---------- */
            form.addEventListener("submit", function (e) {
                var box = document.getElementById("confirmAccurate");
                var err = document.getElementById("confirmError");
                if (box && !box.checked) {
                    e.preventDefault();
                    if (err) err.textContent = "Please confirm the information is accurate before saving.";
                    showStep(TOTAL);
                    return;
                }
                if (err) err.textContent = "";
            });

            /* ---------- land on the first step with a server-side error ---------- */
            var summary = document.getElementById("serverErrors");
            if (summary && summary.querySelector("li")) summary.classList.remove("d-none");

            var firstBad = form.querySelector(".field-error.field-validation-error, .input-validation-error");
            if (firstBad) {
                var owner = firstBad.closest(".form-step");
                if (owner) { showStep(Number(owner.dataset.step)); }
            } else {
                showStep(1);
            }

            updateCompletion();
        })();
    </script>
}
