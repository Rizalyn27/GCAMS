@model GCAMS.Models.AnecRecs.AnecRecs

@{
    ViewData["Title"] = "Create Anecdotal Record";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700&display=swap');

    .form-wrapper {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
    }

    .form-sidebar {
        width: 200px;
        flex-shrink: 0;
        position: sticky;
        top: 1rem;
    }

        .form-sidebar .nav-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-family: Inter;
            color: #555;
            text-decoration: none;
            margin-bottom: 4px;
            transition: background 0.15s;
        }

            .form-sidebar .nav-link:hover {
                background: #f0f0f0;
                color: #222;
            }

            .form-sidebar .nav-link.active {
                background: #e8f5e9;
                color: #1b6d24;
                font-weight: 500;
            }

            .form-sidebar .nav-link i {
                font-size: 16px;
            }

    .form-content {
        flex: 1;
        min-width: 0;
    }

    .form-section {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .form-section-title {
        font-size: 18px;
        font-weight: 700;
        font-family: 'Manrope', sans-serif;
        color: #111;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .form-section-title i {
            font-size: 18px;
            color: #1b6d24;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

        .form-grid .full-width {
            grid-column: 1 / -1;
        }

    .field-label {
        font-size: 13px;
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        color: #6b7280;
        margin-bottom: 4px;
        display: block;
    }

    .form-control, .form-select {
        font-size: 14px;
        font-family: 'Inter', sans-serif;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        padding: 8px 12px;
        width: 100%;
        color: #111;
    }

        .form-control:focus, .form-select:focus {
            border-color: #1b6d24;
            outline: none;
            box-shadow: 0 0 0 3px rgba(27, 109, 36, 0.1);
        }

    .form-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-top: 1px solid #e5e7eb;
        margin-top: 1rem;
    }

    .btn-cancel {
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        padding: 9px 20px;
        font-size: 14px;
        color: #374151;
        cursor: pointer;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #f9fafb;
            color: #374151;
        }

    .btn-save {
        background: #1b6d24;
        border: none;
        border-radius: 8px;
        padding: 9px 20px;
        font-size: 14px;
        color: #fff;
        cursor: pointer;
    }

        .btn-save:hover {
            background: #155a1e;
        }

    @@media (max-width: 768px) {
        .form-wrapper {
            flex-direction: column;
        }

        .form-sidebar {
            width: 100%;
            position: static;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    body {
        font-family: 'Inter', sans-serif;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Manrope', sans-serif;
    }
</style>

<h1>Create Anecdotal Record</h1>

<div class="form-wrapper">

    <!-- Sidebar -->
    <div class="form-sidebar">
        <a href="#observation" class="nav-link active">
            <i class="bi bi-calendar-event"></i> Observation Info
        </a>
        <a href="#details" class="nav-link">
            <i class="bi bi-geo-alt"></i> Observation Details
        </a>
        <a href="#behavior" class="nav-link">
            <i class="bi bi-clipboard2-pulse"></i> Behavior &amp; Recommendations
        </a>
    </div>

    <!-- Form Content -->
    <form asp-action="Create" method="post" class="form-content">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="StudentsID" />
        <input type="hidden" name="studentId" value="@ViewBag.StudentsID" />

        <!-- Observation Info -->
        <div class="form-section" id="observation">
            <div class="form-section-title">
                <i class="bi bi-calendar-event"></i> Observation Info
            </div>
            <div class="form-grid">
                <div class="full-width">
                    <label class="field-label">Full Name</label>
                    <input asp-for="StuName" class="form-control" />
                    <span asp-validation-for="StuName" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div>
                    <label class="field-label">Record No.</label>
                    <input asp-for="AnecRecNo" readonly class="form-control" />
                    <span asp-validation-for="AnecRecNo" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div>
                    <label class="field-label">Date of Observation</label>
                    <input asp-for="DateOfObserv" class="form-control" />
                    <span asp-validation-for="DateOfObserv" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="full-width">
                    <label class="field-label">Observed By</label>
                    <input asp-for="ObservedBy" class="form-control" />
                    <span asp-validation-for="ObservedBy" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
        </div>

        <!-- Observation Details -->
        <div class="form-section" id="details">
            <div class="form-section-title">
                <i class="bi bi-geo-alt"></i> Observation Details
            </div>
            <div class="form-grid">
                <div class="full-width">
                    <label class="field-label">Place</label>
                    <input asp-for="Place" class="form-control" />
                    <span asp-validation-for="Place" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="full-width">
                    <label class="field-label">People Involved</label>
                    <input asp-for="PeopleInvolved" class="form-control" />
                    <span asp-validation-for="PeopleInvolved" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="full-width">
                    <label class="field-label">Scene / Mood</label>
                    <input asp-for="SceneMood" class="form-control" />
                    <span asp-validation-for="SceneMood" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
        </div>

        <!-- Behavior & Recommendations -->
        <div class="form-section" id="behavior">
            <div class="form-section-title">
                <i class="bi bi-clipboard2-pulse"></i> Behavior &amp; Recommendations
            </div>
            <div class="form-grid">
                <div class="full-width">
                    <label class="field-label">Student Behavior</label>
                    <input asp-for="StudentBehavior" class="form-control" />
                    <span asp-validation-for="StudentBehavior" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="full-width">
                    <label class="field-label">Observer Recommendations</label>
                    <input asp-for="ObserverRecs" class="form-control" />
                    <span asp-validation-for="ObserverRecs" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="form-footer">
            <small class="text-muted">🔒 Privacy Protected • Sys.Logged</small>
            <div style="display:flex; gap:10px;">
                <a asp-controller="Students" asp-action="Details" asp-route-id="@ViewBag.StudentsID" class="btn-cancel">Cancel</a>
                <input type="submit" value="Save Record" class="btn-save" />
            </div>
        </div>

    </form>
</div>

<script>
    const links = document.querySelectorAll('.form-sidebar .nav-link');
    const sections = document.querySelectorAll('.form-section');

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                links.forEach(l => l.classList.remove('active'));
                const active = document.querySelector(`.nav-link[href="#${entry.target.id}"]`);
                if (active) active.classList.add('active');
            }
        });
    }, { threshold: 0.3 });

    sections.forEach(s => observer.observe(s));

    links.forEach(link => {
        link.addEventListener('click', e => {
            e.preventDefault();
            document.querySelector(link.getAttribute('href')).scrollIntoView({ behavior: 'smooth' });
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}