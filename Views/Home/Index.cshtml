@{
    var popups = ViewBag.UnreadAnnouncements as List<GCAMS.Models.Notifs.Notifs>;
}

<style>
    .gc-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(10, 31, 26, 0.55);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .gc-modal {
        background: #f7f9f4;
        border-radius: 16px;
        max-width: 480px;
        width: 100%;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
        font-family: 'Inter', sans-serif;
    }

    .gc-modal-head {
        padding: 22px 24px 16px;
        border-bottom: 1px solid #e1e4db;
        flex-shrink: 0;
        background: #fff;
        border-radius: 16px 16px 0 0;
    }

        .gc-modal-head h3 {
            margin: 0;
            font-family: 'Manrope', sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: #191d18;
        }

    /* ---------- one box per item ---------- */
    .gc-modal-body {
        overflow-y: auto;
        padding: 16px 24px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .gc-popup-item {
        background: #fff;
        border: 1px solid #e1e4db;
        border-left: 3px solid #1a7f74;
        border-radius: 12px;
        padding: 14px 16px;
    }

    .gc-popup-item-appointment {
        border-left-color: #c99a3a;
    }

    .gc-popup-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 6px;
    }

    .gc-popup-title {
        font-family: 'Manrope', sans-serif;
        font-size: 15px;
        font-weight: 700;
        color: #191d18;
        margin: 0;
    }

    .gc-popup-tag {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-radius: 20px;
        padding: 3px 9px;
        white-space: nowrap;
        flex-shrink: 0;
        color: #14655c;
        background: #e6f2f0;
    }

    .gc-popup-tag-appointment {
        color: #8a5a00;
        background: #fdf1d6;
    }

    .gc-popup-message {
        margin: 0 0 8px;
        color: #41493e;
        line-height: 1.55;
        font-size: 14px;
        white-space: pre-wrap;
    }

    .gc-popup-time {
        display: block;
        color: #a3aa9e;
        font-size: 12px;
    }

    .gc-modal-foot {
        padding: 16px 24px 22px;
        border-top: 1px solid #e1e4db;
        flex-shrink: 0;
        background: #fff;
        border-radius: 0 0 16px 16px;
    }

    .gc-modal-dismiss {
        width: 100%;
        background: #1a7f74;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 12px;
        font-size: 14px;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
    }

        .gc-modal-dismiss:hover {
            background: #14655c;
        }
</style>

@if (User.IsInRole("Admin") && ViewBag.AdminDashboard is GCAMS.ViewModels.AdminDashboardViewModel adminVm)
{
    @await Html.PartialAsync("_AdminDashboard", adminVm)
}
else if (User.IsInRole("Counselor") && ViewBag.CounselorDashboard is GCAMS.ViewModels.CounselorDashboardViewModel counselorVm)
{
    @await Html.PartialAsync("_CounselorDashboard", counselorVm)
}
else if (User.IsInRole("Student"))
{
    <p>Welcome! Use the sidebar to book an appointment or view your upcoming sessions.</p>

    @* The feed lives here, inside the student branch. Students have no dashboard
       and no bell menu, so this is their only view of announcements and updates. *@
    @await Html.PartialAsync("_ActivityFeed")
}

@if (popups != null && popups.Any())
{
    <div class="gc-modal-backdrop">
        <div class="gc-modal">
            <div class="gc-modal-head">
                <h3>
                    You have @popups.Count unread @(popups.Count == 1 ? "notification" : "notifications")
                </h3>
            </div>

            <div class="gc-modal-body">
                @foreach (var item in popups)
                {
                    var isAnnouncement = item.Type == GCAMS.Models.Notifs.NotificationType.Announcement;

                    <div class="gc-popup-item @(isAnnouncement ? "" : "gc-popup-item-appointment")">
                        <div class="gc-popup-head">
                            <h4 class="gc-popup-title">@item.Title</h4>
                            <span class="gc-popup-tag @(isAnnouncement ? "" : "gc-popup-tag-appointment")">
                                @(isAnnouncement ? "Announcement" : "Appointment Today")
                            </span>
                        </div>
                        <p class="gc-popup-message">@item.Message</p>
                        <small class="gc-popup-time">@item.CreatedAt.ToString("MMM dd, yyyy - h:mm tt")</small>
                    </div>
                }
            </div>

            <div class="gc-modal-foot">
                <form asp-controller="Notifications" asp-action="MarkAllRead" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Home")" />
                    <button type="submit" class="gc-modal-dismiss">Dismiss</button>
                </form>
            </div>
        </div>
    </div>
}
