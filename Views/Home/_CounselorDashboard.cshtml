@model GCAMS.ViewModels.CounselorDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var now = DateTime.Now;
    var hour = now.Hour;
    var partOfDay = hour < 12 ? "morning" : hour < 18 ? "afternoon" : "evening";
    var greetName = string.IsNullOrWhiteSpace(Model.CounselorName) ? "there" : Model.CounselorName;

    // Everything below is derived from TodaysAppointments — no new model fields.
    var doneToday = Model.TodaysAppointments.Count(a => a.Status == "Completed");
    var missedToday = Model.TodaysAppointments.Count(a => a.Status == "Missed");
    var laterToday = Model.TodaysAppointments.Count(a =>
        a.Status != "Completed" && a.Status != "Missed" && a.AppointmentDate > now);

    var nextAppointment = Model.TodaysAppointments
        .Where(a => a.Status != "Completed" && a.Status != "Missed" && a.AppointmentDate > now)
        .OrderBy(a => a.AppointmentDate)
        .FirstOrDefault();

    var minutesToNext = nextAppointment == null
        ? 0
        : (int)Math.Round((nextAppointment.AppointmentDate - now).TotalMinutes);

    var sessionWord = Model.SessionsTodayCount == 1 ? "session" : "sessions";
    var followUpWord = Model.FlaggedCases.Count == 1 ? "follow-up that's" : "follow-ups that are";
}

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Home/CounselorDashboard.css" asp-append-version="true" />

<div class="cns-dash">

    <header class="dash-head">
        <div class="dash-head-main">
            <h1>Good @partOfDay, @greetName</h1>
            <p class="subtitle">
                @if (Model.SessionsTodayCount == 0 && !Model.FlaggedCases.Any())
                {
                    <text>Nothing scheduled and nothing overdue.</text>
                }
                else
                {
                    <text>@Model.SessionsTodayCount @sessionWord today</text>
                    @if (Model.FlaggedCases.Any())
                    {
                        <text> and @Model.FlaggedCases.Count @followUpWord past due</text>
                    }
                    <text>.</text>
                }
                @now.ToString("dddd, d MMMM yyyy").
            </p>
        </div>

        @if (nextAppointment != null)
        {
            <div class="dash-head-now">
                <span class="live-dot"></span>
                @now.ToString("h:mm tt") ·
                @if (minutesToNext < 60)
                {
                    <text>next session in @minutesToNext min</text>
                }
                else
                {
                    <text>next session at @nextAppointment.AppointmentDate.ToString("h:mm tt")</text>
                }
            </div>
        }
    </header>

    <!-- ============================ STAT CARDS ============================ -->
    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-label">
                <span class="material-symbols-outlined"></span>
                Sessions today
            </div>
            <div class="stat-value">@Model.SessionsTodayCount</div>
            <div class="stat-note">
                @if (Model.SessionsTodayCount == 0)
                {
                    <text>Nothing scheduled today</text>
                }
                else
                {
                    var parts = new List<string>();
                    if (doneToday > 0) { parts.Add($"{doneToday} done"); }
                    if (laterToday > 0) { parts.Add($"{laterToday} later"); }
                    if (missedToday > 0) { parts.Add($"{missedToday} missed"); }
                    @(parts.Any() ? string.Join(" · ", parts) : "All wrapped up")
                }
            </div>
            @if (Model.SessionsTodayCount > 0)
            {
                <a href="#todays-schedule" class="stat-action">
                    Open today <span class="material-symbols-outlined"></span>
                </a>
            }
        </div>

        <div class="stat-card @(Model.PendingRequestsCount > 0 ? "stat-card-attention" : "")">
            <div class="stat-label">
                <span class="material-symbols-outlined"></span>
                Requests to answer
            </div>
            <div class="stat-value">@Model.PendingRequestsCount</div>
            <div class="stat-note @(Model.PendingRequestsCount > 0 ? "stat-note-warn" : "")">
                @(Model.PendingRequestsCount > 0 ? "Waiting on your decision" : "All caught up")
            </div>
            @if (Model.PendingRequestsCount > 0)
            {
                <a asp-controller="Appointments" asp-action="Index" class="stat-action">
                    Review requests <span class="material-symbols-outlined"></span>
                </a>
            }
        </div>

        <div class="stat-card @(Model.FlaggedCases.Any() ? "stat-card-attention" : "")">
            <div class="stat-label">
                <span class="material-symbols-outlined"></span>
                Follow-ups overdue
            </div>
            <div class="stat-value">@Model.FlaggedCases.Count</div>
            <div class="stat-note @(Model.FlaggedCases.Any() ? "stat-note-warn" : "")">
                @if (!Model.FlaggedCases.Any())
                {
                    <text>Nothing overdue</text>
                }
                else if (Model.FlaggedCases.Count == 1)
                {
                    @Model.FlaggedCases.First().StudentName
                }
                else
                {
                    @($"{Model.FlaggedCases.First().StudentName} and {Model.FlaggedCases.Count - 1} more")
                }
            </div>
            @if (Model.FlaggedCases.Any())
            {
                <a href="#flagged-followups" class="stat-action">
                    See follow-ups <span class="material-symbols-outlined"></span>
                </a>
            }
        </div>

    </div>

    <div class="lower-grid">

        <!-- ========================= LEFT COLUMN ========================= -->
        <div class="dash-col">

            <!-- Today's schedule -->
            <div class="panel" id="todays-schedule">
                <div class="section-title">
                    <span>
                        Today's schedule
                        <span class="count-pill">@Model.TodaysAppointments.Count</span>
                    </span>
                    <a asp-controller="Appointments" asp-action="Index" class="row-link">
                        Open the calendar <span class="material-symbols-outlined"></span>
                    </a>
                </div>
                <p class="panel-sub">@now.ToString("dddd, d MMMM")</p>

                @if (Model.TodaysAppointments.Any())
                {
                    var nowMarkerShown = false;
                    var index = 0;

                    foreach (var appt in Model.TodaysAppointments.OrderBy(a => a.AppointmentDate))
                    {
                        var statusClass = appt.Status switch
                        {
                            "Confirmed" => "status-confirmed",
                            "Pending" => "status-pending",
                            "Completed" => "status-completed",
                            "Missed" => "status-missed",
                            _ => "status-pending"
                        };

                        if (!nowMarkerShown && index > 0 && appt.AppointmentDate > now)
                        {
                            nowMarkerShown = true;
                            <div class="now-marker"><span>Now @now.ToString("h:mm tt")</span></div>
                        }
                        index++;

                        <div class="slot" data-appt="@appt.AppointmentId">
                            <div class="slot-time">
                                <span class="slot-hour">@appt.AppointmentDate.ToString("h:mm")</span>
                                <span class="slot-ampm">@appt.AppointmentDate.ToString("tt")</span>
                            </div>

                            <div class="slot-card @statusClass">
                                <div class="slot-body">
                                    <div class="slot-name">
                                        @appt.FullName
                                        @if (appt.IsUnassigned)
                                        {
                                            <span class="tag-unassigned">Unassigned</span>
                                        }
                                    </div>
                                    <div class="slot-meta">
                                        @appt.AppointmentType · @appt.Status
                                    </div>
                                </div>

                                @if (appt.Status != "Completed" && appt.Status != "Missed")
                                {
                                    <div class="slot-actions">
                                        @if (appt.StudentsID.HasValue)
                                        {
                                            <a class="btn-slot"
                                               asp-controller="CaseNotes" asp-action="Create"
                                               asp-route-studentId="@appt.StudentsID">Log session</a>
                                        }
                                        <button type="button" class="row-action"
                                                onclick="gcamsSetStatus(@appt.AppointmentId, 'Completed', this)">
                                            Mark completed
                                        </button>
                                        <button type="button" class="row-action row-action-muted"
                                                onclick="gcamsSetStatus(@appt.AppointmentId, 'Missed', this)">
                                            Mark missed
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-note">
                        Nothing booked today.
                        <a asp-controller="Appointments" asp-action="Index">Open the appointment calendar</a>
                        to add one.
                    </div>
                }
            </div>

            <!-- Top concerns -->
            <div class="panel" id="top-concerns">
                <div class="section-title">What students are coming in for</div>
                @{
                    var concernTotal = Model.TopConcerns.Any() ? Model.TopConcerns.Sum(c => c.Count) : 0;
                    var uncategorised = Math.Max(0, Model.SessionsInPeriod - concernTotal);
                }
                <p class="panel-sub">
                    Your sessions in @Model.PeriodLabel, by category
                    @if (Model.TopConcerns.Any())
                    {
                        <text> · @concernTotal categorised of @Model.SessionsInPeriod</text>
                    }
                </p>

                @if (Model.TopConcerns.Any())
                {
                    var concernMax = Model.TopConcerns.Max(c => c.Count);
                    var lead = Model.TopConcerns.First();

                    foreach (var c in Model.TopConcerns)
                    {
                        var pct = Math.Max(3, (int)(100.0 * c.Count / concernMax));
                        <div class="concern-row">
                            <div class="concern-head">
                                <span class="concern-label" title="@c.Category">@c.Category</span>
                                <span class="concern-count">@c.Count</span>
                            </div>
                            <div class="concern-track">
                                <div class="concern-fill @(c == lead ? "is-dominant" : "")" style="width:@(pct)%;"></div>
                            </div>
                        </div>
                    }

                    if (uncategorised > 0)
                    {
                        <p class="panel-foot">
                            @uncategorised session@(uncategorised == 1 ? "" : "s") @(uncategorised == 1 ? "has" : "have")
                            no category yet. Categories are set when a case note is saved.
                        </p>
                    }
                }
                else
                {
                    <div class="empty-note">
                        No categorised sessions yet for @Model.PeriodLabel.
                        Concerns appear here once case notes are saved with a category.
                    </div>
                }
            </div>

            <!-- Session history -->
            <div class="panel" id="session-history">
                <div class="section-title">Your session history</div>
                <p class="panel-sub">How many sessions you held each month</p>

                <form method="get" asp-action="Index" class="filter-bar">
                    <div class="filter-field">
                        <label for="ay-select">Academic year</label>
                        <select id="ay-select" name="academicYear">
                            @foreach (var ay in Model.AcademicYearOptions)
                            {
                                if (ay == Model.SelectedAcademicYear)
                                {
                                    <option value="@ay" selected>@ay</option>
                                }
                                else
                                {
                                    <option value="@ay">@ay</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="filter-field">
                        <label for="month-select">Month</label>
                        <select id="month-select" name="month">
                            @if (Model.SelectedMonth == null)
                            {
                                <option value="" selected>All months</option>
                            }
                            else
                            {
                                <option value="">All months</option>
                            }
                            @for (int m = 1; m <= 12; m++)
                            {
                                var label = new DateTime(2000, m, 1).ToString("MMMM");
                                if (Model.SelectedMonth == m)
                                {
                                    <option value="@m" selected>@label</option>
                                }
                                else
                                {
                                    <option value="@m">@label</option>
                                }
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn-apply">Apply</button>
                    <a asp-action="Index" class="btn-reset">Reset</a>
                </form>

                <div class="showing-row">
                    <span class="showing-label">Showing</span>
                    <span class="chip">AY @Model.SelectedAcademicYear</span>
                    <span class="chip">
                        @(Model.SelectedMonth == null ? "All months" : new DateTime(2000, Model.SelectedMonth.Value, 1).ToString("MMMM"))
                    </span>
                    <span class="showing-count">· @Model.SessionsInPeriod session@(Model.SessionsInPeriod == 1 ? "" : "s")</span>
                </div>

                @{
                    var periodMax = Math.Max(1, Model.PeriodChartCounts.DefaultIfEmpty(0).Max());
                }
                <div class="bar-chart">
                    @for (int i = 0; i < Model.PeriodChartCounts.Count; i++)
                    {
                        var count = Model.PeriodChartCounts[i];
                        var pct = count == 0 ? 0 : Math.Max(6, (int)(100.0 * count / periodMax));
                        var isPeak = count > 0 && count == periodMax;

                        <div class="bar-col">
                            <span class="bar-value @(count == 0 ? "is-zero" : "")">@count</span>
                            <div class="bar-slot">
                                @if (count == 0)
                                {
                                    <div class="bar is-zero"></div>
                                }
                                else
                                {
                                    <div class="bar" style="height:@(pct)%;" title="@count sessions"></div>
                                }
                            </div>
                            <span class="bar-label @(isPeak ? "is-peak" : "")">@Model.PeriodChartLabels[i]</span>
                        </div>
                    }
                </div>

                <p class="panel-foot">Months with a flat line had no sessions.</p>
            </div>
        </div>

        <!-- ========================= RIGHT COLUMN ========================= -->
        <div class="dash-col">

            <!-- Start a task -->
            <div class="panel">
                <div class="section-title">Start a task</div>
                <p class="panel-sub">Pick the student first, then the form opens filled in</p>

                <div class="task-block">
                    <div class="task-name">Write a case note</div>
                    <div class="task-hint">Private record of what was discussed in a session.</div>
                    <div class="picker-row">
                        <input type="text" id="student-picker" list="student-options"
                               placeholder="Type a name or ID no" autocomplete="off"
                               aria-label="Find a student to log a session for">
                        <button type="button" class="btn-go" onclick="gcamsLogSession()">Open</button>
                    </div>
                </div>

                <div class="task-block">
                    <div class="task-name">Record an observation</div>
                    <div class="task-hint">Short anecdotal entry no session needed.</div>
                    <div class="picker-row">
                        <input type="text" id="observation-picker" list="student-options"
                               placeholder="Type a name or LRN" autocomplete="off"
                               aria-label="Find a student to record an observation for">
                        <button type="button" class="btn-go" onclick="gcamsRecordObservation()">Open</button>
                    </div>
                </div>

                <datalist id="student-options">
                    @foreach (var s in Model.StudentPicker)
                    {
                        <option value="@s.Label" data-id="@s.StudentsID"></option>
                    }
                </datalist>

                <a class="quick-action" asp-controller="Announcements" asp-action="Create">
                    <span class="material-symbols-outlined"></span> Post an announcement
                </a>
            </div>

            <!-- Flagged follow-ups -->
            <div class="panel" id="flagged-followups">
                <div class="section-title">
                    <span>
                        Flagged follow-ups
                        @if (Model.FlaggedCases.Any())
                        {
                            <span class="count-pill count-pill-warn">@Model.FlaggedCases.Count</span>
                        }
                    </span>
                </div>
                <p class="panel-sub">Sessions marked for a follow-up that's now past due</p>

                @if (Model.FlaggedCases.Any())
                {
                    foreach (var fc in Model.FlaggedCases)
                    {
                        <div class="flagged-item">
                            <div class="flagged-name">@fc.StudentName</div>
                            <div class="flagged-meta">
                                Due @fc.FollowUpDate.ToString("MMM d") ·
                                @fc.DaysOverdue day@(fc.DaysOverdue == 1 ? "" : "s") overdue
                            </div>
                            <div class="row-actions">
                                @if (fc.StudentsID.HasValue)
                                {
                                    <a class="row-action"
                                       asp-controller="CaseNotes" asp-action="Create"
                                       asp-route-studentId="@fc.StudentsID">Log session</a>
                                    <a class="row-action"
                                       asp-controller="Students" asp-action="Details"
                                       asp-route-id="@fc.StudentsID">Open record</a>
                                }
                                <button type="button" class="row-action row-action-muted"
                                        onclick="gcamsSetStatus(@fc.AppointmentId, 'Completed', this)">
                                    Mark handled
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-note">No overdue follow-ups.</div>
                }
            </div>

            <!-- Recent observations -->
            <div class="panel" id="recent-observations">
                <div class="section-title">Recent observations</div>
                <p class="panel-sub">Short notes you logged outside a formal session</p>

                @if (Model.RecentObservations.Any())
                {
                    foreach (var o in Model.RecentObservations)
                    {
                        <div class="obs-item">
                            <div class="obs-name">
                                @o.StudentName
                                @if (o.IsRepeat)
                                {
                                    <span class="tag-repeat">Repeat</span>
                                }
                            </div>
                            <div class="obs-meta">@o.DateOfObserv.ToString("MMM d") · @o.Place</div>
                            <div class="obs-text">@o.Behavior</div>
                            <div class="row-actions">
                                <a class="row-action"
                                   asp-controller="Students" asp-action="Details"
                                   asp-route-id="@o.StudentsID">Open record</a>
                                <a class="row-action"
                                   asp-controller="CaseNotes" asp-action="Create"
                                   asp-route-studentId="@o.StudentsID">Log session</a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="obs-empty">
                        <span class="material-symbols-outlined"></span>
                        <div class="obs-empty-title">No observations yet this year</div>
                        <a class="btn-solid" asp-controller="AnecRecs" asp-action="Create">Record your first observation</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Update an appointment's status from the dashboard, then drop the row.
        async function gcamsSetStatus(appointmentId, newStatus, btn) {
            const actions = btn.parentElement.querySelectorAll('button');
            actions.forEach(b => b.disabled = true);

            try {
                const res = await fetch('/Appointments/UpdateStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ AppointmentId: appointmentId, NewStatus: newStatus })
                });

                if (!res.ok) throw new Error(await res.text());

                const row = btn.closest('.flagged-item, .slot');
                row.style.transition = 'opacity .2s';
                row.style.opacity = '0';
                setTimeout(() => { row.remove(); }, 200);
            } catch (err) {
                actions.forEach(b => b.disabled = false);
                alert('Could not update that appointment. Please try again.');
            }
        }

        // Resolve the picker text back to a student id, then open the case note form.
        function gcamsLogSession() {
            const input = document.getElementById('student-picker');
            const match = Array.from(document.querySelectorAll('#student-options option'))
                .find(o => o.value === input.value);

            if (!match) {
                input.focus();
                alert('Pick a student from the list first.');
                return;
            }

            window.location.href = '/CaseNotes/Create?studentId=' + match.dataset.id;
        }

        // Same, for the anecdotal record form.
        function gcamsRecordObservation() {
            const input = document.getElementById('observation-picker');
            const match = Array.from(document.querySelectorAll('#student-options option'))
                .find(o => o.value === input.value);

            if (!match) {
                input.focus();
                alert('Pick a student from the list first.');
                return;
            }

            window.location.href = '/AnecRecs/Create?studentId=' + match.dataset.id;
        }
    </script>
}
