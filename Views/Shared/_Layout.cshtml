@{
    var isStudent = User.Identity?.IsAuthenticated == true && User.IsInRole("Student");
    var isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("Admin");
    var isCounselor = User.Identity?.IsAuthenticated == true && User.IsInRole("Counselor");

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVC_DenoyJabines</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="@(Url.Content("~/lib/bootstrap/dist/css/bootstrap.min.css"))" />
    <link rel="stylesheet" href="@(Url.Content("~/css/site.css"))" />
    <link rel="stylesheet" href="@(Url.Content("~/MVC_DenoyJabines.styles.css"))" />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --sidebar-bg: #1B5E20;
            --sidebar-hover: #0f2e27;
            --sidebar-active: #133d32;
            --sidebar-border: rgba(255,255,255,0.06);
            --sidebar-text: #ffffff;
            --sidebar-heading: #ffffff;
            --sidebar-label: #2e5248;
            --sidebar-width: 240px;
            --accent: #1a7f74;
            --accent-soft: rgba(26,127,116,0.18);
            --page-bg: #f0f7f4;
            --topbar-bg: #ffffff;
            --topbar-border: #d4ede6;
            --ink: #0a1f1a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--page-bg);
            color: var(--ink);
            overflow-x: hidden;
        }

        .layout-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .sidebar-account,
        .sidebar-logout {
            display: block;
            width: 100%;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 500;
            text-decoration: none;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s;
            margin-bottom: 6px;
            border: none;
        }

        .sidebar-account {
            background: rgba(59, 91, 219, 0.1);
            color: #3b5bdb;
        }

            .sidebar-account:hover {
                background: rgba(59, 91, 219, 0.2);
            }

        .sidebar-logout {
            background: rgba(229, 52, 74, 0.12);
            color: #e5344a;
            border: 1px solid rgba(229,52,74,0.25);
        }

            .sidebar-logout:hover {
                background: #e5344a;
                color: #ffffff;
                border-color: #e5344a;
            }

        /* ── SIDEBAR ── */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            transition: transform .3s ease;
        }

        .sidebar-brand {
            padding: 24px 20px 20px;
            border-bottom: 1px solid var(--sidebar-border);
            margin-bottom: 8px;
        }

            .sidebar-brand h4 {
                font-family: Arial, Helvetica, sans-serif;
                font-size: 1.2rem;
                font-weight: 400;
                color: var(--sidebar-heading);
                margin: 0;
            }

            .sidebar-brand span {
                display: inline-block;
                margin-bottom: 6px;
                font-size: 0.65rem;
                font-weight: 700;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: var(--accent);
                background: var(--accent-soft);
                padding: 2px 8px;
                border-radius: 20px;
            }

        .sidebar-section-label {
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--sidebar-label);
            padding: 16px 20px 6px;
        }

        .sidebar-nav {
            list-style: none;
            padding: 0 10px;
            margin: 0;
        }

            .sidebar-nav li a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 12px;
                border-radius: 10px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 500;
                transition: all .18s;
                margin-bottom: 2px;
            }

                .sidebar-nav li a:hover {
                    background: var(--sidebar-hover);
                    color: #ffffff;
                }

                .sidebar-nav li a.active {
                    background: var(--sidebar-active);
                    color: #ffffff;
                    border-left: 3px solid var(--accent);
                }

        .sidebar-footer {
            margin-top: auto;
            padding: 16px 10px;
            border-top: 1px solid var(--sidebar-border);
        }

            .sidebar-footer form button {
                width: 100%;
                background: rgba(229,52,74,0.1);
                color: #f87171;
                border: 1px solid rgba(229,52,74,0.22);
                border-radius: 10px;
                padding: 10px;
                font-family: Arial, Helvetica, sans-serif;
                font-size: 0.82rem;
                font-weight: 600;
                cursor: pointer;
                transition: all .18s;
            }

                .sidebar-footer form button:hover {
                    background: #e5344a;
                    color: #ffffff;
                    border-color: #e5344a;
                }

        /* ── MAIN ── */
        .main-content {
            margin-left: var(--sidebar-width);
            flex: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: var(--topbar-bg);
            border-bottom: 1px solid var(--topbar-border);
            padding: 14px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .topbar-title {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 1.1rem;
            font-weight: 400;
            color: var(--ink);
        }

        .topbar-badge {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--accent);
            background: rgba(26,127,116,0.1);
            padding: 3px 10px;
            border-radius: 20px;
        }

        .sidebar-toggle {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            flex-direction: column;
            gap: 5px;
        }

            .sidebar-toggle span {
                display: block;
                width: 22px;
                height: 2px;
                background: var(--ink);
                border-radius: 2px;
            }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 99;
        }

            .sidebar-overlay.active {
                display: block;
            }

        .page-body {
            padding: 28px;
            flex: 1;
        }

        /* ── NOTIFICATION BELL ── */
        .notif-bell {
            position: relative;
            background: none;
            border: none;
            cursor: pointer;
        }

        .notif-badge {
            display: none;
            position: absolute;
            top: -4px;
            right: -4px;
            background: #93000a;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            border-radius: 999px;
            padding: 1px 6px;
        }

        .notif-dropdown {
            display: none;
            position: absolute;
            right: 0;
            top: 36px;
            width: 320px;
            max-height: 400px;
            overflow-y: auto;
            background: #fff;
            border: 1px solid #e1e4db;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.12);
            z-index: 1000;
            padding: 8px;
        }

        .notif-item {
            padding: 10px 12px;
            border-radius: 8px;
            cursor: pointer;
            margin-bottom: 4px;
        }

            .notif-item.unread {
                background: #f2f5ec;
            }

        .notif-title {
            font-weight: 600;
            font-size: 13px;
            color: #191d18;
        }

        .notif-message {
            font-size: 12px;
            color: #41493e;
            margin-top: 2px;
        }

        .notif-time {
            font-size: 11px;
            color: #a3aa9e;
            margin-top: 4px;
        }

        .notif-empty {
            padding: 16px;
            text-align: center;
            color: #717a6d;
            font-size: 13px;
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 900px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main-content {
                margin-left: 0;
            }

            .sidebar-toggle {
                display: flex;
            }
        }

        @@media (max-width: 500px) {
            .page-body {
                padding: 16px;
            }
        }

        .notif-filters {
            display: flex;
            gap: 6px;
            padding: 4px 4px 10px;
            border-bottom: 1px solid #f2f5ec;
            margin-bottom: 8px;
            flex-wrap: wrap;
        }

        .notif-filter-btn {
            background: none;
            border: 1px solid #e1e4db;
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 12px;
            color: #41493e;
            cursor: pointer;
        }

            .notif-filter-btn.active {
                background: #1b6d24;
                border-color: #1b6d24;
                color: #fff;
            }
    </style>
</head>
<body>

    <div class="layout-wrapper">

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <span>@(isStudent ? "Student" : "Counselor")</span>
            </div>
            <ul class="sidebar-nav">
                @if (isStudent)
                {
                    <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li><a asp-controller="Appointments" asp-action="Create">Book Appointment</a></li>
                    <li><a asp-controller="Appointments" asp-action="MyAppointments">My Appointments</a></li>

                }
                else if (isCounselor)
                {
                    <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li><a asp-controller="Students" asp-action="Index">Students</a></li>
                    <li><a asp-controller="Counselors" asp-action="Index">Counselors</a></li>
                    <li><a asp-controller="Appointments" asp-action="Index">Appointments</a></li>
                    <li><a asp-controller="Announcements" asp-action="Index">Announcements</a></li>
                }
                else if (isAdmin)
                {
                    <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li><a asp-controller="Students" asp-action="Index">Students</a></li>
                    <li><a asp-controller="Counselors" asp-action="Index">Counselors</a></li>
                    <li><a asp-controller="Appointments" asp-action="Index">Appointments</a></li>
                    <li><a asp-controller="Announcements" asp-action="Index">Announcements</a></li>
                }
            </ul>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-footer">
                    <form asp-controller="Users" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sidebar-logout">Logout</button>
                    </form>
                </div>
            }
        </aside>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <div class="main-content">
            <div class="topbar">
                <div style="display:flex;align-items:center;gap:14px;">
                    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle menu">
                        <span></span><span></span><span></span>
                    </button>
                    <div class="topbar-title">@ViewData["Title"]</div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div style="position:relative; display:inline-block;">
                        <button id="notif-bell" class="notif-bell">
                            <i class="fa-regular fa-bell" style="font-size:24px; color:#41493e;"></i>
                            <span id="notif-badge" class="notif-badge"></span>
                        </button>
                        <div id="notif-dropdown" class="notif-dropdown">
                            <div class="notif-filters">
                                <button class="notif-filter-btn active" data-filter="all">All</button>
                                <button class="notif-filter-btn" data-filter="Announcement">Announcements</button>
                                <button class="notif-filter-btn" data-filter="AppointmentReminder">Reminders</button>
                                <button class="notif-filter-btn" data-filter="StatusUpdate">Updates</button>
                            </div>
                            <div id="notif-list"></div>
                        </div>
                    </div>
                    <form style="display:none;">@Html.AntiForgeryToken()</form>
                }
            </div>

            <div class="page-body">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>

    </div>

    <script src="@(Url.Content("~/lib/jquery/dist/jquery.min.js"))"></script>
    <script src="@(Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"))"></script>
    <script src="@(Url.Content("~/js/site.js"))"></script>
    <script>
        const toggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        toggle.addEventListener('click', () => {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('active');
        });
        overlay.addEventListener('click', () => {
            sidebar.classList.remove('open');
            overlay.classList.remove('active');
        });
    </script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            const bell = document.getElementById('notif-bell');
            const dropdown = document.getElementById('notif-dropdown');
            const badge = document.getElementById('notif-badge');
            const list = document.getElementById('notif-list');
            const filterButtons = document.querySelectorAll('.notif-filter-btn');
            const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            let allNotifications = [];
            let activeFilter = 'all';

            function renderNotification(n) {
                return `
                    <div class="notif-item ${n.isRead ? '' : 'unread'}" onclick="markRead(${n.notificationId})">
                        <div class="notif-title">${n.title}</div>
                        <div class="notif-message">${n.message}</div>
                        <div class="notif-time">${new Date(n.createdAt).toLocaleString()}</div>
                    </div>`;
            }

            function renderList() {
                const filtered = activeFilter === 'all'
                    ? allNotifications
                    : allNotifications.filter(n => n.type === activeFilter);

                list.innerHTML = filtered.length
                    ? filtered.map(renderNotification).join('')
                    : '<div class="notif-empty">No notifications</div>';
            }

            async function fetchNotifications() {
                const res = await fetch('/Notifications/GetUnread');
                if (!res.ok) return;

                const { unreadCount, notifications } = await res.json();

                badge.style.display = unreadCount > 0 ? 'inline-block' : 'none';
                badge.textContent = unreadCount;

                allNotifications = notifications;
                renderList();
            }

            async function markRead(id) {
                await fetch(`/Notifications/MarkRead/${id}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token() }
                });
                fetchNotifications();
            }

            filterButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterButtons.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    activeFilter = btn.dataset.filter;
                    renderList();
                });
            });

            bell.addEventListener('click', () => {
                dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
            });

            document.addEventListener('click', e => {
                if (!bell.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.style.display = 'none';
                }
            });

            fetchNotifications();
            setInterval(fetchNotifications, 30000);
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>