@{
    var isStudent = User.Identity?.IsAuthenticated == true && User.IsInRole("Student");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVC_DenoyJabines</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="@(Url.Content("~/lib/bootstrap/dist/css/bootstrap.min.css"))" />
    <link rel="stylesheet" href="@(Url.Content("~/css/site.css"))" />
    <link rel="stylesheet" href="@(Url.Content("~/MVC_DenoyJabines.styles.css"))" />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --sidebar-bg: #1B5E20;
            --sidebar-hover: #164e1b;
            --sidebar-active-bg: #aee9a6;
            --sidebar-active-text: #14431a;
            --sidebar-border: rgba(255,255,255,0.08);
            --sidebar-text: #eaf3ea;
            --sidebar-heading: #ffffff;
            --sidebar-subheading: rgba(255,255,255,0.65);
            --sidebar-width: 240px;
            --accent: #1a7f74;
            --accent-soft: rgba(26,127,116,0.18);
            --page-bg: #f0f7f4;
            --topbar-bg: #ffffff;
            --topbar-border: #d4ede6;
            --ink: #0a1f1a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--page-bg);
            color: var(--ink);
            overflow-x: hidden;
        }

        .layout-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .sidebar-account,
        .sidebar-logout {
            display: block;
            width: 100%;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 500;
            text-decoration: none;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s;
            margin-bottom: 6px;
            border: none;
        }

        .sidebar-account {
            background: rgba(59, 91, 219, 0.1);
            color: #3b5bdb;
        }

            .sidebar-account:hover {
                background: rgba(59, 91, 219, 0.2);
            }

        /* ── SIDEBAR ── */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            transition: transform .3s ease;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 22px 18px 20px;
            margin-bottom: 6px;
        }

        .sidebar-logo {
            width: 40px;
            height: 40px;
            flex-shrink: 0;
        }

        .sidebar-brand-text h4 {
            font-family: 'Sora', Arial, sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--sidebar-heading);
            line-height: 1.2;
        }

        .sidebar-brand-text small {
            display: block;
            font-size: 0.68rem;
            font-weight: 500;
            color: var(--sidebar-subheading);
            letter-spacing: 0.02em;
        }

        .sidebar-nav {
            list-style: none;
            padding: 6px 14px;
            margin: 0;
        }

            .sidebar-nav li a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 16px;
                border-radius: 999px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 0.88rem;
                font-weight: 500;
                transition: all .18s;
                margin-bottom: 6px;
            }

                .sidebar-nav li a i,
                .sidebar-nav li a .nav-icon {
                    width: 18px;
                    text-align: center;
                    font-size: 0.95rem;
                    flex-shrink: 0;
                }

                .sidebar-nav li a:hover {
                    background: var(--sidebar-hover);
                    color: #ffffff;
                }

                .sidebar-nav li a.active {
                    background: var(--sidebar-active-bg);
                    color: var(--sidebar-active-text);
                    font-weight: 700;
                }

                    .sidebar-nav li a.active:hover {
                        background: var(--sidebar-active-bg);
                    }

        .sidebar-footer {
            margin-top: auto;
            padding: 16px 14px 22px;
        }

            .sidebar-footer form button {
                display: flex;
                align-items: center;
                gap: 10px;
                width: 100%;
                background: transparent;
                color: var(--sidebar-text);
                border: none;
                border-radius: 999px;
                padding: 10px 16px;
                font-family: Arial, Helvetica, sans-serif;
                font-size: 0.85rem;
                font-weight: 500;
                cursor: pointer;
                transition: all .18s;
            }

                .sidebar-footer form button:hover {
                    background: var(--sidebar-hover);
                    color: #ffffff;
                }

        /* ── MAIN ── */
        .main-content {
            margin-left: var(--sidebar-width);
            flex: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: var(--topbar-bg);
            border-bottom: 1px solid var(--topbar-border);
            padding: 14px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .topbar-title {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 1.1rem;
            font-weight: 400;
            color: var(--ink);
        }

        .topbar-badge {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--accent);
            background: rgba(26,127,116,0.1);
            padding: 3px 10px;
            border-radius: 20px;
        }

        .sidebar-toggle {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            flex-direction: column;
            gap: 5px;
        }

            .sidebar-toggle span {
                display: block;
                width: 22px;
                height: 2px;
                background: var(--ink);
                border-radius: 2px;
            }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 99;
        }

            .sidebar-overlay.active {
                display: block;
            }

        .page-body {
            padding: 28px;
            flex: 1;
        }

        /* ── NOTIFICATION BELL ── */
        .notif-bell {
            position: relative;
            background: none;
            border: none;
            cursor: pointer;
        }

        .notif-badge {
            display: none;
            position: absolute;
            top: -4px;
            right: -4px;
            background: #93000a;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            border-radius: 999px;
            padding: 1px 6px;
        }

        .notif-dropdown {
            display: none;
            position: absolute;
            right: 0;
            top: 36px;
            width: 320px;
            max-height: 400px;
            overflow-y: auto;
            background: #fff;
            border: 1px solid #e1e4db;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.12);
            z-index: 1000;
            padding: 8px;
        }

        .notif-item {
            padding: 10px 12px;
            border-radius: 8px;
            cursor: pointer;
            margin-bottom: 4px;
        }

            .notif-item.unread {
                background: #f2f5ec;
            }

        .notif-title {
            font-weight: 600;
            font-size: 13px;
            color: #191d18;
        }

        .notif-message {
            font-size: 12px;
            color: #41493e;
            margin-top: 2px;
        }

        .notif-time {
            font-size: 11px;
            color: #a3aa9e;
            margin-top: 4px;
        }

        .notif-empty {
            padding: 16px;
            text-align: center;
            color: #717a6d;
            font-size: 13px;
        }

        /* ── TOPBAR PROFILE ── */
        .topbar-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-left: 16px;
            padding-left: 16px;
            border-left: 1px solid var(--topbar-border);
        }

        .profile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--accent);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            flex-shrink: 0;
        }

        .profile-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
            line-height: 1.3;
        }

        .profile-role {
            font-size: 11px;
            color: #717a6d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            line-height: 1.3;
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 900px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main-content {
                margin-left: 0;
            }

            .sidebar-toggle {
                display: flex;
            }
        }

        @@media (max-width: 500px) {
            .page-body {
                padding: 16px;
            }
        }
    </style>
</head>
<body>

    <div class="layout-wrapper">

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <img src="~/lib/images/logo.png" alt="CounselCare Logo" class="sidebar-logo" />
                <div class="sidebar-brand-text">
                    <h4>CounselCare</h4>
                    <small>@(isStudent ? "Student Portal" : "Counselor Portal")</small>
                </div>
            </div>
            <ul class="sidebar-nav">
                @if (isStudent)
                {
                    <li><a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"><i class="fa-solid fa-grip"></i>Dashboard</a></li>
                    <li><a asp-controller="Appointments" asp-action="Create" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")"><i class="fa-regular fa-calendar-plus"></i>Book Appointment</a></li>
                    <li><a asp-controller="Appointments" asp-action="MyAppointments" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MyAppointments" ? "active" : "")"><i class="fa-regular fa-calendar-check"></i>My Appointments</a></li>
                }
                else
                {
                    <li><a asp-controller="Home" asp-action="Home" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"><i class="fa-solid fa-grip"></i>Dashboard</a></li>
                    <li><a asp-controller="Students" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" ? "active" : "")"><i class="fa-solid fa-user-graduate"></i>Students</a></li>
                    <li><a asp-controller="Counselors" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Counselors" ? "active" : "")"><i class="fa-solid fa-user-tie"></i>Counselors</a></li>
                    <li><a asp-controller="Appointments" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Appointments" ? "active" : "")"><i class="fa-regular fa-calendar-days"></i>Appointments</a></li>
                    <li><a asp-controller="Resources" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Resources" ? "active" : "")"><i class="fa-regular fa-folder-open"></i>Resources</a></li>
                }
            </ul>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-footer">
                    <form asp-controller="Users" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i>Logout</button>
                    </form>
                </div>
            }
        </aside>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <div class="main-content">
            <div class="topbar">
                <div style="display:flex;align-items:center;gap:14px;">
                    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle menu">
                        <span></span><span></span><span></span>
                    </button>
                    <div class="topbar-title">@ViewData["Title"]</div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div style="position:relative; display:inline-block;">
                        <button id="notif-bell" class="notif-bell">
                            <i class="fa-regular fa-bell" style="font-size:24px; color:#41493e;"></i>
                            <span id="notif-badge" class="notif-badge"></span>
                        </button>
                        <div id="notif-dropdown" class="notif-dropdown">
                            <div id="notif-list"></div>
                        </div>
                    </div>

                    <div class="topbar-profile">
                        <div class="profile-avatar">@(User.Identity?.Name?.Trim().Substring(0, 1).ToUpper() ?? "U")</div>
                        <div>
                            <div class="profile-name">@User.Identity?.Name</div>
                            <div class="profile-role">@(isStudent ? "Student" : "Counselor")</div>
                        </div>
                    </div>

                    <form style="display:none;">@Html.AntiForgeryToken()</form>
                }
            </div>

            <div class="page-body">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>

    </div>

    <script src="@(Url.Content("~/lib/jquery/dist/jquery.min.js"))"></script>
    <script src="@(Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"))"></script>
    <script src="@(Url.Content("~/js/site.js"))"></script>
    <script>
        const toggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        toggle.addEventListener('click', () => {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('active');
        });
        overlay.addEventListener('click', () => {
            sidebar.classList.remove('open');
            overlay.classList.remove('active');
        });
    </script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            const bell = document.getElementById('notif-bell');
            const dropdown = document.getElementById('notif-dropdown');
            const badge = document.getElementById('notif-badge');
            const list = document.getElementById('notif-list');
            const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            function renderNotification(n) {
                return `
                    <div class="notif-item ${n.isRead ? '' : 'unread'}" onclick="markRead(${n.notificationId})">
                        <div class="notif-title">${n.title}</div>
                        <div class="notif-message">${n.message}</div>
                        <div class="notif-time">${new Date(n.createdAt).toLocaleString()}</div>
                    </div>`;
            }

            async function fetchNotifications() {
                const res = await fetch('/Notifications/GetUnread');
                if (!res.ok) return;

                const { unreadCount, notifications } = await res.json();

                badge.style.display = unreadCount > 0 ? 'inline-block' : 'none';
                badge.textContent = unreadCount;

                list.innerHTML = notifications.length
                    ? notifications.map(renderNotification).join('')
                    : '<div class="notif-empty">No notifications</div>';
            }

            async function markRead(id) {
                await fetch(`/Notifications/MarkRead/${id}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token() }
                });
                fetchNotifications();
            }

            bell.addEventListener('click', () => {
                dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
            });

            document.addEventListener('click', e => {
                if (!bell.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.style.display = 'none';
                }
            });

            fetchNotifications();
            setInterval(fetchNotifications, 30000);
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
