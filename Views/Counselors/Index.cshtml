@model IEnumerable<GCAMS.Models.Counselor.Counselor>

@{
    ViewData["Title"] = "Counselor Management";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/Counselors/Index.css" asp-append-version="true" />


<div class="counselor-page" style="max-width: 1100px; margin: 0 auto; padding: 24px 16px;">

    <!-- Breadcrumb -->
    <div class="page-breadcrumb">
        <span>Counselors</span>
        <span class="material-symbols-outlined" style="font-size:14px;"></span>
        <span class="current">Counselor Management</span>
    </div>

    <!-- Header -->
    <div class="page-header">
        <a asp-action="Create" class="btn-add">
            <span class="material-symbols-outlined" style="font-size:18px;"></span>
            Add New Counselor
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            <span class="material-symbols-outlined" style="font-size:16px; vertical-align:middle; margin-right:6px;"></span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-danger">
            <span class="material-symbols-outlined" style="font-size:16px; vertical-align:middle; margin-right:6px;">   </span>
            @TempData["Error"]
        </div>
    }

    <!-- Filter Bar -->
    <div class="filter-bar">
        <div class="search-box">
            <span class="material-symbols-outlined"></span>
            <input type="text" id="counselorSearch" placeholder="Search by name or employee number" />
        </div>

        <select id="positionFilter" class="filter-select">
            <option value="">All Positions</option>
            @foreach (var pos in Model.Select(c => c.Position).Distinct().OrderBy(p => p))
            {
                <option value="@pos?.ToLower()">@pos</option>
            }
        </select>

        <select id="statusFilter" class="filter-select">
            <option value="">All Status</option>
            <option value="Permanent">Permanent</option>
            <option value="Full-Time">Full-Time</option>
            <option value="Contractual">Contractual</option>
            <option value="Part-Time">Part-Time</option>
            <option value="Substitute">Substitute</option>
            <option value="Retired">Retired</option>
            <option value="Inactive">Inactive</option>
        </select>
    </div>

    <!-- Table -->
    <table class="counselor-table" id="counselorTable">
        <thead>
            <tr>
                <th>Employee No.</th>
                <th>Full Name</th>
                <th>Contact</th>
                <th>Email</th>
                <th>Position</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-position="@item.Position?.ToLower()"
                    data-active="@item.EmploymentStatus.ToString().ToLower()">
                    <td><span class="emp-id">@item.EmployeeNumber</span></td>
                    <td><span class="counselor-name">@item.CounselorName</span></td>
                    <td><span style="font-size:13px; color:#717a6d;">@string.Join(", ", item.ContactNumbers.Select(c => c.Number))</span></td>
                    <td><span class="counselor-email">@item.EmailAddress</span></td>
                    <td><span class="status-pill pill-position">@item.Position</span></td>
                    <td>
                        <span class="status-pill" style="
                            background: @(item.EmploymentStatus == "Inactive" || item.EmploymentStatus == "Retired" ? "#e1e4db" : "#dcfce7");
                            color: @(item.EmploymentStatus == "Inactive" || item.EmploymentStatus == "Retired" ? "#41493e" : "#166534");">
                            @item.EmploymentStatus
                        </span>
                    </td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Details" asp-route-id="@item.CounselorID" class="action-icon" title="View Details">
                                <span class="material-symbols-outlined">👁</span>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.CounselorID" class="action-icon" title="Edit">
                                <span class="material-symbols-outlined">✏️</span>
                            </a>
                           
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Table Footer -->
    <div class="table-footer">
        <span class="showing-text" id="showingText"></span>
        <div class="pagination" id="pagination"></div>
    </div>

</div>

<script>
    const pageSize = 10;
    let currentPage = 1;
    let visibleRows = [];

    function applyFilters() {
        const query    = document.getElementById('counselorSearch').value.toLowerCase().trim();
        const position = document.getElementById('positionFilter').value.toLowerCase();
        const status   = document.getElementById('statusFilter').value.toLowerCase();

        visibleRows = [];

        document.querySelectorAll('#counselorTable tbody tr').forEach(function (row) {
            const empNo   = row.cells[0]?.textContent.trim().toLowerCase() || '';
            const name    = row.cells[1]?.textContent.trim().toLowerCase() || '';
            const rowPos  = (row.getAttribute('data-position') || '').trim();
            const rowStat = (row.getAttribute('data-active') || '').trim();

            const matchesSearch   = !query    || name.includes(query) || empNo.includes(query);
            const matchesPosition = !position || rowPos === position;
            const matchesStatus   = !status   || rowStat === status;

            if (matchesSearch && matchesPosition && matchesStatus) {
                visibleRows.push(row);
            }
            row.style.display = 'none';
        });

        currentPage = 1;
        renderPage();
    }

    function renderPage() {
        const start = (currentPage - 1) * pageSize;
        const end   = start + pageSize;

        document.querySelectorAll('#counselorTable tbody tr').forEach(r => r.style.display = 'none');
        visibleRows.slice(start, end).forEach(r => r.style.display = '');

        const total   = visibleRows.length;
        const showing = Math.min(end, total);
        document.getElementById('showingText').textContent =
            total === 0 ? 'No counselors found' :
            `Showing ${start + 1} - ${showing} of ${total} counselor${total !== 1 ? 's' : ''}`;

        renderPagination(total);
    }

    function renderPagination(total) {
        const totalPages = Math.ceil(total / pageSize);
        const pg = document.getElementById('pagination');
        pg.innerHTML = '';

        function btn(label, page, isActive, isDisabled, isArrow) {
            const b = document.createElement('button');
            b.className = 'page-btn' + (isActive ? ' active' : '') + (isArrow ? ' arrow' : '');
            b.innerHTML = label;
            b.disabled = isDisabled;
            if (!isDisabled && !isActive) {
                b.onclick = () => { currentPage = page; renderPage(); };
            }
            return b;
        }

        pg.appendChild(btn('<span class="material-symbols-outlined" style="font-size:16px;"><</span>', currentPage - 1, false, currentPage === 1, true));

        const pages = [];
        if (totalPages <= 7) {
            for (let i = 1; i <= totalPages; i++) pages.push(i);
        } else {
            pages.push(1);
            if (currentPage > 3) pages.push('...');
            for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) pages.push(i);
            if (currentPage < totalPages - 2) pages.push('...');
            pages.push(totalPages);
        }

        pages.forEach(p => {
            if (p === '...') {
                const s = document.createElement('span');
                s.textContent = '...';
                s.style.cssText = 'padding:0 4px; color:#717a6d; font-size:13px;';
                pg.appendChild(s);
            } else {
                pg.appendChild(btn(p, p, p === currentPage, false, false));
            }
        });

        pg.appendChild(btn('<span class="material-symbols-outlined" style="font-size:16px;">></span>', currentPage + 1, false, currentPage === totalPages || totalPages === 0, true));
    }

    document.getElementById('counselorSearch').addEventListener('input', applyFilters);
    document.getElementById('positionFilter').addEventListener('change', applyFilters);
    document.getElementById('statusFilter').addEventListener('change', applyFilters);

    applyFilters();
</script>