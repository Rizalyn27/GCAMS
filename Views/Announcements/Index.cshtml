@model IEnumerable<GCAMS.Models.Announcements.Announcement>
@{
    ViewData["Title"] = "Announcements";
}

<h1>Announcements</h1>
<a asp-action="Create" class="btn btn-primary mb-3">New Announcement</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Target</th>
            <th>Posted By</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Title</td>
                <td>@(string.IsNullOrEmpty(a.GradeLevel) ? "All Students" : $"{a.GradeLevel} {a.Section}")</td>
                <td>@(a.Counselor?.EmailAddress ?? "—")</td>
                <td>@a.CreatedAt.ToString("MMM dd, yyyy - h:mm tt")</td>
            </tr>
        }
    </tbody>
</table>