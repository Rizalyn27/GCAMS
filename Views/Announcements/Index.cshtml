@model GCAMS.ViewModels.AnnouncementCalendarViewModel

@{
    ViewData["Title"] = "Announcements";

    var firstOfMonth = new DateTime(Model.Year, Model.Month, 1);
    var prevMonth = firstOfMonth.AddMonths(-1);
    var nextMonth = firstOfMonth.AddMonths(1);
    var today = DateTime.Today;

    // Month totals come from the per-day counts the grid already uses.
    var postedThisMonth = Model.Days.Where(d => d.IsCurrentMonth).Sum(d => d.Count);
    var daysWithPosts = Model.Days.Count(d => d.IsCurrentMonth && d.Count > 0);

    // Sorted by the day the announcement is FOR, then newest written first.
    var dayList = Model.SelectedDayAnnouncements?
        .OrderByDescending(a => a.AnnouncementDate)
        .ThenByDescending(a => a.CreatedAt)
        .ToList();
    var dayCount = dayList?.Count ?? 0;

    // Pre-fills the date box on the Create form with the day being viewed.
    var newDate = (Model.SelectedDate ?? today).ToString("yyyy-MM-dd");
}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block" rel="stylesheet">
<link rel="stylesheet" href="~/css/Announcements/Index.css" asp-append-version="true" />


<div class="ann-page">

    @if (TempData["Success"] != null)
    {
        <div class="flash-success">
            <span class="material-symbols-outlined">check_circle</span>
            @TempData["Success"]
        </div>
    }

    <header class="ann-head">
        <div>
            <h1>Announcements</h1>
            <p class="ann-lead">Posted to students from the guidance office.</p>
        </div>
        <a asp-action="Create" asp-route-date="@newDate" class="btn-new">
            <span class="material-symbols-outlined">add</span>
            New announcement
        </a>
    </header>

    <div class="ann-layout">

        <!-- ==================== LIST ==================== -->
        <div class="ann-main">

            @if (Model.SelectedDate.HasValue)
            {
                <div class="list-head">
                    <div>
                        <h2 class="list-title">
                            @Model.SelectedDate.Value.ToString("dddd, d MMMM")
                            <span class="count-pill">@dayCount</span>
                        </h2>
                        <p class="list-sub">Newest first</p>
                    </div>
                    <a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                       class="link-quiet">
                        Clear day
                        <span class="material-symbols-outlined">close</span>
                    </a>
                </div>

                @if (dayCount == 0)
                {
                    <div class="empty-state">
                        <span class="material-symbols-outlined">campaign</span>
                        <div class="empty-title">Nothing posted on this day</div>
                        <p>Pick another date, or write a new announcement.</p>
                        <a asp-action="Create" asp-route-date="@newDate" class="btn-quiet">New announcement</a>
                    </div>
                }
                else
                {
                    foreach (var a in dayList)
                    {
                        var isFuture = a.AnnouncementDate.Date > today;

                        <article class="ann-card @(isFuture ? "is-scheduled" : "")">
                            <div class="card-top">
                                <h3 class="ann-title">@a.Title</h3>
                                @if (isFuture)
                                {
                                    <span class="status-badge is-scheduled">
                                        <span class="material-symbols-outlined">schedule</span> Scheduled
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge">
                                        <span class="material-symbols-outlined">check</span> Posted
                                    </span>
                                }
                            </div>

                            <div class="ann-meta">
                                <span class="meta-item">
                                    <span class="material-symbols-outlined">event</span>
                                    For @a.AnnouncementDate.ToString("dddd, d MMMM yyyy")
                                </span>
                                <span class="meta-item">
                                    <span class="material-symbols-outlined">person</span>
                                    @(a.Counselor?.EmailAddress ?? "Guidance office")
                                </span>
                                <span class="meta-item meta-quiet">
                                    written @a.CreatedAt.ToString("d MMM, h:mm tt")
                                </span>
                                @if (a.UpdatedAt.HasValue)
                                {
                                    <span class="meta-item meta-quiet">
                                        edited @a.UpdatedAt.Value.ToString("d MMM, h:mm tt")
                                    </span>
                                }
                            </div>

                            <p class="ann-message">@a.Message</p>
                        </article>
                    }
                }
            }
            else
            {
                <div class="empty-state empty-state-lg">
                    <span class="material-symbols-outlined">event_note</span>
                    <div class="empty-title">Pick a day to read its announcements</div>
                    <p>
                        @if (postedThisMonth > 0)
                        {
                            <text>
                                @postedThisMonth @(postedThisMonth == 1 ? "announcement" : "announcements")
                                @(postedThisMonth == 1 ? "is" : "are") dated this month, across
                                @daysWithPosts @(daysWithPosts == 1 ? "day" : "days").
                                Days with a dot have something on them.
                            </text>
                        }
                        else
                        {
                            <text>Nothing is dated this month yet.</text>
                        }
                    </p>
                    <a asp-action="Index" asp-route-year="@today.Year" asp-route-month="@today.Month" asp-route-day="@today.Day"
                       class="btn-quiet">Show today</a>
                </div>
            }
        </div>

        <!-- ==================== SIDE ==================== -->
        <aside class="ann-side">

            <section class="side-card">
                <h2 class="side-title">This month</h2>
                <p class="side-sub">@Model.MonthName</p>

                <div class="stat-row">
                    <div class="stat">
                        <div class="stat-value">@postedThisMonth</div>
                        <div class="stat-label">announcements</div>
                    </div>
                    <div class="stat">
                        <div class="stat-value">@daysWithPosts</div>
                        <div class="stat-label">@(daysWithPosts == 1 ? "day" : "days") with posts</div>
                    </div>
                </div>

                <div class="mini-nav">
                    <a class="nav-btn" title="Previous month"
                       asp-action="Index" asp-route-year="@prevMonth.Year" asp-route-month="@prevMonth.Month">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </a>
                    <span class="mini-month">@Model.MonthName</span>
                    <a class="nav-btn" title="Next month"
                       asp-action="Index" asp-route-year="@nextMonth.Year" asp-route-month="@nextMonth.Month">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </a>
                </div>

                <div class="mini-grid">
                    @foreach (var wd in new[] { "S", "M", "T", "W", "T", "F", "S" })
                    {
                        <span class="mini-weekday">@wd</span>
                    }

                    @foreach (var d in Model.Days)
                    {
                        var isSelected = Model.SelectedDate.HasValue && Model.SelectedDate.Value == d.Date;

                        <a class="mini-day @(d.IsCurrentMonth ? "" : "is-outside") @(d.IsToday ? "is-today" : "") @(isSelected ? "is-selected" : "")"
                           asp-action="Index"
                           asp-route-year="@d.Date.Year"
                           asp-route-month="@d.Date.Month"
                           asp-route-day="@d.Date.Day"
                           title="@d.Date.ToString("d MMMM") — @d.Count announcement(s)">
                            <span class="mini-num">@d.Date.Day</span>
                            @if (d.Count > 0)
                            {
                                <span class="mini-dot"></span>
                            }
                        </a>
                    }
                </div>

                <p class="side-foot">
                    A green dot marks a day an announcement is dated for. Click a day to filter the list.
                </p>
            </section>

        </aside>
    </div>
</div>
