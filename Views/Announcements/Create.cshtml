@model GCAMS.Models.Announcements.Announcement
@{
    ViewData["Title"] = "New Announcement";
    Layout = "_Layout"; // uses your existing CounselCare shell (sidebar + topbar)
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/Announcements/Create.css" asp-append-version="true" />



<div class="announce-wrap">
    <div class="announce-card">
        <div class="announce-header">
            <div>
                <p class="announce-title">New announcement</p>
                <p class="announce-subtitle">Students see this on their dashboard and get a notification.</p>
            </div>
            <a asp-action="Index" class="close-link" aria-label="Close">&#10005;</a>
        </div>

        <form asp-action="Create" id="announcementForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="field-group">
                <div class="field-label-row">
                    <label asp-for="Title" class="field-label">Title</label>
                    <span class="badge-needed">Needed</span>
                </div>
                <input asp-for="Title" class="form-control" placeholder="e.g. Career guidance week — sign-ups are open" />
                <p class="field-hint">Most students read only this line.</p>
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            <div class="field-group">
                <div class="field-label-row">
                    <label asp-for="Message" class="field-label">Message</label>
                    <span class="badge-needed">Needed</span>
                </div>
                <textarea asp-for="Message" class="form-control" rows="4" placeholder="Lead with what's happening and when."></textarea>
                <span asp-validation-for="Message" class="field-error"></span>
            </div>

            <div class="field-group">
                <div class="section-header">
                    <div class="field-label-row" style="margin-bottom:0;">
                        <span class="field-label">Who sees this</span>
                        <span class="badge-needed">Needed</span>
                    </div>
                    <a href="#" class="new-field-link">+ New field</a>
                </div>
                <p class="field-hint" style="margin-top:0;">Your build sends every announcement to all students. Narrowing it means fewer students see posts that aren't theirs.</p>

                <div class="option-grid">
                    <label class="option-card">
                        <input type="radio" name="Audience" value="MyStudents" checked />
                        <span class="option-title">My students</span>
                        <span class="option-sub">Your assigned students</span>
                    </label>
                    <label class="option-card">
                        <input type="radio" name="Audience" value="OneGrade" />
                        <span class="option-title">One grade level</span>
                        <span class="option-sub">Pick a grade</span>
                    </label>
                    <label class="option-card">
                        <input type="radio" name="Audience" value="OneSection" />
                        <span class="option-title">One section</span>
                        <span class="option-sub">Pick a section</span>
                    </label>
                    <label class="option-card">
                        <input type="radio" name="Audience" value="Everyone" />
                        <span class="option-title">Every student</span>
                        <span class="option-sub">All students in the school</span>
                    </label>
                </div>
            </div>

            <div class="field-group">
                <div class="section-header">
                    <div class="field-label-row" style="margin-bottom:0;">
                        <span class="field-label">When it goes out</span>
                    </div>
                    <a href="#" class="new-field-link">+ New field</a>
                </div>

                <div class="option-grid">
                    <label class="option-card">
                        <input type="radio" name="Timing" value="Now" id="timingNow" checked />
                        <span class="option-title">Post now</span>
                        <span class="option-sub">Students see it straight away</span>
                    </label>
                    <label class="option-card">
                        <input type="radio" name="Timing" value="Scheduled" id="timingScheduled" />
                        <span class="option-title">Schedule it</span>
                        <span class="option-sub">Pick a date and time</span>
                    </label>
                </div>

                <div id="schedulePicker">
                    <input asp-for="AnnouncementDate" type="date" class="form-control" />
                    <span asp-validation-for="AnnouncementDate" class="field-error"></span>
                </div>
            </div>

            <div class="form-footer">
                <button type="button" class="btn-delete">Delete</button>
                <div style="display:flex; gap:8px;">
                    <a asp-action="Index" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-save">Review and post</button>
                </div>
            </div>
        </form>

        @if (Model?.AnnouncementId != 0)
        {
            <form id="deleteForm" asp-action="Delete" asp-route-id="@Model?.AnnouncementId" method="post" style="display:none;"></form>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/Announcement/announcement-form.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initAnnouncementForm(document);
        });
    </script>
}
