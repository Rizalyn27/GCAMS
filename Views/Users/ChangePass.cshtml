@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Change password — Care Center</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Users/ChangePass.css" asp-append-version="true" />
</head>
<body class="auth-page">

    <div class="container-fluid p-0">
        <div class="row g-0 auth-shell">

            <!-- ============ BRAND PANEL ============ -->
            <div class="col-12 col-lg-6 brand-panel">
                <div class="brand-head">
                    <img src="~/lib/images/logo.png" class="brand-logo" alt="Don Sergio Osmeña Sr. Memorial National High School logo" />
                    <div>
                        <span class="brand-school">Don Sergio Osmeña Sr.<br />Memorial National High School</span>
                        <span class="brand-unit">CARE CENTER</span>
                    </div>
                </div>

                <div class="brand-copy">
                    <h1 class="brand-tagline">Space to grow, one conversation at a time</h1>
                    <p class="brand-sub">
                        The Care Center connects students with counselors and school staff in one calm,
                        private place appointments, check-ins, and support notes, all in one spot.
                    </p>
                </div>
            </div>

            <!-- ============ FORM PANEL ============ -->
            <div class="col-12 col-lg-6 form-panel">
                <div class="form-inner">

                    <h1 class="form-title">Change your password</h1>
                    <p class="form-sub">For your account's security, please set a new password.</p>

                    @if (ViewBag.Forced == true)
                    {
                        <div class="auth-notice" role="status">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>You must set a new password before continuing.</span>
                        </div>
                    }

                    <form method="post" id="ChangePwForm" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="field-stack">

                            <!-- Current password -->
                            <div class="field-group">
                                <label class="field-label" for="currentPassword">Current password</label>
                                <div class="field-wrap">
                                    <input type="password" id="currentPassword" name="currentPassword"
                                           class="form-control auth-input"
                                           placeholder="Enter your current password"
                                           autocomplete="current-password" required />
                                    <button type="button" class="toggle-pw" data-target="currentPassword" aria-label="Show password">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- New password -->
                            <div class="field-group">
                                <label class="field-label" for="newPassword">New password</label>
                                <div class="field-wrap">
                                    <input type="password" id="newPassword" name="newPassword"
                                           class="form-control auth-input"
                                           placeholder="Create a new password"
                                           autocomplete="new-password" required />
                                    <button type="button" class="toggle-pw" data-target="newPassword" aria-label="Show password">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                </div>

                                <ul class="pw-rules" id="pwRules" aria-live="polite">
                                    <li class="pw-rule" data-rule="len"><span class="dot"><i class="bi bi-check"></i></span>At least 8 characters</li>
                                    <li class="pw-rule" data-rule="case"><span class="dot"><i class="bi bi-check"></i></span>Upper &amp; lowercase</li>
                                    <li class="pw-rule" data-rule="num"><span class="dot"><i class="bi bi-check"></i></span>A number</li>
                                    <li class="pw-rule" data-rule="diff"><span class="dot"><i class="bi bi-check"></i></span>Different from current</li>
                                </ul>
                            </div>

                            <!-- Confirm -->
                            <div class="field-group">
                                <label class="field-label" for="confirmPassword">Confirm new password</label>
                                <div class="field-wrap">
                                    <input type="password" id="confirmPassword" name="confirmPassword"
                                           class="form-control auth-input"
                                           placeholder="Re-enter your new password"
                                           autocomplete="new-password" required />
                                    <button type="button" class="toggle-pw" data-target="confirmPassword" aria-label="Show password">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                </div>
                                <span class="field-hint" id="matchHint"></span>
                            </div>

                        </div>

                        <button type="submit" class="btn btn-signin">Change password</button>
                    </form>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <p class="msg msg-error" role="alert">@ViewBag.ErrorMessage</p>
                    }
                    @if (ViewBag.SuccessMessage != null)
                    {
                        <p class="msg msg-success" role="status">@ViewBag.SuccessMessage</p>
                    }

                    @if (ViewBag.Forced != true)
                    {
                        <p class="form-footer">
                            <a href="/Home/Index" class="link-quiet">Back to dashboard</a>
                        </p>
                    }

                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var current = document.getElementById('currentPassword');
            var pw = document.getElementById('newPassword');
            var confirmPw = document.getElementById('confirmPassword');
            var matchHint = document.getElementById('matchHint');
            var rules = document.getElementById('pwRules');

            // --- Per-field show / hide ---
            document.querySelectorAll('.toggle-pw').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(this.dataset.target);
                    var isHidden = input.type === 'password';
                    input.type = isHidden ? 'text' : 'password';
                    this.querySelector('i').className = isHidden ? 'bi bi-eye' : 'bi bi-eye-slash';
                    this.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
                });
            });

            // --- Live requirement checklist ---
            function checks() {
                var v = pw.value;
                return {
                    len: v.length >= 8,
                    "case": /[a-z]/.test(v) && /[A-Z]/.test(v),
                    num: /[0-9]/.test(v),
                    diff: v.length > 0 && v !== current.value
                };
            }

            function paintRules() {
                var result = checks();
                rules.querySelectorAll('.pw-rule').forEach(function (li) {
                    li.classList.toggle('met', result[li.dataset.rule] === true);
                });
            }

            function paintMatch() {
                var mismatch = confirmPw.value.length > 0 && confirmPw.value !== pw.value;
                confirmPw.classList.toggle('is-mismatch', mismatch);
                matchHint.textContent = mismatch ? 'Passwords do not match.' : '';
            }

            [current, pw].forEach(function (el) {
                el.addEventListener('input', function () { paintRules(); paintMatch(); });
            });
            confirmPw.addEventListener('input', paintMatch);

            // --- Block obvious problems before the round trip ---
            document.getElementById('ChangePwForm').addEventListener('submit', function (e) {
                var result = checks();
                var allMet = result.len && result["case"] && result.num && result.diff;

                if (!current.value || !pw.value || !confirmPw.value) {
                    e.preventDefault();
                    matchHint.textContent = 'Fill in all three fields to continue.';
                    return;
                }
                if (!allMet) {
                    e.preventDefault();
                    matchHint.textContent = 'Your new password does not meet the requirements above.';
                    pw.focus();
                    return;
                }
                if (pw.value !== confirmPw.value) {
                    e.preventDefault();
                    paintMatch();
                    confirmPw.focus();
                }
            });

            paintRules();
        })();
    </script>
</body>
</html>
