@{
    Layout = null;

    var forced = ViewBag.Forced == true;
    var errorMessage = ViewBag.ErrorMessage as string;
    var successMessage = ViewBag.SuccessMessage as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Change your password — Care Center</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Users/ChangePass.css" asp-append-version="true" />
</head>
<body class="auth-page">

    <div class="container-fluid p-0">
        <div class="row g-0 auth-shell">

            <!-- ============ BRAND PANEL ============ -->
            <div class="col-12 col-lg-6 brand-panel">
                <div class="brand-head">
                    <img src="~/lib/images/logo.png" class="brand-logo" alt="Don Sergio Osmeña Sr. Memorial National High School logo" />
                    <div>
                        <span class="brand-school">Don Sergio Osmeña Sr.<br />Memorial National High School</span>
                        <span class="brand-unit">CARE CENTER</span>
                    </div>
                </div>

                <div class="brand-copy">
                    <h1 class="brand-tagline">Space to grow, one conversation at a time</h1>
                    <p class="brand-sub">
                        The Care Center connects students with counselors and school staff in one calm,
                        private place appointments, check-ins, and support notes, all in one spot.
                    </p>
                </div>
            </div>

            <!-- ============ FORM PANEL ============ -->
            <div class="col-12 col-lg-6 form-panel">
                <div class="form-inner">

                    <h2 class="form-title">Change your password</h2>
                    <p class="form-sub">For your account's security, please set a new password.</p>

                    @if (forced)
                    {
                        <div class="notice notice-warn">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>You must set a new password before continuing.</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="notice notice-error" role="alert">
                            <i class="bi bi-x-circle"></i>
                            <span>@errorMessage</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="notice notice-ok" role="status">
                            <i class="bi bi-check-circle"></i>
                            <span>@successMessage</span>
                        </div>
                    }

                    <form method="post" id="changePassForm" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Current password -->
                        <div class="field-group">
                            <label class="field-label" for="currentPassword">Current password</label>
                            <div class="field-wrap">
                                <input type="password" id="currentPassword" name="currentPassword"
                                       class="form-control auth-input pw-field"
                                       placeholder="Enter your current password"
                                       autocomplete="current-password" required />
                                <button type="button" class="toggle-pw" data-toggle-for="currentPassword" aria-label="Show password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- New password -->
                        <div class="field-group">
                            <label class="field-label" for="newPassword">New password</label>
                            <div class="field-wrap">
                                <input type="password" id="newPassword" name="newPassword"
                                       class="form-control auth-input pw-field"
                                       placeholder="Create a new password"
                                       autocomplete="new-password" required />
                                <button type="button" class="toggle-pw" data-toggle-for="newPassword" aria-label="Show password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>

                            @* Mirrors the server-side policy in UsersController.PasswordPolicy *@
                            <ul class="rule-list" id="ruleList" aria-live="polite">
                                <li class="rule" data-rule="length"><span class="rule-dot"></span>At least 8 characters</li>
                                <li class="rule" data-rule="case"><span class="rule-dot"></span>Upper &amp; lowercase</li>
                                <li class="rule" data-rule="number"><span class="rule-dot"></span>A number</li>
                                <li class="rule" data-rule="symbol"><span class="rule-dot"></span>A symbol (!@@#$%^&amp;*)</li>
                                <li class="rule" data-rule="different"><span class="rule-dot"></span>Different from current</li>
                            </ul>
                        </div>

                        <!-- Confirm -->
                        <div class="field-group">
                            <label class="field-label" for="confirmPassword">Confirm new password</label>
                            <div class="field-wrap">
                                <input type="password" id="confirmPassword" name="confirmPassword"
                                       class="form-control auth-input pw-field"
                                       placeholder="Re-enter your new password"
                                       autocomplete="new-password" required />
                                <button type="button" class="toggle-pw" data-toggle-for="confirmPassword" aria-label="Show password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span class="field-error" id="matchError">Both new passwords must match.</span>
                        </div>

                        <button type="submit" class="btn btn-signin" id="submitBtn">Change Password</button>
                    </form>

                    <div class="privacy-note">
                        <i class="bi bi-shield-lock"></i>
                        <span>Your information is protected and handled confidentially.</span>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var form = document.getElementById('changePassForm');
            var current = document.getElementById('currentPassword');
            var next = document.getElementById('newPassword');
            var confirm = document.getElementById('confirmPassword');
            var matchError = document.getElementById('matchError');
            var submitBtn = document.getElementById('submitBtn');

            // ---------- show / hide, per field ----------
            document.querySelectorAll('.toggle-pw').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(this.dataset.toggleFor);
                    var hidden = input.type === 'password';
                    input.type = hidden ? 'text' : 'password';
                    this.querySelector('i').className = hidden ? 'bi bi-eye-slash' : 'bi bi-eye';
                    this.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
                });
            });

            // ---------- live rules ----------
            // Same checks the server runs, so the user isn't told "valid"
            // here and rejected after a round trip.
            function checkRules() {
                var v = next.value;

                var results = {
                    length: v.length >= 8,
                    case: /[a-z]/.test(v) && /[A-Z]/.test(v),
                    number: /\d/.test(v),
                    symbol: /[!@@#$%^&*]/.test(v),
                    different: v.length > 0 && v !== current.value
                };

                Object.keys(results).forEach(function (key) {
                    var li = document.querySelector('.rule[data-rule="' + key + '"]');
                    if (li) { li.classList.toggle('is-met', results[key]); }
                });

                return Object.keys(results).every(function (k) { return results[k]; });
            }

            function checkMatch() {
                var matches = confirm.value.length === 0 || confirm.value === next.value;
                matchError.classList.toggle('show', !matches);
                confirm.classList.toggle('cc-invalid', !matches);
                return matches && confirm.value.length > 0;
            }

            [current, next].forEach(function (el) {
                el.addEventListener('input', function () { checkRules(); checkMatch(); });
            });
            confirm.addEventListener('input', checkMatch);

            form.addEventListener('submit', function (e) {
                var rulesOk = checkRules();
                var matchOk = checkMatch();

                if (!rulesOk || !matchOk || !current.value) {
                    e.preventDefault();
                    if (!current.value) { current.focus(); }
                    else if (!rulesOk) { next.focus(); }
                    else { confirm.focus(); }
                    return;
                }

                submitBtn.disabled = true;
                submitBtn.textContent = 'Changing...';
            });

            checkRules();
        })();
    </script>
</body>
</html>
