@{
    Layout = null;

    // --- Error state, derived from what your controller already sets ---
    var errorMessage = ViewBag.ErrorMessage as string;

    // Your controller sends "Invalid username or password." for a failed sign-in.
    var badCredentials = !string.IsNullOrEmpty(errorMessage)
        && errorMessage.IndexOf("Invalid username or password", StringComparison.OrdinalIgnoreCase) >= 0;

    // Anything else (account disabled, server message, etc.) shows as a summary line.
    var otherError = !string.IsNullOrEmpty(errorMessage) && !badCredentials;

    // Keep what the user typed after a failed post (password is never echoed back).
    var postedUsername = "";
    var selectedRole = "student";
    if (Context.Request.HasFormContentType)
    {
        postedUsername = Context.Request.Form["username"].ToString();
        var postedRole = Context.Request.Form["role"].ToString();
        if (!string.IsNullOrEmpty(postedRole)) { selectedRole = postedRole; }
    }

    var isAdmin = selectedRole == "admin";
    var userLabel = isAdmin ? "Username or Email" : "Student ID or Email";
    var userPlaceholder = isAdmin ? "admin@edu.com" : "student@edu.com";
    var invalidClass = badCredentials ? " cc-invalid" : "";
    var showClass = badCredentials ? " show" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Sign in — Care Center</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Users/Login.css" asp-append-version="true" />
</head>
<body class="auth-page">

    <div class="container-fluid p-0">
        <div class="row g-0 auth-shell">

            <!-- ============ BRAND PANEL ============ -->
            <div class="col-12 col-lg-6 brand-panel">
                <div class="brand-head">
                    <img src="~/lib/images/logo.png" class="brand-logo" alt="Don Sergio Osmeña Sr. Memorial National High School logo" />
                    <div>
                        <span class="brand-school">Don Sergio Osmeña Sr.<br />Memorial National High School</span>
                        <span class="brand-unit">CARE CENTER</span>
                    </div>
                </div>

                <div class="brand-copy">
                    <h1 class="brand-tagline">Space to grow, one conversation at a time</h1>
                    <p class="brand-sub">
                        The Care Center connects students with counselors and school staff in one calm,
                        private place appointments, check-ins, and support notes, all in one spot.
                    </p>
                </div>
            </div>

            <!-- ============ FORM PANEL ============ -->
            <div class="col-12 col-lg-6 form-panel">
                <div class="form-inner">

                    <h2 class="form-title">Sign in</h2>
                    <p class="form-sub">Welcome back enter your details to continue.</p>

                    <form method="post" id="LoginForm" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Role tabs -->
                        <div class="role-tabs">
                            <input type="radio" name="role" id="roleAdmin" value="admin" checked="@isAdmin" />
                            <label for="roleAdmin">Counselor / Admin</label>

                            <input type="radio" name="role" id="roleStudent" value="student" checked="@(!isAdmin)" />
                            <label for="roleStudent">Student</label>
                        </div>

                        <!-- Username -->
                        <div class="field-group">
                            <label class="field-label" for="username" id="usernameLabel">@userLabel</label>
                            <div class="field-wrap">
                                <input type="text" id="username" name="username"
                                       class="form-control auth-input@(invalidClass)"
                                       value="@postedUsername"
                                       placeholder="@userPlaceholder"
                                       autocomplete="username" autocapitalize="none" spellcheck="false"
                                       aria-describedby="usernameError" required />
                            </div>
                            <span class="field-error@(showClass)" id="usernameError">@userLabel incorrect</span>
                        </div>

                        <!-- Password -->
                        <div class="field-group">
                            <label class="field-label" for="password">Password</label>
                            <div class="field-wrap">
                                <input type="password" id="password" name="password"
                                       class="form-control auth-input@(invalidClass)"
                                       placeholder="Enter your password"
                                       autocomplete="current-password"
                                       aria-describedby="passwordError" required />
                                <button type="button" class="toggle-pw" id="togglePw" aria-label="Show password">
                                    <i class="bi bi-eye-slash"></i>
                                </button>
                            </div>
                            <span class="field-error@(showClass)" id="passwordError">Password incorrect</span>
                        </div>

                        <!-- Remember / forgot -->
                        <div class="form-meta">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" value="true" />
                                <label class="form-check-label" for="rememberMe">Remember me</label>
                            </div>
                            <a href="/Account/ForgotPassword" class="link-quiet">Forgot password?</a>
                        </div>

                        <button type="submit" class="btn btn-signin" id="signInBtn">Sign in</button>
                    </form>

                    <div id="errorMsg" role="alert" aria-live="polite">@(otherError? errorMessage : "")</div>

                    <div class="privacy-note">
                        <i class="bi bi-shield-lock"></i>
                        <span>Your information is protected and handled confidentially.</span>
                    </div>

                    <p class="form-footer">
                        Having trouble signing in? <a href="/Home/Contact" class="link-quiet">Contact the Care Center</a>
                    </p>

                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var form = document.getElementById('LoginForm');
            var usernameInput = document.getElementById('username');
            var pwInput = document.getElementById('password');
            var usernameLabel = document.getElementById('usernameLabel');
            var toggleBtn = document.getElementById('togglePw');
            var summary = document.getElementById('errorMsg');

            var slots = {
                username: document.getElementById('usernameError'),
                password: document.getElementById('passwordError')
            };

            // ---------- Show / hide password ----------
            toggleBtn.addEventListener('click', function () {
                var isHidden = pwInput.type === 'password';
                pwInput.type = isHidden ? 'text' : 'password';
                this.querySelector('i').className = isHidden ? 'bi bi-eye' : 'bi bi-eye-slash';
                this.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
            });

            // ---------- Field error helpers ----------
            function setFieldError(name, message) {
                var input = document.getElementById(name);
                input.classList.add('cc-invalid');
                input.setAttribute('aria-invalid', 'true');
                if (message) { slots[name].textContent = message; }
                slots[name].classList.add('show');
            }

            function clearFieldError(name) {
                var input = document.getElementById(name);
                input.classList.remove('cc-invalid');
                input.removeAttribute('aria-invalid');
                slots[name].classList.remove('show');
            }

            // The red outline disappears as soon as they start correcting the field
            ['username', 'password'].forEach(function (name) {
                document.getElementById(name).addEventListener('input', function () {
                    clearFieldError(name);
                    summary.textContent = '';
                });
            });

            // ---------- Role tabs ----------
            document.querySelectorAll('input[name="role"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    var isStudent = this.value === 'student';
                    usernameLabel.textContent = isStudent ? 'Student ID or Email' : 'Username or Email';
                    usernameInput.placeholder = isStudent ? 'student@edu.com' : 'admin@edu.com';
                    slots.username.textContent = usernameLabel.textContent + ' incorrect';
                    clearFieldError('username');
                    clearFieldError('password');
                    summary.textContent = '';
                });
            });

            // ---------- Submit: catch empty fields before the round trip ----------
            form.addEventListener('submit', function (e) {
                var hasUser = usernameInput.value.trim().length > 0;
                var hasPw = pwInput.value.length > 0;

                if (!hasUser) { setFieldError('username', 'Enter your ' + usernameLabel.textContent + '.'); }
                if (!hasPw) { setFieldError('password', 'Enter your password.'); }

                if (!hasUser || !hasPw) {
                    e.preventDefault();
                    (hasUser ? pwInput : usernameInput).focus();
                    return;
                }

                document.getElementById('signInBtn').disabled = true;
                document.getElementById('signInBtn').textContent = 'Signing in...';
            });

            // Put the cursor where it is needed after a failed attempt
            if (document.querySelector('.auth-input.cc-invalid')) {
                pwInput.focus();
            }
        })();
    </script>
</body>
</html>
