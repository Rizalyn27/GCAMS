@model GCAMS.Models.CaseNotes.CaseNotes


<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700&display=swap');

    .form-wrapper {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
    }

    .form-sidebar {
        width: 200px;
        flex-shrink: 0;
        position: sticky;
        top: 1rem;
    }

        .form-sidebar .nav-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-family: Inter;
            color: #555;
            text-decoration: none;
            margin-bottom: 4px;
            transition: background 0.15s;
        }

            .form-sidebar .nav-link:hover {
                background: #f0f0f0;
                color: #222;
            }

            .form-sidebar .nav-link.active {
                background: #e8f5e9;
                color: #1b6d24;
                font-weight: 500;
            }

            .form-sidebar .nav-link i {
                font-size: 16px;
            }

    .form-content {
        flex: 1;
        min-width: 0;
    }

    .form-section {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .form-section-title {
        font-size: 18px;
        font-weight: 700;
        font-family: 'Manrope', sans-serif;
        color: #111;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .form-section-title i {
            font-size: 18px;
            color: #1b6d24;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

        .form-grid .full-width {
            grid-column: 1 / -1;
        }

    .field-label {
        font-size: 13px;
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        color: #6b7280;
        margin-bottom: 4px;
        display: block;
    }

    .form-control, .form-select {
        font-size: 14px;
        font-family: 'Inter', sans-serif;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        padding: 8px 12px;
        width: 100%;
        color: #111;
    }

        .form-control:focus, .form-select:focus {
            border-color: #1b6d24;
            outline: none;
            box-shadow: 0 0 0 3px rgba(27, 109, 36, 0.1);
        }

    .form-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-top: 1px solid #e5e7eb;
        margin-top: 1rem;
    }

    .btn-cancel {
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        padding: 9px 20px;
        font-size: 14px;
        color: #374151;
        cursor: pointer;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #f9fafb;
            color: #374151;
        }

    .btn-save {
        background: #1b6d24;
        border: none;
        border-radius: 8px;
        padding: 9px 20px;
        font-size: 14px;
        color: #fff;
        cursor: pointer;
    }

        .btn-save:hover {
            background: #155a1e;
        }

    @@media (max-width: 768px) {
        .form-wrapper {
            flex-direction: column;
        }

        .form-sidebar {
            width: 100%;
            position: static;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    body {
        font-family: 'Inter', sans-serif;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Manrope', sans-serif;
    }

    .checkbox-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 6px;
    }

    .checkbox-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border-radius: 999px;
        border: 1px solid #d1d5db;
        background: #fff;
        font-size: 13px;
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        color: #374151;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
    }

        .checkbox-item:hover {
            border-color: #1b6d24;
            color: #1b6d24;
        }

        /* Hide the native checkbox visually but keep it accessible */
        .checkbox-item input[type="checkbox"] {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
            pointer-events: none;
        }

        /* Pill turns green/filled when its checkbox is checked */
        .checkbox-item:has(input[type="checkbox"]:checked) {
            background: #1b6d24;
            border-color: #1b6d24;
            color: #fff;
        }

        .checkbox-item:has(input[type="checkbox"]:focus-visible) {
            outline: 2px solid #1b6d24;
            outline-offset: 2px;
        }

    @@media (max-width: 768px) {
        .checkbox-grid {
            gap: 6px;
        }
    }
</style>

<h1>Create Case Note</h1>

<div class="form-wrapper">

    <!-- Sidebar -->
    <div class="form-sidebar">
        <a href="#session" class="nav-link active">
            <i class="bi bi-calendar-event"></i> Session Info
        </a>
        <a href="#counseling" class="nav-link">
            <i class="bi bi-clipboard2-pulse"></i> Counseling Details
        </a>
        <a href="#followup" class="nav-link">
            <i class="bi bi-flag"></i> Follow-Up & Goals
        </a>
    </div>

    <!-- Form Content -->
    <form asp-action="Create" method="post" class="form-content">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" name="studentId" value="@ViewBag.StudentsID" />

        <!-- Session Info -->
        <div class="form-section" id="session">
            <div class="form-section-title">
                <i class="bi bi-calendar-event"></i> Session Info
            </div>
            <div class="form-grid">
                <div class="full-width">
                    <label class="field-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div>
                    <label class="field-label">Session No.</label>
                    <input asp-for="SessionNo" class="form-control" />
                    <span asp-validation-for="SessionNo" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div>
                    <label class="field-label">Session Date</label>
                    <input asp-for="SessionDate" class="form-control" />
                    <span asp-validation-for="SessionDate" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="full-width">
                    <label class="field-label">Session Topics</label>
                    <div class="=checkbox-grid">
                        @{
                            var topics = new[]{
                                "Academic Concerns","Behavioral COncern","Personal Concern", "Emotional Concern", "Family-Related Concern","Peer Relationship",
                        "Career Guidance", "Health/Physical Concerns", "Bullying Report","Crisis/Urgent Concern"
                            };
                         }
                        @foreach (var topic in topics)
                        {
                            <label class="checkbox-item">
                                <input type="checkbox" name="SelectedSessionTopics" value="@topic" />
                                @topic
                            </label>
                        }
                    </div>
                </div>
                <div class="full-width">
                    <label class="field-label">Session Relevance</label>
                    <input asp-for="SessionRelevance" class="form-control" />
                    <span asp-validation-for="SessionRelevance" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
        </div>

        <!-- Counseling Details -->
        <div class="form-section" id="counseling">
            <div class="form-section-title">
                <i class="bi bi-clipboard2-pulse"></i> Counseling Details
            </div>
            <div class="form-grid">
                <div class="full-width">
                    <label class="field-label">Goal Plan</label>
                    <input asp-for="GoalPlan" class="form-control" />
                    <span asp-validation-for="GoalPlan" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="full-width">
                    <label class="field-label">Interventions</label>
                    <div class="checkbox-grid">
                        @{
                            var interventionOption = new[]{
                                                "Active Listening", "These still need more options"
                                                };
                        }
                        @foreach (var intervention in interventionOption)
                        {
                            <label class="checkbox-item">
                                <input type="checkbox" name="SelectedInterventions" value="@intervention" />
                                @intervention
                            </label>
                        }
                    </div>
                </div>
                <div class="full-width">
                    <label class="field-label">Observations</label>
                    <input asp-for="Observations" class="form-control" />
                    <span asp-validation-for="Observations" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div>
                    <label class="field-label">Counsel Progress</label>
                    <select asp-for="CounselProgess" class="form-control">
                        <option value="">-- Select Progress --</option>
                        <option value="Improving">Improving</option>
                        <option value="No Change">Stable/No Change</option>
                        <option value="Declining">Declining</option>
                        <option value="Resolved">Resolved</option>
                    </select>
                    <span asp-validation-for="CounselProgess" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div>
                    <label class="field-label">Behavior Status</label>
                    <select asp-for="BehaviorStatus" class="form-control">
                        <option value="">-- Select Status --</option>
                        <option value="Improved">Improved</option>
                        <option value="The Same">The Same</option>
                        <option value="Worsened">Worsened</option>
                        <option value="New Concern Identified">New Concern Identified</option>
                    </select>
                    <span asp-validation-for="BehaviorStatus" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
        </div>

        <!-- Follow-Up & Goals -->
        <div class="form-section" id="followup">
            <div class="form-section-title">
                <i class="bi bi-flag"></i> Follow-Up & Goals
            </div>
            <div class="form-grid">
                <div class="full-width">
                    <label class="field-label">Homework</label>
                    <input asp-for="Homework" class="form-control" />
                    <span asp-validation-for="Homework" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="full-width">
                    <label class="field-label">Strengths / Challenges</label>
                    <input asp-for="StrengthsChallenges" class="form-control" />
                    <span asp-validation-for="StrengthsChallenges" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div>
                    <label class="field-label">Specific Goal</label>
                    <input asp-for="SpecificGoal" class="form-control" />
                    <span asp-validation-for="SpecificGoal" class="text-danger" style="font-size:12px;"></span>
                </div>
               
            </div>
        </div>

        <!-- Footer -->
        <div class="form-footer">
            <small class="text-muted">🔒 Privacy Protected • Sys.Logged</small>
            <div style="display:flex; gap:10px;">
                <a asp-controller="Students" asp-action="Details" asp-route-id="@ViewBag.StudentsID" class="btn-cancel">Cancel</a>
                <input type="submit" value="Save Case Note" class="btn-save" />
            </div>
        </div>

    </form>
</div>

<script>
    const links = document.querySelectorAll('.form-sidebar .nav-link');
    const sections = document.querySelectorAll('.form-section');

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                links.forEach(l => l.classList.remove('active'));
                const active = document.querySelector(`.nav-link[href="#${entry.target.id}"]`);
                if (active) active.classList.add('active');
            }
        });
    }, { threshold: 0.3 });

    sections.forEach(s => observer.observe(s));

    links.forEach(link => {
        link.addEventListener('click', e => {
            e.preventDefault();
            document.querySelector(link.getAttribute('href')).scrollIntoView({ behavior: 'smooth' });
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}