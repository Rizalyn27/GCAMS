@model GCAMS.Models.CaseNotes.CaseNotes

@{
    ViewData["Title"] = "Case Note Details";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700&display=swap');

    .form-wrapper {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
    }

    .form-sidebar {
        width: 200px;
        flex-shrink: 0;
        position: sticky;
        top: 1rem;
    }

        .form-sidebar .nav-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-family: Inter;
            color: #555;
            text-decoration: none;
            margin-bottom: 4px;
            transition: background 0.15s;
        }

            .form-sidebar .nav-link:hover {
                background: #f0f0f0;
                color: #222;
            }

            .form-sidebar .nav-link.active {
                background: #e8f5e9;
                color: #1b6d24;
                font-weight: 500;
            }

            .form-sidebar .nav-link i {
                font-size: 16px;
            }

    .form-content {
        flex: 1;
        min-width: 0;
    }

    .form-section {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .form-section-title {
        font-size: 18px;
        font-weight: 700;
        font-family: 'Manrope', sans-serif;
        color: #111;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .form-section-title i {
            font-size: 18px;
            color: #1b6d24;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

        .form-grid .full-width {
            grid-column: 1 / -1;
        }

    .field-label {
        font-size: 13px;
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        color: #6b7280;
        margin-bottom: 4px;
        display: block;
    }

    .field-value {
        font-size: 14px;
        font-family: 'Inter', sans-serif;
        color: #111;
        min-height: 20px;
    }

    .form-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-top: 1px solid #e5e7eb;
        margin-top: 1rem;
    }

    .btn-cancel {
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        padding: 9px 20px;
        font-size: 14px;
        color: #374151;
        cursor: pointer;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #f9fafb;
            color: #374151;
        }

    .btn-save {
        background: #1b6d24;
        border: none;
        border-radius: 8px;
        padding: 9px 20px;
        font-size: 14px;
        color: #fff;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

        .btn-save:hover {
            background: #155a1e;
            color: #fff;
        }

    @@media (max-width: 768px) {
        .form-wrapper {
            flex-direction: column;
        }

        .form-sidebar {
            width: 100%;
            position: static;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    body {
        font-family: 'Inter', sans-serif;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Manrope', sans-serif;
    }
</style>

<h1>Case Note Details</h1>

<div class="form-wrapper">

    <div class="form-sidebar">
        <a href="#session" class="nav-link active">
            <i class="bi bi-calendar-event"></i> Session Info
        </a>
        <a href="#counseling" class="nav-link">
            <i class="bi bi-clipboard2-pulse"></i> Counseling Details
        </a>
        <a href="#followup" class="nav-link">
            <i class="bi bi-flag"></i> Follow-Up & Goals
        </a>
    </div>

    <div class="form-content">

        <div class="form-section" id="session">
            <div class="form-section-title">
                <i class="bi bi-calendar-event"></i> Session Info
            </div>
            <div class="form-grid">
                <div class="full-width">
                    <span class="field-label">@Html.DisplayNameFor(m => m.FullName)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.FullName)</div>
                </div>
                <div>
                    <span class="field-label">@Html.DisplayNameFor(m => m.SessionNo)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.SessionNo)</div>
                </div>
                <div>
                    <span class="field-label">@Html.DisplayNameFor(m => m.SessionDate)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.SessionDate)</div>
                </div>
                <div class="full-width">
                    <span class="field-label">@Html.DisplayNameFor(m => m.SessionTopics)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.SessionTopics)</div>
                </div>
                <div class="full-width">
                    <span class="field-label">@Html.DisplayNameFor(m => m.SessionRelevance)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.SessionRelevance)</div>
                </div>
            </div>
        </div>

        <div class="form-section" id="counseling">
            <div class="form-section-title">
                <i class="bi bi-clipboard2-pulse"></i> Counseling Details
            </div>
            <div class="form-grid">
                <div class="full-width">
                    <span class="field-label">@Html.DisplayNameFor(m => m.GoalPlan)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.GoalPlan)</div>
                </div>
                <div class="full-width">
                    <span class="field-label">@Html.DisplayNameFor(m => m.Interventions)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.Interventions)</div>
                </div>
                <div class="full-width">
                    <span class="field-label">@Html.DisplayNameFor(m => m.Observations)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.Observations)</div>
                </div>
                <div>
                    <span class="field-label">@Html.DisplayNameFor(m => m.CounselProgess)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.CounselProgess)</div>
                </div>
                <div>
                    <span class="field-label">@Html.DisplayNameFor(m => m.BehaviorStatus)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.BehaviorStatus)</div>
                </div>
            </div>
        </div>

        <div class="form-section" id="followup">
            <div class="form-section-title">
                <i class="bi bi-flag"></i> Follow-Up & Goals
            </div>
            <div class="form-grid">
                <div class="full-width">
                    <span class="field-label">@Html.DisplayNameFor(m => m.FollowUpDate)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.FollowUpDate)</div>
                </div>
                <div class="full-width">
                    <span class="field-label">@Html.DisplayNameFor(m => m.Homework)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.Homework)</div>
                </div>
                <div class="full-width">
                    <span class="field-label">@Html.DisplayNameFor(m => m.StrengthsChallenges)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.StrengthsChallenges)</div>
                </div>
                <div>
                    <span class="field-label">@Html.DisplayNameFor(m => m.SpecificGoal)</span>
                    <div class="field-value">@Html.DisplayFor(m => m.SpecificGoal)</div>
                </div>
               
            </div>
        </div>

        <div class="form-footer">
            <small class="text-muted">🔒 Privacy Protected • Sys.Logged</small>
            <div style="display:flex; gap:10px;">
                <a asp-controller="Students" asp-action="Details" asp-route-id="@ViewBag.StudentsID" class="btn-cancel">Back</a>
                <a asp-action="Edit" asp-route-id="@Model?.CasenoteId" asp-route-studentId="@ViewBag.StudentsID" class="btn-save">Edit</a>
            </div>
        </div>

    </div>
</div>

<script>
    const links = document.querySelectorAll('.form-sidebar .nav-link');
    const sections = document.querySelectorAll('.form-section');

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                links.forEach(l => l.classList.remove('active'));
                const active = document.querySelector(`.nav-link[href="#${entry.target.id}"]`);
                if (active) active.classList.add('active');
            }
        });
    }, { threshold: 0.3 });

    sections.forEach(s => observer.observe(s));

    links.forEach(link => {
        link.addEventListener('click', e => {
            e.preventDefault();
            document.querySelector(link.getAttribute('href')).scrollIntoView({ behavior: 'smooth' });
        });
    });
</script>