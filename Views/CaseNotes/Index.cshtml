                @Html.DisplayFor(model => item.SpecificGoal)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.OverallGoal)
            </td> *@
            <td>
                <a asp-action="Edit" asp-route-id="@item.CasenoteId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CasenoteId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CasenoteId">Delete</a>
            </td>
        </tr>
}
