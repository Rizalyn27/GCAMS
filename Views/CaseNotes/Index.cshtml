                @Html.DisplayFor(model => item.Interventions)
            </td>
            <td>
                @Html.DisplayFor(model => item.Observations)
            </td>
            <td>
                @Html.DisplayFor(model => item.CounselProgess)
            </td>
            <td>
                @Html.DisplayFor(model => item.BehaviorStatus)
            </td>
            <td>
                @Html.DisplayFor(model => item.Homework)
            </td>
            <td>
                @Html.DisplayFor(model => item.StrengthsChallenges)
            </td>
